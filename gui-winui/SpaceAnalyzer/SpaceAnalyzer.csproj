<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>SpaceAnalyzer</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseXamlCompilerExecutable>false</UseXamlCompilerExecutable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.0" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WinUI" Version="2.0.0-rc6" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <!-- Pin the native SQLite bundle to a patched release (2.1.10 carries
         GHSA-2m69-gcr7-jv3q, a high-severity SQLite advisory). -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
  </ItemGroup>

  <!--
    Ship the Rust scanner CLI + native cleaner alongside the WinUI app so that
    ScannerService.IsAvailable is true for packaged / Publish builds. The Rust
    binaries are produced by a release `cargo build` at the repo root and live
    in <repo>/target/release. We copy them into the build output; if they are
    missing, emit a clear high-priority warning instead of silently shipping a
    GUI with no backend.

    Build them on demand with:
      dotnet build gui-winui/SpaceAnalyzer/SpaceAnalyzer.csproj /t:BuildRustScanner
    or enable automatic building on every build via:
      /p:BuildRustOnBuild=true
  -->
  <PropertyGroup>
    <RustWorkspaceDir>$(MSBuildThisFileDirectory)..\..</RustWorkspaceDir>
    <RustReleaseDir>$(RustWorkspaceDir)\target\release</RustReleaseDir>
  </PropertyGroup>

  <Target Name="BuildRustScanner" Condition="Exists('$(RustWorkspaceDir)\Cargo.toml')">
    <Message Text="Building Rust scanner CLI + cleaner from $(RustWorkspaceDir)" Importance="high" />
    <Exec Command="cargo build --release --bin space-analyzer-cli &amp;&amp; cargo build --release -p node_modules_cleaner"
          WorkingDirectory="$(RustWorkspaceDir)"
          EchoOff="true" />
  </Target>

  <Target Name="CopyRustTools"
          BeforeTargets="Build;Publish"
          Condition="'$(BuildRustOnBuild)' != 'true' Or Exists('$(RustWorkspaceDir)\Cargo.toml')">
    <ItemGroup>
      <RustTool Include="space-analyzer-cli.exe" />
      <RustTool Include="node_modules_cleaner.exe" />
    </ItemGroup>

    <Message Condition="'$(BuildRustOnBuild)' == 'true' And Exists('$(RustWorkspaceDir)\Cargo.toml')"
             Text="BuildRustOnBuild=true: compiling Rust tools first." Importance="high" />
    <CallTarget Condition="'$(BuildRustOnBuild)' == 'true' And Exists('$(RustWorkspaceDir)\Cargo.toml')"
                Targets="BuildRustScanner" />

    <Message Condition="!Exists('$(RustReleaseDir)\%(RustTool.Identity)')"
             Text="WARNING: %(RustTool.Identity) not found in $(RustReleaseDir). Build it with 'cargo build --release' at the repo root (or 'dotnet build /t:BuildRustScanner'), or set SPACE_ANALYZER_SCANNER / SPACE_ANALYZER_CLEANER at runtime to point at a prebuilt binary."
             Importance="high" />
    <Copy Condition="Exists('$(RustReleaseDir)\%(RustTool.Identity)')"
          SourceFiles="$(RustReleaseDir)\%(RustTool.Identity)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
