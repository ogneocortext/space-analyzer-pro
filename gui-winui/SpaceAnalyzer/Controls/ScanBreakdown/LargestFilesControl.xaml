<UserControl
    x:Class="SpaceAnalyzer.Controls.ScanBreakdown.LargestFilesControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:SpaceAnalyzer.Models">

    <UserControl.Resources>
        <!-- Compact: Scan page (size · path · open/folder) -->
        <DataTemplate x:Key="CompactTemplate" x:DataType="models:FileSizeEntry">
            <Grid ColumnSpacing="{StaticResource Space.SM}" Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{x:Bind SizeDisplay, Mode=OneTime}" Style="{StaticResource Type.FieldHeading}" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
                <TextBlock Grid.Column="1" Text="{x:Bind Path, Mode=OneTime}" Style="{StaticResource Type.Caption}" TextTrimming="CharacterEllipsis" Opacity="0.8"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{StaticResource Space.XS}">
                    <Button Content="Open" Click="OpenFile_Click" Style="{StaticResource TinyButton}"/>
                    <Button Content="Folder" Click="OpenFolder_Click" Style="{StaticResource TinyButton}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Detailed: History detail (size · ext · path · open/folder + proportion bar) -->
        <DataTemplate x:Key="DetailedTemplate" x:DataType="models:FileSizeEntry">
            <Grid ColumnSpacing="{StaticResource Space.SM}" Margin="0,4">
                <Grid.Transitions>
                    <TransitionCollection>
                        <EntranceThemeTransition/>
                    </TransitionCollection>
                </Grid.Transitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" ColumnSpacing="{StaticResource Space.SM}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{x:Bind SizeDisplay, Mode=OneTime}" Style="{StaticResource Type.Caption}" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{x:Bind Extension, Mode=OneTime}" Style="{StaticResource Type.Caption}" FontFamily="Consolas" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{x:Bind Path, Mode=OneTime}" Style="{StaticResource Type.Caption}" TextTrimming="CharacterEllipsis" Opacity="0.8" VerticalAlignment="Center"/>
                    <Button Grid.Column="3" Content="Open" Click="OpenFile_Click" Style="{StaticResource TinyButton}" VerticalAlignment="Center"/>
                    <Button Grid.Column="4" Content="Folder" Click="OpenFolder_Click" Style="{StaticResource TinyButton}" VerticalAlignment="Center"/>
                </Grid>
                <ProgressBar Grid.Row="1" Value="{x:Bind Percent, Mode=OneTime}" Maximum="100" Height="4" Margin="0,4,0,0" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel Spacing="{StaticResource Space.XS}">
        <!-- Filter bar -->
        <Grid ColumnSpacing="{StaticResource Space.SM}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{x:Bind Filter, Mode=TwoWay}" PlaceholderText="{x:Bind FilterPlaceholder, Mode=OneWay}" Style="{StaticResource Type.Caption.TextBox}"/>
            <Button Grid.Column="1" Content="Clear" Click="ClearFilter_Click" Style="{StaticResource SmallButton}" Visibility="{x:Bind HasFilter, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
        </Grid>

        <!-- Sort headers (detailed mode only) -->
        <Grid ColumnSpacing="0" Visibility="{x:Bind ShowSortHeaders, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="44"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="{StaticResource Space.XS}">
                <Button Content="Size" Click="SortHeader_Click" Tag="1" Style="{StaticResource TinyButton}" MinWidth="40" MinHeight="20" HorizontalContentAlignment="Left"/>
                <TextBlock Text="{x:Bind SizeSortIndicator, Mode=OneWay}" Style="{StaticResource Type.Tiny}" VerticalAlignment="Center" Margin="2,0,0,0"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="Ext" Style="{StaticResource Type.Tiny}" FontWeight="SemiBold" Opacity="0.7" VerticalAlignment="Center" Margin="4,0,0,0"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{StaticResource Space.XS}">
                <Button Content="Name" Click="SortHeader_Click" Tag="2" Style="{StaticResource TinyButton}" MinWidth="40" MinHeight="20" HorizontalContentAlignment="Left"/>
                <TextBlock Text="{x:Bind NameSortIndicator, Mode=OneWay}" Style="{StaticResource Type.Tiny}" VerticalAlignment="Center" Margin="2,0,0,0"/>
            </StackPanel>
        </Grid>

        <!-- File list -->
        <ScrollViewer MaxHeight="{x:Bind ListMaxHeight, Mode=OneWay}" VerticalScrollBarVisibility="Auto">
            <ItemsRepeater x:Name="FileRepeater" ItemsSource="{x:Bind ItemsSource, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Vertical" Spacing="{StaticResource Space.XS}"/>
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </ScrollViewer>

        <!-- Empty state -->
        <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="16"
                Visibility="{x:Bind EmptyStateVisibility, Mode=OneWay}">
            <TextBlock Text="{x:Bind EmptyStateText, Mode=OneWay}" Style="{StaticResource Type.Caption}" Opacity="0.6" TextAlignment="Center"/>
        </Border>
    </StackPanel>
</UserControl>
