<UserControl
    x:Class="SpaceAnalyzer.Controls.ScanBreakdown.BreakdownListControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ItemsRepeater x:Name="BreakdownRepeater"
                  ItemsSource="{x:Bind ItemsSource, Mode=OneWay}"
                  ItemTemplate="{x:Bind RowTemplate, Mode=OneWay}">
        <ItemsRepeater.Layout>
            <StackLayout Orientation="Vertical" Spacing="{StaticResource Space.XS}"/>
        </ItemsRepeater.Layout>
    </ItemsRepeater>
</UserControl>
