<Application
    x:Class="SpaceAnalyzer.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SpaceAnalyzer"
    xmlns:helpers="using:SpaceAnalyzer.Helpers">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />

                <!-- ═══════════════════════════════════════════════════ -->
                <!-- Theme-Aware Semantic Colors                        -->
                <!-- ═══════════════════════════════════════════════════ -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SuccessBrush" Color="#0E7A3A"/>
                    <SolidColorBrush x:Key="SuccessSubtleBrush" Color="#0E7A3A" Opacity="0.12"/>
                    <SolidColorBrush x:Key="WarningBrush" Color="#C47A10"/>
                    <SolidColorBrush x:Key="WarningSubtleBrush" Color="#C47A10" Opacity="0.12"/>
                    <SolidColorBrush x:Key="WarningTextBrush" Color="#C47A10"/>
                    <SolidColorBrush x:Key="ErrorBrush" Color="#C42B1C"/>
                    <SolidColorBrush x:Key="ErrorSubtleBrush" Color="#C42B1C" Opacity="0.10"/>
                    <SolidColorBrush x:Key="ErrorTextBrush" Color="#C42B1C"/>
                    <SolidColorBrush x:Key="InfoBrush" Color="#0078D4"/>
                    <SolidColorBrush x:Key="InfoSubtleBrush" Color="#0078D4" Opacity="0.10"/>
                    <SolidColorBrush x:Key="MutedBrush" Color="#595959"/>
                    <SolidColorBrush x:Key="AccentSurfaceBrush" Color="#0078D4" Opacity="0.06"/>
                    <SolidColorBrush x:Key="CardBackgroundFillColorHoverBrush" Color="#F9F9F9"/>
                    <SolidColorBrush x:Key="EmptyStateFillBrush" Color="#F3F3F3"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="SuccessBrush" Color="#4CC26A"/>
                    <SolidColorBrush x:Key="SuccessSubtleBrush" Color="#4CC26A" Opacity="0.15"/>
                    <SolidColorBrush x:Key="WarningBrush" Color="#F5C34A"/>
                    <SolidColorBrush x:Key="WarningSubtleBrush" Color="#F5C34A" Opacity="0.15"/>
                    <SolidColorBrush x:Key="WarningTextBrush" Color="#F5C34A"/>
                    <SolidColorBrush x:Key="ErrorBrush" Color="#FF6B6B"/>
                    <SolidColorBrush x:Key="ErrorSubtleBrush" Color="#FF6B6B" Opacity="0.15"/>
                    <SolidColorBrush x:Key="ErrorTextBrush" Color="#FF6B6B"/>
                    <SolidColorBrush x:Key="InfoBrush" Color="#60CDFF"/>
                    <SolidColorBrush x:Key="InfoSubtleBrush" Color="#60CDFF" Opacity="0.12"/>
                    <SolidColorBrush x:Key="MutedBrush" Color="#B5B5B5"/>
                    <SolidColorBrush x:Key="AccentSurfaceBrush" Color="#60CDFF" Opacity="0.08"/>
                    <SolidColorBrush x:Key="CardBackgroundFillColorHoverBrush" Color="#3A3A3A"/>
                    <SolidColorBrush x:Key="EmptyStateFillBrush" Color="#2A2D33"/>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>

            <helpers:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
            <helpers:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
            <helpers:BoolToErrorBrushConverter x:Key="BoolToErrorBrush"/>
            <helpers:BoolToScanButtonTextConverter x:Key="BoolToScanButtonText"/>
            <helpers:BoolToHorizontalAlignmentConverter x:Key="BoolToHorizontalAlignment"/>
            <helpers:IntToVisibilityConverter x:Key="IntToVisibility"/>
            <helpers:IntToResultsTextConverter x:Key="IntToResultsText"/>
            <helpers:PriorityToBrushConverter x:Key="PriorityToBrush"/>
            <helpers:SelectedCountToLabelConverter x:Key="SelectedCountToLabel"/>
            <helpers:SelectedIdBrushConverter x:Key="SelectedIdBrush"/>
            <helpers:SelectedIdBorderConverter x:Key="SelectedIdBorder"/>
            <helpers:SelectedIdVisibilityConverter x:Key="SelectedIdVisibility"/>
            <helpers:SelectedFlagBrushConverter x:Key="SelectedFlagBrush"/>
            <helpers:SelectedFlagBorderConverter x:Key="SelectedFlagBorder"/>
            <helpers:ScanTypeToBrushConverter x:Key="ScanTypeToBrush"/>
            <helpers:DoubleToPercentTextConverter x:Key="DoubleToPercentText"/>
            <helpers:SourceToLabelConverter x:Key="SourceToLabel"/>
            <helpers:SourceToBrushConverter x:Key="SourceToBrush"/>
            <helpers:EnumEqualsConverter x:Key="EnumEqualsConverter"/>
            <helpers:BoolToChevronConverter x:Key="BoolToChevron"/>

            <!-- Spacing Tokens (Double) -->
            <x:Double x:Key="Space.XXL">32</x:Double>
            <x:Double x:Key="Space.XL">24</x:Double>
            <x:Double x:Key="Space.LG">16</x:Double>
            <x:Double x:Key="Space.MD">12</x:Double>
            <x:Double x:Key="Space.SM">8</x:Double>
            <x:Double x:Key="Space.XS">4</x:Double>

            <!-- Padding Tokens (Thickness) -->
            <Thickness x:Key="Thickness.XXL">32</Thickness>
            <Thickness x:Key="Thickness.XL">24</Thickness>
            <Thickness x:Key="Thickness.LG">16</Thickness>
            <Thickness x:Key="Thickness.MD">12</Thickness>
            <Thickness x:Key="Thickness.SM">8</Thickness>
            <Thickness x:Key="Thickness.XS">4</Thickness>

            <!-- Typography Styles -->
            <Style x:Key="Type.PageTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </Style>
                <Style x:Key="Type.SectionTitle" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="18"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Opacity" Value="1.0"/>
                </Style>
                <Style x:Key="Type.CardTitle" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="17"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                </Style>
                <Style x:Key="Type.SubTitle" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="15"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Opacity" Value="1.0"/>
                </Style>
                <Style x:Key="Type.Body" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <Setter Property="Opacity" Value="1.0"/>
                </Style>
                <!-- Secondary/caption text intentionally uses a high-opacity primary
                     brush (not a dimmed gray) so it stays above WCAG AA on dark cards. -->
                <Style x:Key="Type.Caption" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <Setter Property="Opacity" Value="0.95"/>
                </Style>
                <Style x:Key="Type.Hint" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <Setter Property="Opacity" Value="0.9"/>
                </Style>
                <Style x:Key="Type.Dim" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <Setter Property="Opacity" Value="0.9"/>
                </Style>
                <Style x:Key="Type.Tiny" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <Setter Property="Opacity" Value="0.9"/>
                </Style>
            <Style x:Key="Type.StatValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </Style>
             <Style x:Key="Type.StatLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Opacity" Value="0.9"/>
            </Style>
            <!-- Field-group label used above setting inputs so individual controls
                 read as distinct groups under the card section title. -->
            <Style x:Key="Type.FieldHeading" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                <Setter Property="Opacity" Value="1.0"/>
                <Setter Property="Margin" Value="0,0,0,2"/>
            </Style>
            <!-- Metric group label (CPU/Memory/GPU) — accent + semibold so it reads
                 as a distinct heading rather than body text. -->
            <Style x:Key="Type.GroupHeading" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
            </Style>

            <!-- TextBox Typography Styles (Control targetType) -->
            <!-- NOTE: previously used SystemControlDisabledBaseLowBrush for the border,
                 which made the border nearly invisible in dark mode. Use a real stroke
                 brush and drop the global Opacity so text stays high-contrast. -->
            <Style x:Key="Type.Caption.TextBox" TargetType="TextBox">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                <Setter Property="PlaceholderForeground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorSecondaryBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="8,5"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="MinHeight" Value="32"/>
            </Style>

            <!-- Primary directory/path text field: high-contrast foreground, visible
                 border, comfortable hit target. Applied to every folder/path input so
                 the app reads consistently across tabs. -->
            <Style x:Key="FieldTextBox" TargetType="TextBox">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                <Setter Property="PlaceholderForeground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Setter Property="Background" Value="{ThemeResource TextControlBackground}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorSecondaryBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="10,7"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="MinHeight" Value="38"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

            <!-- Icon Tokens -->
            <x:Double x:Key="Icon.Hero">28</x:Double>
            <x:Double x:Key="Icon.Button">24</x:Double>
            <x:Double x:Key="Icon.Card">20</x:Double>
            <x:Double x:Key="Icon.Small">16</x:Double>
            <x:Double x:Key="Icon.Tiny">14</x:Double>
            <x:Double x:Key="Icon.EmptyState">34</x:Double>
            <x:Double x:Key="Icon.EmptyStateOpacity">0.4</x:Double>

            <!-- ═══════════════════════════════════════════════════ -->
            <!-- Card Styles                                         -->
            <!-- ═══════════════════════════════════════════════════ -->

            <Style x:Key="DashboardCardBorder" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="{StaticResource Thickness.LG}"/>
            </Style>
            <!-- Card style with built-in entrance animation (for content that appears dynamically) -->
            <Style x:Key="AnimatedCard" TargetType="Border" BasedOn="{StaticResource DashboardCardBorder}">
                <Setter Property="Transitions">
                    <Setter.Value>
                        <TransitionCollection>
                            <EntranceThemeTransition/>
                        </TransitionCollection>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ItemCard" TargetType="Border" BasedOn="{StaticResource DashboardCardBorder}">
                <Setter Property="Padding" Value="{StaticResource Thickness.MD}"/>
                <Setter Property="CornerRadius" Value="6"/>
            </Style>
            <!-- Item card with built-in entrance animation -->
            <Style x:Key="AnimatedItemCard" TargetType="Border" BasedOn="{StaticResource ItemCard}">
                <Setter Property="Transitions">
                    <Setter.Value>
                        <TransitionCollection>
                            <EntranceThemeTransition/>
                        </TransitionCollection>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="CompactItemCard" TargetType="Border" BasedOn="{StaticResource DashboardCardBorder}">
                <Setter Property="Padding" Value="{StaticResource Thickness.SM}"/>
                <Setter Property="CornerRadius" Value="6"/>
            </Style>
            <Style x:Key="EmptyStateCard" TargetType="Border" BasedOn="{StaticResource DashboardCardBorder}">
                <!-- Borderless soft-tinted panel: reads as a "ready" placeholder rather
                     than a blank/broken card, and stays visually distinct from the
                     solid-bordered content cards above it. -->
                <Setter Property="Background" Value="{ThemeResource EmptyStateFillBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="{StaticResource Thickness.XL}"/>
            </Style>

            <!-- Hero card with accent surface tint -->
            <Style x:Key="HeroCard" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AccentSurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="{StaticResource Thickness.XL}"/>
                <Setter Property="Transitions">
                    <Setter.Value>
                        <TransitionCollection>
                            <EntranceThemeTransition/>
                        </TransitionCollection>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ═══════════════════════════════════════════════════ -->
            <!-- Button Styles                                       -->
            <!-- ═══════════════════════════════════════════════════ -->

            <Style x:Key="DashboardCardButton" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="16"/>
            </Style>
            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource AccentButtonBackground}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource AccentButtonBorderBrush}"/>
                <Setter Property="Foreground" Value="{ThemeResource AccentButtonForeground}"/>
                <Setter Property="Padding" Value="16,10"/>
                <Setter Property="MinWidth" Value="140"/>
            </Style>
            <!-- Ghost / secondary button: a clearly visible resting border so it reads
                 as a distinct, interactive control on dark cards (Browse, Open, Refresh,
                 Clear, pagination, etc.). Explicit hover/pressed/focus/disabled states
                 keep keyboard and pointer affordances intact. Small/Tiny derive from it. -->
            <Style x:Key="SecondaryButton" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource ButtonBackground}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorSecondaryBrush}"/>
                <Setter Property="Foreground" Value="{ThemeResource ButtonForeground}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource SystemControlHighlightAccentBrush}"/>
                <Setter Property="FocusVisualMargin" Value="-2"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter x:Name="CP"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                FocusVisualPrimaryBrush="{TemplateBinding FocusVisualPrimaryBrush}"
                                FocusVisualMargin="{TemplateBinding FocusVisualMargin}"
                                AutomationProperties.AccessibilityView="Raw">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CP" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AccentSurfaceBrush}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CP" Storyboard.TargetProperty="BorderBrush">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ControlStrokeColorSecondaryBrush}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CP" Storyboard.TargetProperty="Foreground">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CP" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AccentSurfaceBrush}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CP" Storyboard.TargetProperty="BorderBrush">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SystemControlHighlightAccentBrush}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CP" Storyboard.TargetProperty="Foreground">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CP" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ButtonBackgroundDisabled}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CP" Storyboard.TargetProperty="BorderBrush">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ButtonBorderBrushDisabled}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CP" Storyboard.TargetProperty="Foreground">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ButtonForegroundDisabled}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </ContentPresenter>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>
            <!-- Selectable card in a "pick one of N" grid (e.g. the Workflows picker).
                 Derives from SecondaryButton so it inherits explicit hover/pressed/focus/
                 disabled visual states, which a bare Border cannot provide: a Border is not
                 a Control, so it can never take keyboard focus or expose a button role to
                 assistive tech. Background/BorderBrush are set per item from IsSelected. -->
            <Style x:Key="SelectableCardButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                <Setter Property="Padding" Value="{StaticResource Thickness.MD}"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="MinHeight" Value="64"/>
            </Style>            <Style x:Key="TinyButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                <Setter Property="Padding" Value="6,3"/>
                <Setter Property="FontSize" Value="11"/>
            </Style>

            <!-- ═══════════════════════════════════════════════════ -->
            <!-- Progress Bar Styles                                 -->
            <!-- ═══════════════════════════════════════════════════ -->

            <Style x:Key="StandardProgressBar" TargetType="ProgressBar">
                <Setter Property="Height" Value="8"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}"/>
            </Style>
            <Style x:Key="CompactProgressBar" TargetType="ProgressBar">
                <Setter Property="Height" Value="6"/>
                <Setter Property="CornerRadius" Value="3"/>
            </Style>
            <Style x:Key="MinimalProgressBar" TargetType="ProgressBar">
                <Setter Property="Height" Value="4"/>
                <Setter Property="CornerRadius" Value="2"/>
            </Style>

            <!-- ═══════════════════════════════════════════════════ -->
            <!-- UX-Redesign Styles                                  -->
            <!-- ═══════════════════════════════════════════════════ -->

            <!-- Prominent call-to-action button with accent fill and larger padding.
                 Used for primary actions like "New Scan" to draw the eye. -->
            <Style x:Key="PrimaryCTAButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                <Setter Property="Padding" Value="20,12"/>
                <Setter Property="MinWidth" Value="160"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="CornerRadius" Value="8"/>
            </Style>

            <!-- Quick-action card button with icon, label, and description.
                 Wider than DashboardCardButton to accommodate a caption line. -->
            <Style x:Key="QuickActionButton" TargetType="Button" BasedOn="{StaticResource DashboardCardButton}">
                <Setter Property="Padding" Value="14,12"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <!-- Left accent bar gives the action list a clear, grouped affordance
                     hierarchy distinct from other dashboard content (backlog #35). -->
                <Setter Property="BorderThickness" Value="3,0,0,0"/>
                <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
            </Style>

            <!-- Suggestion chip: a pill-shaped, clearly interactive prompt that reads
                 as a distinct "chip" rather than a rectangular action button. -->
            <Style x:Key="SuggestionChip" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                <Setter Property="CornerRadius" Value="16"/>
                <Setter Property="Padding" Value="14,8"/>
                <Setter Property="FontWeight" Value="Normal"/>
            </Style>

            <!-- Small rounded badge for status pills (e.g. "Healthy", "Warning",
                 "Critical"). Consumer sets Foreground + Background per status. -->
            <Style x:Key="StatusBadge" TargetType="Border">
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="8,2"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- Section header with built-in spacing, used between major page
                 sections to create breathing room and visual hierarchy. -->
            <Style x:Key="SectionHeader" TargetType="StackPanel">
                <Setter Property="Spacing" Value="{StaticResource Space.XS}"/>
                <Setter Property="Margin" Value="0,4,0,0"/>
            </Style>

            <!-- Destructive action button (e.g. "Delete" in History). Uses the
                 semantic ErrorBrush so it is never mistaken for a neutral action,
                 and degrades to a clearly-disabled red-tint when IsEnabled=false. -->
            <Style x:Key="DangerButton" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource ErrorBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource ErrorBrush}"/>
                <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter x:Name="ContentPresenter"
                                              Background="{TemplateBinding Background}"
                                              BorderBrush="{TemplateBinding BorderBrush}"
                                              BorderThickness="{TemplateBinding BorderThickness}"
                                              CornerRadius="{TemplateBinding CornerRadius}"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                              AutomationProperties.AccessibilityView="Raw">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ErrorSubtleBrush}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="BorderBrush">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ErrorSubtleBrush}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TextFillColorDisabledBrush}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </ContentPresenter>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Empty-state building blocks: a slightly more visible icon, a full-
                 strength title, and a constrained, wrapped hint. Applied to the
                 Duplicates / Cleanup empty states so they read as "ready", not
                 "broken". -->
            <Style x:Key="EmptyStatePanel" TargetType="StackPanel">
                <Setter Property="Spacing" Value="{StaticResource Space.MD}"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="{StaticResource Thickness.XL}"/>
            </Style>
            <Style x:Key="EmptyStateIcon" TargetType="FontIcon">
                <Setter Property="FontSize" Value="{StaticResource Icon.EmptyState}"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Setter Property="Opacity" Value="0.55"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="EmptyStateTitle" TargetType="TextBlock" BasedOn="{StaticResource Type.SubTitle}">
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="Opacity" Value="1.0"/>
            </Style>
            <Style x:Key="EmptyStateHint" TargetType="TextBlock" BasedOn="{StaticResource Type.Body}">
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Opacity" Value="0.85"/>
                <Setter Property="MaxWidth" Value="420"/>
            </Style>

            <!-- Filter / option checkbox with a heavier label weight so functional
                 choices (Include hidden files, Perform cleanup, etc.) read as distinct
                 interactive controls rather than quiet body text. -->
            <Style x:Key="FieldCheckBox" TargetType="CheckBox">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
