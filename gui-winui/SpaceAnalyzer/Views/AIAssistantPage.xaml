<Page
    x:Class="SpaceAnalyzer.Views.AIAssistantPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SpaceAnalyzer.ViewModels"
    mc:Ignorable="d"
    NavigationCacheMode="Required"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.DataContext>
        <vm:AIAssistantViewModel x:Name="VM"/>
    </Page.DataContext>

    <Grid Padding="24" MaxWidth="900">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,16">
            <TextBlock Text="AI Assistant" FontSize="28" FontWeight="Bold"/>
            <TextBlock Text="Chat with your local Ollama AI to analyze disk usage."
                       FontSize="14" Opacity="0.8"/>
        </StackPanel>

        <!-- Message list -->
        <ScrollViewer x:Name="MessageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{x:Bind VM.Messages, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="8"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AIChatMessage">
                        <Border Padding="12" CornerRadius="12" MaxWidth="70%"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <TextBlock Text="{x:Bind Content, Mode=OneWay}"
                                       TextWrapping="Wrap" FontSize="14"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Input area -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     Text="{x:Bind VM.InputText, Mode=TwoWay}"
                     PlaceholderText="Ask about your disk usage..."
                     AcceptsReturn="True"
                     KeyDown="Input_KeyDown"
                     AutomationProperties.Name="Chat message input"/>
            <Button Grid.Column="1"
                    Content="Send"
                    Click="Send_Click"
                    IsEnabled="{x:Bind VM.IsNotBusy, Mode=OneWay}"
                    Padding="16,10"
                    Margin="8,0,0,0"
                    AutomationProperties.Name="Send message"/>
        </Grid>

        <!-- Status -->
        <TextBlock Grid.Row="3" Text="{x:Bind VM.StatusText, Mode=OneWay}"
                   FontSize="12" Opacity="0.6"
                   Margin="0,4,0,0"/>
    </Grid>
</Page>
