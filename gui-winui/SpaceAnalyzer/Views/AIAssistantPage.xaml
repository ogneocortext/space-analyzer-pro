<Page
    x:Class="SpaceAnalyzer.Views.AIAssistantPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SpaceAnalyzer.ViewModels"
    xmlns:svc="using:SpaceAnalyzer.Services"
    xmlns:controls="using:SpaceAnalyzer.Controls"
    mc:Ignorable="d"
    NavigationCacheMode="Required"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <!-- Template for normal text messages (user, assistant, system) -->
        <DataTemplate x:Key="TextMessageTemplate" x:DataType="vm:AIChatMessage">
            <StackPanel Spacing="4">
                <!-- Role label -->
                <TextBlock Style="{StaticResource Type.Caption}"
                           Opacity="0.5"
                           Margin="8,0,0,0"
                           Text="{x:Bind Role, Mode=OneWay}"
                           Visibility="{x:Bind IsUser, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}"/>

                <!-- Message bubble -->
                <Border Padding="16" CornerRadius="16" MaxWidth="70%"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}"
                        HorizontalAlignment="{x:Bind IsUser, Mode=OneWay, Converter={StaticResource BoolToHorizontalAlignment}}">
                    <StackPanel Spacing="{StaticResource Space.XS}">
                        <!-- Tool name badge -->
                        <Border Background="{ThemeResource AccentSurfaceBrush}"
                                CornerRadius="8"
                                Padding="8,4"
                                HorizontalAlignment="Left"
                                Visibility="{x:Bind IsTool, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE74C;" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Bind ToolName, Mode=OneWay}"
                                           Style="{StaticResource Type.Caption}"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <!-- Content -->
                        <TextBlock Text="{x:Bind Content, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource Type.Body}"/>

                        <!-- Timestamp + Copy -->
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.SM}" HorizontalAlignment="Right">
                            <TextBlock Text="{x:Bind TimestampDisplay, Mode=OneWay}"
                                       Style="{StaticResource Type.Tiny}" Opacity="0.5"/>
                            <Button Content="Copy" Click="CopyMessage_Click"
                                    Style="{StaticResource TinyButton}"
                                    Tag="{x:Bind Content}"
                                    Visibility="{x:Bind IsTool, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- Template for tool result messages — renders rich structured data -->
        <DataTemplate x:Key="ToolResultTemplate" x:DataType="vm:AIChatMessage">
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource Type.Caption}"
                           Opacity="0.5"
                           Margin="8,0,0,0"
                           Text="Tool"/>

                <Border Padding="16" CornerRadius="16" MaxWidth="80%"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}"
                        HorizontalAlignment="Left">
                    <StackPanel Spacing="{StaticResource Space.XS}">
                        <!-- Tool name badge -->
                        <Border Background="{ThemeResource AccentSurfaceBrush}"
                                CornerRadius="8"
                                Padding="8,4"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE74C;" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Bind ToolName, Mode=OneWay}"
                                           Style="{StaticResource Type.Caption}"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <!-- Rich tool result renderer -->
                        <controls:ToolResultPresenter
                            controls:ToolResultPresenter.ToolName="{x:Bind ToolName, Mode=OneWay}"
                            controls:ToolResultPresenter.ToolResult="{x:Bind Content, Mode=OneWay}"
                            MaxWidth="380"/>

                        <!-- Timestamp -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{x:Bind TimestampDisplay, Mode=OneWay}"
                                       Style="{StaticResource Type.Tiny}" Opacity="0.5"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- Template selector -->
        <controls:ChatMessageTemplateSelector x:Key="ChatMessageTemplateSelector"
                                               TextTemplate="{StaticResource TextMessageTemplate}"
                                               ToolResultTemplate="{StaticResource ToolResultTemplate}"/>
    </Page.Resources>

    <Grid Padding="{StaticResource Thickness.XL}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="{StaticResource Space.MD}" Margin="0,0,0,16">
            <TextBlock Text="AI Assistant" Style="{StaticResource Type.PageTitle}"/>
            <TextBlock Text="Chat with your local Ollama AI to analyze disk usage."
                        Style="{StaticResource Type.Caption}" Opacity="0.85"/>

            <!-- Live Ollama connection status + manual retry -->
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.SM}" Margin="0,4,0,0">
                <Border Style="{StaticResource StatusBadge}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="{x:Bind VM.ConnectionStatusGlyph, Mode=OneWay}"
                                  FontSize="{StaticResource Icon.Small}"
                                  Foreground="{x:Bind VM.ConnectionStatusBrush, Mode=OneWay}"/>
                        <TextBlock Text="{x:Bind VM.ConnectionStatusText, Mode=OneWay}"
                                    Style="{StaticResource Type.Caption}"/>
                    </StackPanel>
                </Border>

                <Button Click="RetryConnection_Click"
                        Style="{StaticResource TinyButton}"
                        Visibility="{x:Bind VM.CanRetryConnection, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        AutomationProperties.Name="Retry Ollama connection">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE72C;" FontSize="{StaticResource Icon.Tiny}" VerticalAlignment="Center"/>
                        <TextBlock Text="Retry" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Installed models (wraps horizontally; never clipped) -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          Visibility="{x:Bind VM.OllamaConnected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                          Margin="0,4,0,0">
                <ItemsControl ItemsSource="{x:Bind VM.InstalledModels, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="svc:OllamaModelInfo">
                            <Border Background="{x:Bind IsDefault, Mode=OneTime, Converter={StaticResource SelectedFlagBrush}}"
                                    BorderBrush="{x:Bind IsDefault, Mode=OneTime, Converter={StaticResource SelectedFlagBorder}}"
                                    BorderThickness="1" CornerRadius="12" Padding="8,4" Margin="0,0,2,0">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8EC;" FontSize="12" Opacity="0.7"/>
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource Type.Caption}"/>
                                    <TextBlock Text="{x:Bind SizeDisplay}" Style="{StaticResource Type.Tiny}" Opacity="0.55"/>
                                    <Border Visibility="{x:Bind IsDefault, Mode=OneTime, Converter={StaticResource BoolToVisibility}}"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="6"
                                            Padding="4,1" Margin="2,0,0,0">
                                        <TextBlock Text="default" Style="{StaticResource Type.Tiny}"
                                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Text="No models installed yet — pull one with 'ollama pull &lt;model&gt;'."
                        Style="{StaticResource StatusBarText}"
                        Visibility="{x:Bind VM.ShowNoModelsHint, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
        </StackPanel>

        <!-- Message list + suggestions -->
        <Grid Grid.Row="1">
            <ScrollViewer x:Name="MessageScroll" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="MessageContainer" Spacing="{StaticResource Space.MD}">
                    <ItemsControl ItemsSource="{x:Bind VM.Messages, Mode=OneWay}"
                                  ItemTemplateSelector="{StaticResource ChatMessageTemplateSelector}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="{StaticResource Space.MD}"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- Typing indicator -->
                    <StackPanel x:Name="ThinkingIndicator"
                                Orientation="Horizontal"
                                Spacing="8"
                                Margin="16,0,0,0"
                                Visibility="{x:Bind VM.IsThinking, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <Border Padding="12,8" CornerRadius="12"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ProgressRing IsActive="True" Width="16" Height="16"/>
                                <TextBlock x:Name="ThinkingText" Text="{x:Bind VM.ThinkingStatus, Mode=OneWay}"
                                           Style="{StaticResource Type.Body}" Opacity="0.7"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Suggested prompts -->
                    <StackPanel Spacing="{StaticResource Space.SM}" Margin="0,0,0,12"
                                Visibility="{x:Bind VM.ShowSuggestions, Mode=OneWay}">
                        <TextBlock Text="Try asking:" Style="{StaticResource StatusBarText}"/>
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.SM}">
                            <Button Content="What takes up the most space?" Click="SuggestedPrompt_Click"
                                    Style="{StaticResource SuggestionChip}" Tag="What takes up the most space?"/>
                            <Button Content="Summarize my disk usage" Click="SuggestedPrompt_Click"
                                    Style="{StaticResource SuggestionChip}" Tag="Summarize my disk usage"/>
                            <Button Content="Find cleanup opportunities" Click="SuggestedPrompt_Click"
                                    Style="{StaticResource SuggestionChip}" Tag="Find cleanup opportunities"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Jump to latest (only when scrolled up to read history) -->
            <Button x:Name="JumpToLatest"
                    Click="JumpToLatest_Click"
                    Visibility="Collapsed"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,12,12"
                    Style="{StaticResource SecondaryButton}"
                    AutomationProperties.Name="Scroll to latest message">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="&#x2193;" FontSize="{StaticResource Icon.Small}" VerticalAlignment="Center"/>
                    <TextBlock Text="New messages" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Input area -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
             <TextBox Grid.Column="0"
                      Text="{x:Bind VM.InputText, Mode=TwoWay}"
                      PlaceholderText="Ask about your disk usage..."
                      AcceptsReturn="True"
                      KeyDown="Input_KeyDown"
                      IsEnabled="{x:Bind VM.IsNotBusy, Mode=OneWay}"
                      AutomationProperties.Name="Chat message input"
                      Style="{StaticResource FieldTextBox}"/>
            <Button Grid.Column="1"
                    Content="Send"
                    Click="Send_Click"
                    IsEnabled="{x:Bind VM.CanSend, Mode=OneWay}"
                    Style="{StaticResource PrimaryButton}"
                    Margin="8,0,0,0"
                    AutomationProperties.Name="Send message"/>
            <Button Grid.Column="2"
                    Click="ClearChat_Click"
                    Style="{StaticResource SecondaryButton}"
                    Margin="4,0,0,0"
                    IsEnabled="{x:Bind VM.IsNotBusy, Mode=OneWay}"
                    AutomationProperties.Name="Clear chat">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE894;" FontSize="{StaticResource Icon.Small}" VerticalAlignment="Center"/>
                    <TextBlock Text="Clear" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="3"
                    Click="Stop_Click"
                    Style="{StaticResource DangerButton}"
                    Margin="4,0,0,0"
                    IsEnabled="{x:Bind VM.IsBusy, Mode=OneWay}"
                    AutomationProperties.Name="Stop assistant">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE71A;" FontSize="{StaticResource Icon.Small}" VerticalAlignment="Center"/>
                    <TextBlock Text="Stop" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Status -->
        <TextBlock Grid.Row="3" Text="{x:Bind VM.StatusText, Mode=OneWay}"
                   Style="{StaticResource Type.Caption}"
                   Opacity="0.6"
                   Margin="0,4,0,0"/>
    </Grid>
</Page>
