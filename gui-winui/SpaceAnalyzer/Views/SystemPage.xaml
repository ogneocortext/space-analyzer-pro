<Page
    x:Class="SpaceAnalyzer.Views.SystemPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SpaceAnalyzer.ViewModels"
    xmlns:models="using:SpaceAnalyzer.Services"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.DataContext>
        <vm:SystemViewModel x:Name="VM"/>
    </Page.DataContext>

    <Grid Padding="24">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" MaxWidth="1000" HorizontalAlignment="Center">

                <!-- Header -->
                <StackPanel Spacing="4">
                    <TextBlock Text="System Resources" FontSize="24" FontWeight="Bold"/>
                    <TextBlock Text="Monitor system resources including CPU, memory, and disk health." FontSize="14" Opacity="0.6"/>
                </StackPanel>

                <!-- CPU & Memory -->
                <Border Style="{StaticResource DashboardCardBorder}">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- CPU -->
                        <StackPanel Grid.Column="0" Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE964;" FontSize="16" VerticalAlignment="Center"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                <TextBlock Text="CPU" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ProgressBar x:Name="CpuBar" Value="{x:Bind VM.CpuUsage, Mode=OneWay}"
                                         Maximum="100" Height="8" CornerRadius="4"
                                         Foreground="{x:Bind VM.CpuBrush, Mode=OneWay}"/>
                            <TextBlock Text="{x:Bind VM.CpuUsageDisplay, Mode=OneWay}"
                                       FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Usage" FontSize="12" Opacity="0.5" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Memory -->
                        <StackPanel Grid.Column="1" Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE9F9;" FontSize="16" VerticalAlignment="Center"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Memory" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ProgressBar x:Name="MemBar" Value="{x:Bind VM.MemoryUsage, Mode=OneWay}"
                                         Maximum="100" Height="8" CornerRadius="4"
                                         Foreground="{x:Bind VM.MemoryBrush, Mode=OneWay}"/>
                            <TextBlock Text="{x:Bind VM.MemoryUsageDisplay, Mode=OneWay}"
                                       FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Usage" FontSize="12" Opacity="0.5" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Memory Details -->
                <Border Style="{StaticResource DashboardCardBorder}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Memory Details" FontSize="16" FontWeight="SemiBold"/>
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Total" FontSize="12" Opacity="0.6"/>
                                <TextBlock Text="{x:Bind VM.TotalMemoryDisplay, Mode=OneWay}" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Used" FontSize="12" Opacity="0.6"/>
                                <TextBlock Text="{x:Bind VM.UsedMemoryDisplay, Mode=OneWay}" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock Text="Available" FontSize="12" Opacity="0.6"/>
                                <TextBlock Text="{x:Bind VM.AvailableMemoryDisplay, Mode=OneWay}" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Disk Volumes -->
                <Border Style="{StaticResource DashboardCardBorder}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Disk Volumes" FontSize="16" FontWeight="SemiBold"/>
                        <ItemsRepeater ItemsSource="{x:Bind VM.DiskVolumes, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="8"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:DiskVolume">
                                        <StackPanel Spacing="6" Margin="0,4">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontSize="14" FontWeight="SemiBold">
                                                    <Run Text="{x:Bind MountPoint, Mode=OneWay}"/>
                                                    <Run Text=" — "/>
                                                    <Run Text="{x:Bind Label, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <ProgressBar Value="{x:Bind UsagePercent, Mode=OneWay}"
                                                         Maximum="100" Height="6"
                                                         CornerRadius="3"
                                                         Foreground="{x:Bind UsageBrush, Mode=OneWay}"/>
                                            <TextBlock FontSize="12" Opacity="0.6">
                                                <Run Text="{x:Bind UsedDisplay, Mode=OneWay}"/>
                                                <Run Text=" used of "/>
                                                <Run Text="{x:Bind TotalDisplay, Mode=OneWay}"/>
                                                <Run Text=" — "/>
                                                <Run Text="{x:Bind UsagePercentDisplay, Mode=OneWay}" FontWeight="SemiBold"/>
                                                <Run Text=" · Free: "/>
                                                <Run Text="{x:Bind AvailableDisplay, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>

                <!-- Top Processes -->
                <Border Style="{StaticResource DashboardCardBorder}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Top Processes by Memory" FontSize="16" FontWeight="SemiBold"/>
                        <ItemsRepeater ItemsSource="{x:Bind VM.TopProcesses, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="6"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProcessInfo">
                                        <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,4">
                                            <TextBlock FontSize="13" FontWeight="SemiBold" Text="{x:Bind Name, Mode=OneWay}" Width="200"/>
                                            <TextBlock FontSize="13" Opacity="0.7" Text="{x:Bind MemoryDisplay, Mode=OneWay}"/>
                                            <TextBlock FontSize="12" Opacity="0.5" Text="{x:Bind PidDisplay, Mode=OneWay}"/>
                                        </StackPanel>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
