<Page
    x:Class="SpaceAnalyzer.Views.SystemPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SpaceAnalyzer.ViewModels"
    xmlns:models="using:SpaceAnalyzer.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="{StaticResource Thickness.XL}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="{StaticResource Space.XL}" MaxWidth="1000" HorizontalAlignment="Center">

                <!-- Header -->
                <StackPanel Spacing="{StaticResource Space.SM}">
                    <TextBlock Text="System Resources" Style="{StaticResource Type.PageTitle}"/>
                    <TextBlock Text="Monitor CPU, memory, disk volumes, and top processes in real time." Style="{StaticResource Type.Body}"/>
                </StackPanel>

                <!-- CPU, Memory & GPU -->
                <Border Style="{StaticResource DashboardCardBorder}" Padding="{StaticResource Thickness.LG}">
                    <Grid ColumnSpacing="{StaticResource Space.XXL}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- CPU -->
                        <StackPanel Grid.Column="0" Spacing="{StaticResource Space.MD}"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    Padding="{StaticResource Thickness.MD}" CornerRadius="6">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.SM}">
                                <FontIcon Glyph="&#xE964;" FontSize="{StaticResource Icon.Small}" VerticalAlignment="Center"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
<TextBlock Text="CPU" Style="{StaticResource Type.GroupHeading}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ProgressBar x:Name="CpuBar" Value="{x:Bind VM.CpuUsage, Mode=OneWay}"
                                         Maximum="100" Style="{StaticResource StandardProgressBar}"
                                         Foreground="{x:Bind VM.CpuBrush, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind VM.CpuUsageDisplay, Mode=OneWay}"
                                       Style="{StaticResource Type.StatValue}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Usage" Style="{StaticResource Type.Caption}" Opacity="0.7" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Memory -->
                        <StackPanel Grid.Column="1" Spacing="{StaticResource Space.MD}"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    Padding="{StaticResource Thickness.MD}" CornerRadius="6">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.SM}">
                                <FontIcon Glyph="&#xE9F9;" FontSize="{StaticResource Icon.Small}" VerticalAlignment="Center"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
<TextBlock Text="Memory" Style="{StaticResource Type.GroupHeading}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ProgressBar x:Name="MemBar" Value="{x:Bind VM.MemoryUsage, Mode=OneWay}"
                                         Maximum="100" Style="{StaticResource StandardProgressBar}"
                                         Foreground="{x:Bind VM.MemoryBrush, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind VM.MemoryUsageDisplay, Mode=OneWay}"
                                       Style="{StaticResource Type.StatValue}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Usage" Style="{StaticResource Type.Caption}" Opacity="0.7" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- GPU -->
                        <StackPanel Grid.Column="2" Spacing="{StaticResource Space.MD}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.SM}">
                                <FontIcon Glyph="&#xF211;" FontSize="{StaticResource Icon.Small}" VerticalAlignment="Center"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                <TextBlock Text="GPU" Style="{StaticResource Type.GroupHeading}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Available: live gauge + percentage -->
                            <StackPanel Spacing="{StaticResource Space.MD}"
                                        Visibility="{x:Bind VM.GpuAvailable, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <ProgressBar x:Name="GpuBar" Value="{x:Bind VM.GpuUsage, Mode=OneWay}"
                                             Maximum="100" Style="{StaticResource StandardProgressBar}"
                                             Foreground="{x:Bind VM.GpuBrush, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind VM.GpuUsageDisplay, Mode=OneWay}"
                                            Style="{StaticResource Type.StatValue}" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- Unavailable: explicit status instead of a bare "n/a" -->
                            <Border BorderBrush="{ThemeResource SystemFillColorCautionBrush}" BorderThickness="1" CornerRadius="8"
                                    Padding="{StaticResource Thickness.SM}"
                                    Opacity="0.92"
                                    Visibility="{x:Bind VM.GpuAvailable, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
                                <StackPanel Spacing="{StaticResource Space.SM}">
                                    <FontIcon Glyph="&#xE7BA;" FontSize="{StaticResource Icon.Small}" HorizontalAlignment="Center"
                                              Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                                    <TextBlock Text="Not available" Style="{StaticResource Type.Caption}"
                                                HorizontalAlignment="Center" TextAlignment="Center" FontWeight="SemiBold"/>
                                    <TextBlock Text="{x:Bind VM.GpuSubtitle, Mode=OneWay}" Style="{StaticResource Type.Caption}"
                                                Opacity="0.8" HorizontalAlignment="Center" TextAlignment="Center"
                                                TextWrapping="Wrap"/>
                                    <TextBlock Text="Windows does not expose live GPU performance counters for this adapter, so usage cannot be displayed."
                                                Style="{StaticResource Type.Tiny}" Opacity="0.7" HorizontalAlignment="Center"
                                                TextAlignment="Center" TextWrapping="Wrap"/>
                                    <TextBlock Text="Enable them in Windows Settings → System → Display → Graphics, or via your GPU vendor's control panel."
                                                Style="{StaticResource Type.Tiny}" Opacity="0.7" HorizontalAlignment="Center"
                                                TextAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Memory Details -->
                <Border Style="{StaticResource DashboardCardBorder}" Padding="{StaticResource Thickness.LG}">
                    <StackPanel Spacing="{StaticResource Space.MD}">
                        <TextBlock Text="Memory Details" Style="{StaticResource Type.CardTitle}"/>
                        <Grid ColumnSpacing="{StaticResource Space.XL}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="{StaticResource Space.XS}">
                                <TextBlock Text="Total" Style="{StaticResource Type.Caption}" Opacity="0.9"/>
                                <TextBlock Text="{x:Bind VM.TotalMemoryDisplay, Mode=OneWay}" Style="{StaticResource Type.SubTitle}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="1" Margin="0,2" Background="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.6"/>
                            <StackPanel Grid.Column="2" Spacing="{StaticResource Space.XS}">
                                <TextBlock Text="Used" Style="{StaticResource Type.Caption}" Opacity="0.9"/>
                                <TextBlock Text="{x:Bind VM.UsedMemoryDisplay, Mode=OneWay}" Style="{StaticResource Type.SubTitle}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <Border Grid.Column="3" Width="1" Margin="0,2" Background="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.6"/>
                            <StackPanel Grid.Column="4" Spacing="{StaticResource Space.XS}">
                                <TextBlock Text="Available" Style="{StaticResource Type.Caption}" Opacity="0.9"/>
                                <TextBlock Text="{x:Bind VM.AvailableMemoryDisplay, Mode=OneWay}" Style="{StaticResource Type.SubTitle}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>


                <!-- Disk Volumes -->
                <Border Style="{StaticResource DashboardCardBorder}" Padding="{StaticResource Thickness.LG}">
                    <StackPanel Spacing="{StaticResource Space.LG}">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Disk Volumes" Style="{StaticResource Type.CardTitle}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Refresh" Click="Refresh_Click" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center"/>
                        </Grid>
                        <ItemsRepeater ItemsSource="{x:Bind VM.DiskVolumes, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="{StaticResource Space.MD}"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:DiskVolume">
                                    <StackPanel Spacing="{StaticResource Space.SM}">
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.MD}">
                                            <TextBlock Style="{StaticResource Type.SubTitle}"
                                                       Text="{x:Bind MountPoint, Mode=OneTime}"/>
                                            <TextBlock Style="{StaticResource Type.Body}" Opacity="0.8"
                                                       Text="{x:Bind Label, Mode=OneTime}"/>
                                            <TextBlock Style="{StaticResource Type.Caption}" Opacity="0.6"
                                                       Text="{x:Bind FileSystem, Mode=OneTime}"/>
                                            <Button Content="Open" Click="OpenVolume_Click"
                                                    Style="{StaticResource TinyButton}"
                                                    Tag="{x:Bind MountPoint, Mode=OneTime}"
                                                    HorizontalAlignment="Right"/>
                                        </StackPanel>
                                        <ProgressBar Value="{x:Bind UsagePercent, Mode=OneTime}"
                                                     Maximum="100" Height="6"
                                                     CornerRadius="3"
                                                     Foreground="{x:Bind UsageBrush, Mode=OneTime}"/>
                                        <TextBlock Style="{StaticResource Type.Body}" Opacity="0.8">
                                            <Run Text="{x:Bind UsedDisplay, Mode=OneTime}"/>
                                            <Run Text=" used of "/>
                                            <Run Text="{x:Bind TotalDisplay, Mode=OneTime}"/>
                                            <Run Text=" — "/>
                                            <Run Text="{x:Bind UsagePercentDisplay, Mode=OneTime}" FontWeight="SemiBold"/>
                                            <Run Text=" · Free: "/>
                                            <Run Text="{x:Bind AvailableDisplay, Mode=OneTime}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>

                <!-- Top Processes -->
                <Border Style="{StaticResource DashboardCardBorder}" Padding="{StaticResource Thickness.LG}">
                    <StackPanel Spacing="{StaticResource Space.LG}">
                        <TextBlock Text="Top Processes by Memory" Style="{StaticResource Type.CardTitle}"/>
                        <ItemsRepeater ItemsSource="{x:Bind VM.TopProcesses, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="{StaticResource Space.SM}"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:ProcessInfo">
                                    <Grid ColumnSpacing="{StaticResource Space.LG}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource Type.SubTitle}" FontWeight="SemiBold"
                                                   Text="{x:Bind Name, Mode=OneTime}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Style="{StaticResource Type.Body}" Opacity="0.8"
                                                   Text="{x:Bind MemoryDisplay, Mode=OneTime}"/>
                                        <TextBlock Grid.Column="2" Style="{StaticResource Type.Caption}" Opacity="0.7"
                                                   Text="{x:Bind PidDisplay, Mode=OneTime}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        <TextBlock Text="No process data available right now."
                                   Style="{StaticResource Type.Caption}" Opacity="0.7"
                                   Visibility="{x:Bind VM.HasTopProcesses, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>


