<Page
    x:Class="SpaceAnalyzer.Views.DuplicatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SpaceAnalyzer.ViewModels"
    xmlns:models="using:SpaceAnalyzer.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="{StaticResource Thickness.XL}"
          AllowDrop="True"
          DragOver="Page_DragOver"
          Drop="Page_Drop">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="{StaticResource Space.XL}" MaxWidth="1000" HorizontalAlignment="Center">

                <!-- Header -->
                <StackPanel Spacing="{StaticResource Space.SM}">
                    <TextBlock Text="Duplicate Files" Style="{StaticResource Type.PageTitle}"/>
                    <TextBlock Text="Find and remove duplicate files to reclaim disk space." Style="{StaticResource Type.Body}"/>
                </StackPanel>

                <!-- Path Selection -->
                <Border Style="{StaticResource DashboardCardBorder}" Padding="{StaticResource Thickness.LG}">
                    <StackPanel Spacing="{StaticResource Space.MD}">
                        <TextBlock Text="Directory" Style="{StaticResource Type.SubTitle}"/>
                        <Grid ColumnSpacing="{StaticResource Space.SM}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                             <TextBox Grid.Column="0" Text="{x:Bind VM.ScanPath, Mode=TwoWay}" PlaceholderText="Select a directory to analyze..." AutomationProperties.Name="Scan directory path" Style="{StaticResource FieldTextBox}"/>
                            <Button Grid.Column="1" Content="Browse" Click="Browse_Click" Style="{StaticResource SecondaryButton}" AutomationProperties.Name="Browse"/>
                            <Button Grid.Column="2" Content="Open" Click="OpenScanPath_Click" Style="{StaticResource SecondaryButton}" AutomationProperties.Name="Open scan path"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Analyze Button -->
                <Button Content="Analyze Duplicates" Click="Analyze_Click"
                        HorizontalAlignment="Stretch" Style="{StaticResource PrimaryButton}"
                        IsEnabled="{x:Bind VM.IsNotScanning, Mode=OneWay}"/>

                <!-- Hardlink Duplicates (reclaim space without deleting data) -->
                <Button Content="Hardlink Duplicates" Click="Hardlink_Click"
                        HorizontalAlignment="Stretch" Style="{StaticResource SecondaryButton}"
                        IsEnabled="{x:Bind VM.HasResult, Mode=OneWay}"
                        AutomationProperties.Name="Hardlink duplicate files"/>

                <!-- Deletion-impact preview (dependencies subcommand) -->
                <Border Style="{StaticResource DashboardCardBorder}" Padding="{StaticResource Thickness.LG}">
                    <StackPanel Spacing="{StaticResource Space.MD}">
                        <TextBlock Text="Deletion Impact Preview" Style="{StaticResource Type.SubTitle}"/>
                        <TextBlock Text="Check whether deleting a single file will break siblings, symlinks, or shared (hard-linked) data before you remove anything."
                                   Style="{StaticResource Type.Hint}" TextWrapping="Wrap"/>
                        <Grid ColumnSpacing="{StaticResource Space.SM}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{x:Bind VM.ImpactPath, Mode=TwoWay}" PlaceholderText="Path to the file you plan to delete..." Style="{StaticResource FieldTextBox}"/>
                            <Button Grid.Column="1" Content="Browse" Click="ImpactBrowse_Click" Style="{StaticResource SecondaryButton}" AutomationProperties.Name="Browse impact file"/>
                            <Button Grid.Column="2" Content="Analyze Impact" Click="AnalyzeImpact_Click" Style="{StaticResource PrimaryButton}" IsEnabled="{x:Bind VM.IsNotAnalyzingImpact, Mode=OneWay}" AutomationProperties.Name="Analyze deletion impact"/>
                        </Grid>

                        <Border Style="{StaticResource AnimatedCard}" Padding="{StaticResource Thickness.LG}" Visibility="{x:Bind VM.HasImpact, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Spacing="{StaticResource Space.MD}">
                                <TextBlock Text="Impact Summary" Style="{StaticResource Type.CardTitle}"/>
                                <TextBlock Text="{x:Bind VM.ImpactSummary, Mode=OneWay}" Style="{StaticResource Type.Body}" TextWrapping="Wrap"/>
                                <Grid ColumnSpacing="{StaticResource Space.XXL}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="{StaticResource Space.XS}">
                                        <TextBlock Text="{x:Bind VM.ImpactRelatedCount, Mode=OneWay}" Style="{StaticResource Type.StatValue}"/>
                                        <TextBlock Text="Related" Style="{StaticResource Type.StatLabel}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="{StaticResource Space.XS}">
                                        <TextBlock Text="{x:Bind VM.ImpactSameStemCount, Mode=OneWay}" Style="{StaticResource Type.StatValue}"/>
                                        <TextBlock Text="Same stem" Style="{StaticResource Type.StatLabel}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="{StaticResource Space.XS}">
                                        <TextBlock Text="{x:Bind VM.ImpactSiblingCount, Mode=OneWay}" Style="{StaticResource Type.StatValue}"/>
                                        <TextBlock Text="Siblings" Style="{StaticResource Type.StatLabel}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Spacing="{StaticResource Space.XS}">
                                        <TextBlock Text="{x:Bind VM.ImpactSymlinkSourceCount, Mode=OneWay}" Style="{StaticResource Type.StatValue}"/>
                                        <TextBlock Text="Symlink src" Style="{StaticResource Type.StatLabel}"/>
                                    </StackPanel>
                                </Grid>
                                <ItemsRepeater ItemsSource="{x:Bind VM.ImpactSiblingFiles, Mode=OneWay}" Margin="0,8,0,0">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Orientation="Vertical" Spacing="{StaticResource Space.XS}"/>
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="models:RelatedFile">
                                            <TextBlock Style="{StaticResource Type.Tiny}" Opacity="0.8" TextWrapping="Wrap">
                                                <Run Text="{x:Bind Relation, Mode=OneTime}"/>
                                                <Run Text=" — "/>
                                                <Run Text="{x:Bind Path, Mode=OneTime}"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Status -->
                <TextBlock Text="{x:Bind VM.StatusMessage, Mode=OneWay}" Style="{StaticResource Type.Body}"/>

                <!-- Results -->
                <Border Style="{StaticResource AnimatedCard}" Padding="{StaticResource Thickness.LG}" Visibility="{x:Bind VM.HasResultVisibility, Mode=OneWay}">
                    <StackPanel Spacing="{StaticResource Space.LG}">
                        <TextBlock Text="Analysis Results" Style="{StaticResource Type.CardTitle}" />

                        <!-- Sort + bulk selection controls -->
                        <Grid ColumnSpacing="{StaticResource Space.MD}" RowSpacing="{StaticResource Space.SM}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Sort by" VerticalAlignment="Center" Style="{StaticResource Type.Caption}"/>
                            <ComboBox Grid.Column="1" SelectedIndex="{x:Bind VM.SortIndex, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="Sort groups by">
                                <x:String>Wasted space</x:String>
                                <x:String>File size</x:String>
                                <x:String>Copies</x:String>
                            </ComboBox>
                            <CheckBox Grid.Column="2" Content="Select all"
                                      Checked="SelectAll_Click" Unchecked="SelectAll_Click"
                                      Style="{StaticResource FieldCheckBox}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                            <Button Grid.Column="3" Content="{x:Bind VM.SelectedCount, Mode=OneWay, Converter={StaticResource SelectedCountToLabel}}"
                                    Click="RemoveSelected_Click" IsEnabled="{x:Bind VM.HasSelection, Mode=OneWay}"
                                    Style="{StaticResource DangerButton}" VerticalAlignment="Center"/>
                            <ProgressRing Grid.Column="4" Width="18" Height="18" IsActive="{x:Bind VM.IsRemoving, Mode=OneWay}" Visibility="{x:Bind VM.IsRemoving, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Summary Stats -->
                        <Grid ColumnSpacing="{StaticResource Space.XXL}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="{StaticResource Space.XS}">
                                <TextBlock Text="{x:Bind VM.DuplicateGroupCount, Mode=OneWay}" Style="{StaticResource Type.StatValue}"/>
                                <TextBlock Text="Groups" Style="{StaticResource Type.StatLabel}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="{StaticResource Space.XS}">
                                <TextBlock Text="{x:Bind VM.TotalDuplicateFiles, Mode=OneWay}" Style="{StaticResource Type.StatValue}"/>
                                <TextBlock Text="Files" Style="{StaticResource Type.StatLabel}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="{StaticResource Space.XS}">
                                <TextBlock Text="{x:Bind VM.PotentialSavingsDisplay, Mode=OneWay}" Style="{StaticResource Type.StatValue}"/>
                                <TextBlock Text="Reclaimable" Style="{StaticResource Type.StatLabel}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Charts -->
                        <Grid ColumnSpacing="{StaticResource Space.LG}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="{StaticResource Space.SM}">
                                <TextBlock Text="Top Groups by Size" Style="{StaticResource Type.Caption}" Opacity="0.7"/>
                                <Grid x:Name="TopGroupsBarChartGrid" Height="180" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="{StaticResource Space.SM}">
                                <TextBlock Text="Wasted Space Distribution" Style="{StaticResource Type.Caption}" Opacity="0.7"/>
                                <Grid x:Name="WastedSpaceDonutGrid" Height="180" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Duplicate Groups List -->
                        <TextBlock Text="Duplicate Groups" Style="{StaticResource Type.SubTitle}" Margin="0,16,0,0"/>
                        <ItemsRepeater ItemsSource="{x:Bind VM.SortedGroups, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="{StaticResource Space.MD}"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:DuplicateGroup">
                                    <Border Style="{StaticResource ItemCard}">
                                        <Border.Transitions>
                                            <TransitionCollection>
                                                <EntranceThemeTransition/>
                                            </TransitionCollection>
                                        </Border.Transitions>
                                        <StackPanel Spacing="{StaticResource Space.SM}">
                                            <Grid ColumnSpacing="{StaticResource Space.MD}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0"
                                                          IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                          Checked="GroupCheck_Changed" Unchecked="GroupCheck_Changed"
                                                          Style="{StaticResource FieldCheckBox}" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" Spacing="{StaticResource Space.XS}">
                                                    <TextBlock Style="{StaticResource Type.SubTitle}" Text="{x:Bind PrimaryName, Mode=OneTime}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Style="{StaticResource Type.Body}" Opacity="0.8">
                                                        <Run Text="{x:Bind FileCount, Mode=OneTime}"/>
                                                        <Run Text=" copies"/>
                                                        <Run Text=" · "/>
                                                        <Run Text="{x:Bind SizeDisplay, Mode=OneTime}"/>
                                                        <Run Text=" each · "/>
                                                        <Run Text="{x:Bind WastedDisplay, Mode=OneTime}"/>
                                                        <Run Text=" wasted"/>
                                                    </TextBlock>
                                                    <TextBlock Style="{StaticResource Type.Tiny}" Opacity="0.55" FontFamily="Consolas">
                                                        <Run Text="hash "/>
                                                        <Run Text="{x:Bind HashShort, Mode=OneTime}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Style="{StaticResource Type.SubTitle}" Text="{x:Bind WastedDisplay, Mode=OneTime}" VerticalAlignment="Center"/>
                                            </Grid>
                                            <ItemsRepeater ItemsSource="{x:Bind Files, Mode=OneTime}">
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.SM}" Margin="0,4,0,0">
                                                            <TextBlock Style="{StaticResource Type.Body}" Opacity="0.7" Text="{x:Bind}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                            <Button Content="Open" Click="OpenDuplicateFile_Click" Style="{StaticResource TinyButton}" Tag="{x:Bind}" VerticalAlignment="Center"/>
                                                            <Button Content="Folder" Click="OpenDuplicateFolder_Click" Style="{StaticResource TinyButton}" Tag="{x:Bind}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>

                <!-- Empty State -->
                <Border Style="{StaticResource EmptyStateCard}" Visibility="{x:Bind VM.HasResultVisibility, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
                    <StackPanel Style="{StaticResource EmptyStatePanel}">
                        <FontIcon Glyph="&#xEB9F;" Style="{StaticResource EmptyStateIcon}"/>
                        <TextBlock Text="Ready to find duplicates" Style="{StaticResource EmptyStateTitle}"/>
                        <TextBlock Text="Select a directory and click Analyze Duplicates to get started." Style="{StaticResource EmptyStateHint}"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

