<Page
    x:Class="SpaceAnalyzer.Views.CleanupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SpaceAnalyzer.ViewModels"
    xmlns:models="using:SpaceAnalyzer.Models"
    xmlns:helpers="using:SpaceAnalyzer.Helpers"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <helpers:EnumEqualsConverter x:Key="EnumEquals"/>
    </Page.Resources>

    <Grid Padding="{StaticResource Thickness.XL}"
          AllowDrop="True"
          DragOver="Page_DragOver"
          Drop="Page_Drop">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="{StaticResource Space.XL}" MaxWidth="1000" HorizontalAlignment="Center">

                <!-- Header -->
                <StackPanel Spacing="{StaticResource Space.SM}">
                    <TextBlock Text="Cleanup" Style="{StaticResource Type.PageTitle}"/>
                    <TextBlock Text="Reclaim disk space by cleaning node_modules or general temp/cache folders." Style="{StaticResource Type.Body}"/>
                </StackPanel>

                <!-- Mode selector -->
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.MD}">
                    <ToggleButton Content="node_modules" IsChecked="{x:Bind VM.Mode, Mode=TwoWay, Converter={StaticResource EnumEquals}, ConverterParameter='NodeModules'}"/>
                    <ToggleButton Content="Temp &amp; Caches" IsChecked="{x:Bind VM.Mode, Mode=TwoWay, Converter={StaticResource EnumEquals}, ConverterParameter='TempCaches'}"/>
                </StackPanel>

                <!-- Target Path -->
                <Border Style="{StaticResource DashboardCardBorder}" Padding="{StaticResource Thickness.LG}">
                    <StackPanel Spacing="{StaticResource Space.MD}">
                        <TextBlock Text="Target Directory" Style="{StaticResource Type.SubTitle}"/>
                        <Grid ColumnSpacing="{StaticResource Space.SM}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                             <TextBox Grid.Column="0" Text="{x:Bind VM.TargetPath, Mode=TwoWay}" PlaceholderText="Select a directory to analyze..." AutomationProperties.Name="Target directory" Style="{StaticResource FieldTextBox}"/>
                            <Button Grid.Column="1" Content="Browse" Click="Browse_Click" Style="{StaticResource SecondaryButton}" AutomationProperties.Name="Browse"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Options (node_modules mode) -->
                <Border Style="{StaticResource DashboardCardBorder}" Padding="{StaticResource Thickness.LG}"
                        Visibility="{x:Bind VM.IsNodeModulesMode, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Spacing="{StaticResource Space.LG}">
                        <TextBlock Text="Options" Style="{StaticResource Type.SubTitle}"/>
                        <Grid ColumnSpacing="{StaticResource Space.XXL}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="{StaticResource Space.SM}">
                                <TextBlock Text="Min size (MB)" Style="{StaticResource Type.Caption}" Opacity="0.8"/>
                                <TextBox Text="{x:Bind VM.MinSizeMb, Mode=TwoWay}" AutomationProperties.Name="Minimum size in megabytes">
                                    <TextBox.InputScope>
                                        <InputScope>
                                            <InputScope.Names>
                                                <InputScopeName NameValue="Number"/>
                                            </InputScope.Names>
                                        </InputScope>
                                    </TextBox.InputScope>
                                </TextBox>
                            </StackPanel>
                            <StackPanel Spacing="{StaticResource Space.SM}">
                                <TextBlock Text="Unused days" Style="{StaticResource Type.Caption}" Opacity="0.8"/>
                                <TextBox Text="{x:Bind VM.UnusedDays, Mode=TwoWay}" AutomationProperties.Name="Unused days threshold">
                                    <TextBox.InputScope>
                                        <InputScope>
                                            <InputScope.Names>
                                                <InputScopeName NameValue="Number"/>
                                            </InputScope.Names>
                                        </InputScope>
                                    </TextBox.InputScope>
                                </TextBox>
                            </StackPanel>
                        </Grid>
                        <CheckBox Content="Perform cleanup (delete files)" IsChecked="{x:Bind VM.PerformCleanup, Mode=TwoWay}" Style="{StaticResource FieldCheckBox}"/>
                        <TextBlock Text="Off by default. When enabled, matching files are permanently deleted — review the candidates list before running."
                                   Style="{StaticResource Type.Hint}"/>

                    </StackPanel>
                </Border>

                <!-- Temp & Caches options -->
                <Border Style="{StaticResource DashboardCardBorder}" Padding="{StaticResource Thickness.LG}"
                        Visibility="{x:Bind VM.IsTempMode, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Spacing="{StaticResource Space.MD}">
                        <TextBlock Text="Temp &amp; Cache Cleaner" Style="{StaticResource Type.SubTitle}"/>
                        <TextBlock Text="Lists the top-level folders and files in the target directory so you can review and send them to the Recycle Bin. Nothing is deleted until you confirm." Style="{StaticResource Type.Body}"/>
                        <Button Content="Use Temp Folder" Click="UseTempFolder_Click" Style="{StaticResource SecondaryButton}" AutomationProperties.Name="Use Temp Folder"/>
                    </StackPanel>
                </Border>

                <!-- Action Buttons (mode-specific) -->
                <Button Content="Find cleanable node_modules" Click="Analyze_Click"
                        HorizontalAlignment="Stretch" Style="{StaticResource PrimaryButton}"
                        IsEnabled="{x:Bind VM.CanAnalyze, Mode=OneWay}"
                        Visibility="{x:Bind VM.IsNodeModulesMode, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
                <Button Content="Scan Temp Folder" Click="AnalyzeTemp_Click"
                        HorizontalAlignment="Stretch" Style="{StaticResource PrimaryButton}"
                        IsEnabled="{x:Bind VM.IsNotAnalyzing, Mode=OneWay}"
                        Visibility="{x:Bind VM.IsTempMode, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>

                <!-- Status -->
                <TextBlock Text="{x:Bind VM.StatusMessage, Mode=OneWay}" Style="{StaticResource Type.Caption}" Opacity="0.85"/>

                <!-- Results separator -->
                <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.5" Margin="0,4" />

                <!-- Results (node_modules mode) -->
                <Border Style="{StaticResource AnimatedCard}" Padding="{StaticResource Thickness.LG}" Visibility="{x:Bind VM.NodeModulesResultVisibility, Mode=OneWay}">
                    <StackPanel Spacing="{StaticResource Space.LG}">
                        <TextBlock Text="Analysis Results" Style="{StaticResource Type.CardTitle}" />

                        <!-- Summary Stats -->
                        <Grid ColumnSpacing="{StaticResource Space.XXL}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="{StaticResource Space.XS}">
                                <TextBlock Text="{x:Bind VM.TotalSizeDisplay, Mode=OneTime}" Style="{StaticResource Type.StatValue}"/>
                                <TextBlock Text="Total" Style="{StaticResource Type.StatLabel}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="{StaticResource Space.XS}">
                                <TextBlock Text="{x:Bind VM.TotalFiles, Mode=OneWay}" Style="{StaticResource Type.StatValue}"/>
                                <TextBlock Text="Files" Style="{StaticResource Type.StatLabel}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="{StaticResource Space.XS}">
                                <TextBlock Text="{x:Bind VM.NodeModulesCount, Mode=OneWay}" Style="{StaticResource Type.StatValue}"/>
                                <TextBlock Text="node_modules" Style="{StaticResource Type.StatLabel}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Spacing="{StaticResource Space.XS}">
                                <TextBlock Text="{x:Bind VM.TotalCleanupSizeDisplay, Mode=OneTime}" Style="{StaticResource Type.StatValue}"/>
                                <TextBlock Text="Cleanable" Style="{StaticResource Type.StatLabel}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Charts -->
                        <Grid ColumnSpacing="{StaticResource Space.LG}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="{StaticResource Space.SM}">
                                <TextBlock Text="Top Candidates by Size" Style="{StaticResource Type.Caption}" Opacity="0.7"/>
                                <Grid x:Name="CandidatesBarChartGrid" Height="180" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="{StaticResource Space.SM}">
                                <TextBlock Text="Risk Distribution" Style="{StaticResource Type.Caption}" Opacity="0.7"/>
                                <Grid x:Name="RiskDonutGrid" Height="180" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Cleanup Candidates -->
                        <TextBlock Text="Cleanup Candidates" Style="{StaticResource Type.SubTitle}" Margin="0,16,0,0"/>
                        <ItemsRepeater ItemsSource="{x:Bind VM.CleanupCandidates, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="{StaticResource Space.MD}"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:CleanupCandidate">
                                    <Border Style="{StaticResource ItemCard}">
                                        <StackPanel Spacing="{StaticResource Space.SM}">
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.MD}">
                                                <TextBlock Style="{StaticResource Type.SubTitle}" Text="{x:Bind Path, Mode=OneTime}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Style="{StaticResource Type.Body}" Text="{x:Bind SizeDisplay, Mode=OneTime}" Opacity="0.8"/>
                                                <Button Content="Open" Click="OpenCandidateFolder_Click"
                                                        Style="{StaticResource TinyButton}"
                                                        Tag="{x:Bind Path, Mode=OneTime}"
                                                        HorizontalAlignment="Right"/>
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource Type.Body}" Opacity="0.8" Text="{x:Bind Reason, Mode=OneTime}"/>
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.SM}">
                                                <TextBlock Style="{StaticResource Type.Caption}" Opacity="0.7" Text="{x:Bind RiskLevelDisplay, Mode=OneTime}"/>
                                                <Border Width="8" Height="8" CornerRadius="4"
                                                        Background="{x:Bind RiskLevelBrush, Mode=OneTime}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <!-- Duplicate Packages -->
                        <TextBlock Text="Duplicate Packages" Style="{StaticResource Type.SubTitle}" Margin="0,16,0,0"/>
                        <ItemsRepeater ItemsSource="{x:Bind VM.DuplicatePackages, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="{StaticResource Space.MD}"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:DuplicatePackage">
                                    <Border Style="{StaticResource ItemCard}">
                                        <StackPanel Spacing="{StaticResource Space.SM}">
                                            <TextBlock Style="{StaticResource Type.SubTitle}" Text="{x:Bind Name, Mode=OneTime}"/>
                                            <TextBlock Style="{StaticResource Type.Body}" Opacity="0.8">
                                                <Run Text="{x:Bind Versions.Count, Mode=OneTime}"/>
                                                <Run Text=" versions, "/>
                                                <Run Text="{x:Bind TotalSizeDisplay, Mode=OneTime}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>

                <!-- Empty State (results placeholder) -->
                <Border Style="{StaticResource EmptyStateCard}" Visibility="{x:Bind VM.EmptyStateVisibility, Mode=OneWay}">
                    <StackPanel Spacing="{StaticResource Space.LG}">
                        <TextBlock Text="Analysis Results" Style="{StaticResource Type.CardTitle}"/>
                        <StackPanel Style="{StaticResource EmptyStatePanel}">
                            <FontIcon Glyph="&#xEB9F;" Style="{StaticResource EmptyStateIcon}"/>
                            <TextBlock Text="No cleanup results yet" Style="{StaticResource EmptyStateTitle}"/>
                            <TextBlock Text="Select a directory and click Analyze to find node_modules to clean up." Style="{StaticResource EmptyStateHint}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Temp & Cache results -->
                <Border Style="{StaticResource AnimatedCard}" Padding="{StaticResource Thickness.LG}" Visibility="{x:Bind VM.TempResultVisibility, Mode=OneWay}">
                    <StackPanel Spacing="{StaticResource Space.LG}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.MD}" VerticalAlignment="Center">
                            <TextBlock Text="Temp &amp; Cache Entries" Style="{StaticResource Type.CardTitle}"/>
                            <TextBlock Text="{x:Bind VM.TempSelectedSizeDisplay, Mode=OneWay}" Style="{StaticResource Type.Body}" Opacity="0.8"/>
                        </StackPanel>

                        <ItemsRepeater ItemsSource="{x:Bind VM.TempEntries, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="{StaticResource Space.MD}"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:TempCleanupEntry">
                                    <Border Style="{StaticResource ItemCard}">
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.MD}" VerticalAlignment="Center">
                                            <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/>
                                            <StackPanel Spacing="{StaticResource Space.XS}" HorizontalAlignment="Stretch">
                                                <TextBlock Style="{StaticResource Type.SubTitle}" Text="{x:Bind Name, Mode=OneTime}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Style="{StaticResource Type.Caption}" Opacity="0.7" Text="{x:Bind Path, Mode=OneTime}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource Type.Body}" Text="{x:Bind SizeDisplay, Mode=OneTime}" Opacity="0.8" VerticalAlignment="Center"/>
                                            <TextBlock Style="{StaticResource Type.Caption}" Opacity="0.6" Text="{x:Bind LastWriteDisplay, Mode=OneTime}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.SM}">
                            <Button Content="Delete Selected" Click="DeleteTempSelected_Click"
                                    Style="{StaticResource DangerButton}"
                                    IsEnabled="{x:Bind VM.TempHasSelection, Mode=OneWay}"
                                    AutomationProperties.Name="Delete selected temp items"/>
                            <Button Content="Select All" Click="SelectAllTemp_Click"
                                    Style="{StaticResource SecondaryButton}"
                                    AutomationProperties.Name="Select all temp items"/>
                            <Button Content="Clear" Click="ClearTempSelection_Click"
                                    Style="{StaticResource SecondaryButton}"
                                    AutomationProperties.Name="Clear temp selection"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

