<Page
    x:Class="SpaceAnalyzer.Views.CleanupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SpaceAnalyzer.ViewModels"
    xmlns:models="using:SpaceAnalyzer.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="{StaticResource Thickness.XL}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="{StaticResource Space.XL}" MaxWidth="1000" HorizontalAlignment="Center">

                <!-- Header -->
                <StackPanel Spacing="{StaticResource Space.SM}">
                    <TextBlock Text="node_modules Cleaner" Style="{StaticResource Type.PageTitle}"/>
                    <TextBlock Text="Analyze and clean node_modules directories to reclaim disk space." Style="{StaticResource Type.Body}"/>
                </StackPanel>

                <!-- Target Path -->
                <Border Style="{StaticResource DashboardCardBorder}" Padding="{StaticResource Thickness.LG}">
                    <StackPanel Spacing="{StaticResource Space.MD}">
                        <TextBlock Text="Target Directory" Style="{StaticResource Type.SubTitle}"/>
                        <Grid ColumnSpacing="{StaticResource Space.SM}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{x:Bind VM.TargetPath, Mode=TwoWay}" PlaceholderText="Select a directory to analyze..." AutomationProperties.Name="Target directory"/>
                            <Button Grid.Column="1" Content="Browse" Click="Browse_Click" Style="{StaticResource SecondaryButton}" AutomationProperties.Name="Browse"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Options -->
                <Border Style="{StaticResource DashboardCardBorder}" Padding="{StaticResource Thickness.LG}">
                    <StackPanel Spacing="{StaticResource Space.LG}">
                        <TextBlock Text="Options" Style="{StaticResource Type.SubTitle}"/>
                        <Grid ColumnSpacing="{StaticResource Space.XXL}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="{StaticResource Space.SM}">
                                <TextBlock Text="Min size (MB)" Style="{StaticResource Type.Caption}" Opacity="0.8"/>
                                <TextBox Text="{x:Bind VM.MinSizeMb, Mode=TwoWay}" AutomationProperties.Name="Minimum size in megabytes">
                                    <TextBox.InputScope>
                                        <InputScope>
                                            <InputScope.Names>
                                                <InputScopeName NameValue="Number"/>
                                            </InputScope.Names>
                                        </InputScope>
                                    </TextBox.InputScope>
                                </TextBox>
                            </StackPanel>
                            <StackPanel Spacing="{StaticResource Space.SM}">
                                <TextBlock Text="Unused days" Style="{StaticResource Type.Caption}" Opacity="0.8"/>
                                <TextBox Text="{x:Bind VM.UnusedDays, Mode=TwoWay}" AutomationProperties.Name="Unused days threshold">
                                    <TextBox.InputScope>
                                        <InputScope>
                                            <InputScope.Names>
                                                <InputScopeName NameValue="Number"/>
                                            </InputScope.Names>
                                        </InputScope>
                                    </TextBox.InputScope>
                                </TextBox>
                            </StackPanel>
                        </Grid>
                        <CheckBox Content="Perform cleanup (delete files)" IsChecked="{x:Bind VM.PerformCleanup, Mode=TwoWay}"/>
                    </StackPanel>
                </Border>

                <!-- Action Button -->
                <Button Content="Analyze node_modules" Click="Analyze_Click"
                        HorizontalAlignment="Stretch" Style="{StaticResource PrimaryButton}"
                        IsEnabled="{x:Bind VM.IsNotAnalyzing, Mode=OneWay}"/>

                <!-- Status -->
                <TextBlock Text="{x:Bind VM.StatusMessage, Mode=OneWay}" Style="{StaticResource Type.Body}"/>

                <!-- Results -->
                <Border Style="{StaticResource DashboardCardBorder}" Padding="{StaticResource Thickness.LG}" Visibility="{x:Bind VM.HasResultVisibility, Mode=OneWay}">
                    <StackPanel Spacing="{StaticResource Space.LG}">
                        <TextBlock Text="Analysis Results" Style="{StaticResource Type.CardTitle}" />

                        <!-- Summary Stats -->
                        <Grid ColumnSpacing="{StaticResource Space.XXL}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="{StaticResource Space.XS}">
                                <TextBlock Text="{x:Bind VM.TotalSizeDisplay, Mode=OneTime}" Style="{StaticResource Type.StatValue}"/>
                                <TextBlock Text="Total" Style="{StaticResource Type.StatLabel}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="{StaticResource Space.XS}">
                                <TextBlock Text="{x:Bind VM.TotalFiles, Mode=OneWay}" Style="{StaticResource Type.StatValue}"/>
                                <TextBlock Text="Files" Style="{StaticResource Type.StatLabel}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="{StaticResource Space.XS}">
                                <TextBlock Text="{x:Bind VM.NodeModulesCount, Mode=OneWay}" Style="{StaticResource Type.StatValue}"/>
                                <TextBlock Text="node_modules" Style="{StaticResource Type.StatLabel}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Spacing="{StaticResource Space.XS}">
                                <TextBlock Text="{x:Bind VM.TotalCleanupSizeDisplay, Mode=OneTime}" Style="{StaticResource Type.StatValue}"/>
                                <TextBlock Text="Cleanable" Style="{StaticResource Type.StatLabel}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Cleanup Candidates -->
                        <TextBlock Text="Cleanup Candidates" Style="{StaticResource Type.SubTitle}" Margin="0,16,0,0"/>
                        <ItemsRepeater ItemsSource="{x:Bind VM.CleanupCandidates, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="{StaticResource Space.MD}"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:CleanupCandidate">
                                    <Border Style="{StaticResource ItemCard}">
                                        <StackPanel Spacing="{StaticResource Space.SM}">
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.MD}">
                                                <TextBlock Style="{StaticResource Type.SubTitle}" Text="{x:Bind Path, Mode=OneTime}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Style="{StaticResource Type.Body}" Text="{x:Bind SizeDisplay, Mode=OneTime}" Opacity="0.8"/>
                                                <Button Content="Open" Click="OpenCandidateFolder_Click"
                                                        Style="{StaticResource TinyButton}"
                                                        Tag="{x:Bind Path, Mode=OneTime}"
                                                        HorizontalAlignment="Right"/>
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource Type.Body}" Opacity="0.8" Text="{x:Bind Reason, Mode=OneTime}"/>
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.SM}">
                                                <TextBlock Style="{StaticResource Type.Caption}" Opacity="0.7" Text="{x:Bind RiskLevelDisplay, Mode=OneTime}"/>
                                                <Border Width="8" Height="8" CornerRadius="4"
                                                        Background="{x:Bind RiskLevelBrush, Mode=OneTime}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <!-- Duplicate Packages -->
                        <TextBlock Text="Duplicate Packages" Style="{StaticResource Type.SubTitle}" Margin="0,16,0,0"/>
                        <ItemsRepeater ItemsSource="{x:Bind VM.DuplicatePackages, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="{StaticResource Space.MD}"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:DuplicatePackage">
                                    <Border Style="{StaticResource ItemCard}">
                                        <StackPanel Spacing="{StaticResource Space.SM}">
                                            <TextBlock Style="{StaticResource Type.SubTitle}" Text="{x:Bind Name, Mode=OneTime}"/>
                                            <TextBlock Style="{StaticResource Type.Body}" Opacity="0.8">
                                                <Run Text="{x:Bind Versions.Count, Mode=OneTime}"/>
                                                <Run Text=" versions, "/>
                                                <Run Text="{x:Bind TotalSizeDisplay, Mode=OneTime}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>

                <!-- Empty State -->
                <Border Style="{StaticResource EmptyStateCard}" Visibility="{x:Bind VM.HasResultVisibility, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
                    <StackPanel Spacing="{StaticResource Space.MD}" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xEB9F;" FontSize="{StaticResource Icon.EmptyState}" Opacity="{StaticResource Icon.EmptyStateOpacity}" HorizontalAlignment="Center"/>
                        <TextBlock Text="No cleanup results yet" Style="{StaticResource Type.CardTitle}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Select a directory and click Analyze to find node_modules to clean up." Style="{StaticResource Type.Body}" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

