<Page
    x:Class="SpaceAnalyzer.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SpaceAnalyzer.ViewModels"
    mc:Ignorable="d"
    NavigationCacheMode="Required"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.DataContext>
        <vm:SettingsViewModel x:Name="VM"/>
    </Page.DataContext>

    <Grid Padding="24">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="24" MaxWidth="800" HorizontalAlignment="Center">

                <!-- Header -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Settings" FontSize="28" FontWeight="Bold"/>
                    <TextBlock Text="Configure application preferences and integrations."
                               FontSize="14" Opacity="0.8"/>
                </StackPanel>

                <!-- Appearance -->
                <Border Style="{StaticResource DashboardCardBorder}" Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Appearance" FontSize="18" FontWeight="SemiBold"/>
                        <StackPanel Spacing="12">
                            <TextBlock Text="Theme" FontSize="14" FontWeight="SemiBold" Opacity="0.9"/>
                            <ComboBox Header="Theme"
                                      SelectedItem="{x:Bind VM.Theme, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="Theme">
                                <x:String>Dark</x:String>
                                <x:String>Light</x:String>
                                <x:String>System</x:String>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Scanner -->
                <Border Style="{StaticResource DashboardCardBorder}" Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Scanner" FontSize="18" FontWeight="SemiBold"/>
                        <StackPanel Spacing="12">
                            <TextBlock Text="Scanner binary path" FontSize="14" FontWeight="SemiBold" Opacity="0.9"/>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{x:Bind VM.ScannerPath, Mode=TwoWay}"
                                         PlaceholderText="Select scanner binary..."
                                         AutomationProperties.Name="Scanner binary path"/>
                                <Button Grid.Column="1" Content="Browse" Click="Browse_Click" Padding="12,8" AutomationProperties.Name="Browse"/>
                            </Grid>
                            <TextBlock Text="{x:Bind VM.ScannerPathStatus, Mode=OneWay}"
                                       FontSize="12"
                                       Foreground="{x:Bind VM.IsScannerPathValid, Mode=OneWay, Converter={StaticResource BoolToErrorBrush}}"
                                       Opacity="0.9"/>
                        </StackPanel>
                        <StackPanel Spacing="12">
                            <TextBlock Text="Default scan depth" FontSize="14" FontWeight="SemiBold" Opacity="0.9"/>
                            <Slider Minimum="1"
                                    Maximum="20"
                                    Value="{x:Bind VM.ScanDepth, Mode=TwoWay}"
                                    TickFrequency="4"
                                    Width="300"/>
                            <TextBlock Text="{x:Bind VM.ScanDepth, Mode=OneWay}"
                                       FontSize="12" Opacity="0.8"/>
                        </StackPanel>
                        <StackPanel Spacing="12">
                            <CheckBox Content="Include hidden files and folders by default"
                                      IsChecked="{x:Bind VM.IncludeHidden, Mode=TwoWay}"/>
                        </StackPanel>
                        <StackPanel Spacing="12">
                            <CheckBox Content="GPU acceleration"
                                      IsChecked="{x:Bind VM.GpuAcceleration, Mode=TwoWay}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Ollama -->
                <Border Style="{StaticResource DashboardCardBorder}" Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Ollama AI" FontSize="18" FontWeight="SemiBold"/>
                        <StackPanel Spacing="12">
                            <TextBlock Text="Server URL" FontSize="14" FontWeight="SemiBold" Opacity="0.9"/>
                            <TextBox Text="{x:Bind VM.OllamaUrl, Mode=TwoWay}"
                                     PlaceholderText="http://localhost:11434"
                                     AutomationProperties.Name="Ollama server URL"/>
                        </StackPanel>
                        <StackPanel Spacing="12">
                            <TextBlock Text="Model" FontSize="14" FontWeight="SemiBold" Opacity="0.9"/>
                            <TextBox Text="{x:Bind VM.OllamaModel, Mode=TwoWay}"
                                     PlaceholderText="gemma3:1b (or model name)"
                                     AutomationProperties.Name="Ollama model name"/>
                        </StackPanel>
                        <StackPanel Spacing="12">
                            <CheckBox Content="Enable Ollama AI"
                                      IsChecked="{x:Bind VM.OllamaEnabled, Mode=TwoWay}"/>
                        </StackPanel>
                        <StackPanel Spacing="12">
                            <CheckBox Content="Enable deep thinking / reasoning (Ollama 0.30+)"
                                      IsChecked="{x:Bind VM.OllamaThink, Mode=TwoWay}"/>
                        </StackPanel>
                        <StackPanel Spacing="12">
                            <CheckBox Content="Auto-start Ollama when needed"
                                      IsChecked="{x:Bind VM.AutoStartOllama, Mode=TwoWay}"/>
                        </StackPanel>
                        <StackPanel Spacing="12">
                            <CheckBox Content="Enable agentic tool calling"
                                      IsChecked="{x:Bind VM.AgenticToolsEnabled, Mode=TwoWay}"/>
                        </StackPanel>
                        <StackPanel Spacing="12">
                            <CheckBox Content="Auto-select model based on task"
                                      IsChecked="{x:Bind VM.AutoModelSelection, Mode=TwoWay}"/>
                        </StackPanel>
                        <StackPanel Spacing="12">
                            <TextBlock Text="Tool calling model" FontSize="14" FontWeight="SemiBold" Opacity="0.9"/>
                            <TextBox Text="{x:Bind VM.ToolCallingModel, Mode=TwoWay}"
                                     PlaceholderText="qwen2.5-coder:7b (or model name)"
                                     AutomationProperties.Name="Tool calling model name"/>
                        </StackPanel>
                        <StackPanel Spacing="12">
                            <TextBlock Text="Tool choice" FontSize="14" FontWeight="SemiBold" Opacity="0.9"/>
                            <ComboBox SelectedItem="{x:Bind VM.ToolChoice, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="Tool choice">
                                <x:String>auto</x:String>
                                <x:String>none</x:String>
                                <x:String>required</x:String>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Spacing="12">
                            <CheckBox Content="Show AI Tools panel in AI Assistant tab"
                                      IsChecked="{x:Bind VM.AiFeaturesPanelVisible, Mode=TwoWay}"/>
                        </StackPanel>
                        <!-- Test connection -->
                        <StackPanel Spacing="8">
                            <Button Content="Test Connection" Click="TestOllama_Click"
                                    HorizontalAlignment="Stretch" Padding="12"/>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                        Visibility="{x:Bind VM.OllamaTesting, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <ProgressRing IsActive="True" Width="16" Height="16"/>
                                <TextBlock Text="Testing..." FontSize="12" Opacity="0.8"/>
                            </StackPanel>
                             <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                         Visibility="{x:Bind VM.OllamaTesting, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}"> <FontIcon Glyph="&#xE73E;"
                                           Foreground="{x:Bind VM.OllamaTestBrush, Mode=OneWay}"
                                           FontSize="14"/>
                                 <TextBlock Text="{x:Bind VM.OllamaTestResult, Mode=OneWay}"
                                            FontSize="12"
                                            Foreground="{x:Bind VM.OllamaTestBrush, Mode=OneWay}"
                                            Opacity="0.9"/>
                             </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Smart Search -->
                <Border Style="{StaticResource DashboardCardBorder}" Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Smart Search (Semantic Indexing)" FontSize="18" FontWeight="SemiBold"/>
                        <StackPanel Spacing="12">
                            <CheckBox Content="Enable semantic indexing"
                                      IsChecked="{x:Bind VM.EmbeddingEnabled, Mode=TwoWay}"/>
                        </StackPanel>
                        <StackPanel Spacing="12">
                            <TextBlock Text="Embedding model" FontSize="14" FontWeight="SemiBold" Opacity="0.9"/>
                            <TextBox Text="{x:Bind VM.EmbeddingModel, Mode=TwoWay}"
                                     PlaceholderText="nomic-embed-text:latest"
                                     AutomationProperties.Name="Embedding model name"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Actions -->
                <Border Style="{StaticResource DashboardCardBorder}" Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Actions" FontSize="18" FontWeight="SemiBold"/>
                        <StackPanel Spacing="12">
                            <Button Content="Save Settings" Click="Save_Click"
                                    HorizontalAlignment="Stretch" Padding="12"/>
                            <Button Content="Reset to Defaults" Click="Reset_Click"
                                    HorizontalAlignment="Stretch" Padding="12"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>