<Page
    x:Class="SpaceAnalyzer.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SpaceAnalyzer.ViewModels"
    mc:Ignorable="d"
    NavigationCacheMode="Required"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="{StaticResource Thickness.XL}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="{StaticResource Space.XL}" MaxWidth="800" HorizontalAlignment="Center">

                <!-- Header -->
                <StackPanel Spacing="{StaticResource Space.XS}">
                    <TextBlock Text="Settings" Style="{StaticResource Type.PageTitle}"/>
                    <TextBlock Text="Configure application preferences and integrations."
                               Style="{StaticResource Type.Body}"/>
                </StackPanel>

                <!-- Advanced mode -->
                <Border Style="{StaticResource DashboardCardBorder}" Padding="{StaticResource Thickness.XL}">
                    <StackPanel Spacing="{StaticResource Space.SM}">
                        <ToggleSwitch Header="Advanced settings"
                                      IsOn="{x:Bind VM.AdvancedMode, Mode=TwoWay}"
                                      AutomationProperties.Name="Advanced settings"/>
                        <TextBlock Text="Show power-user options: hidden files, GPU acceleration, default scan paths, and the agentic-tool controls."
                                   Style="{StaticResource Type.Hint}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Appearance -->
                <Border Style="{StaticResource DashboardCardBorder}" Padding="{StaticResource Thickness.XL}">
                    <StackPanel Spacing="{StaticResource Space.LG}">
                        <TextBlock Text="Appearance" Style="{StaticResource Type.SectionTitle}"/>
                        <StackPanel Spacing="{StaticResource Space.MD}">
                            <ComboBox Header="Theme"
                                      SelectedItem="{x:Bind VM.Theme, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="Theme">
                                <x:String>Dark</x:String>
                                <x:String>Light</x:String>
                                <x:String>System</x:String>
                            </ComboBox>
                            <TextBlock Text="Theme changes take effect immediately. Some elements may refresh on next navigation."
                                       Style="{StaticResource Type.Hint}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Scanner -->
                <Border Style="{StaticResource DashboardCardBorder}" Padding="{StaticResource Thickness.XL}">
                    <StackPanel Spacing="{StaticResource Space.LG}">
                        <TextBlock Text="Scanner" Style="{StaticResource Type.SectionTitle}"/>
                        <StackPanel Spacing="{StaticResource Space.MD}">
                            <TextBlock Text="Scanner binary path" Style="{StaticResource Type.FieldHeading}"/>
                            <Grid ColumnSpacing="{StaticResource Space.SM}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                 <TextBox Grid.Column="0"
                                          Text="{x:Bind VM.ScannerPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          PlaceholderText="Select scanner binary..."
                                          AutomationProperties.Name="Scanner binary path"
                                          Style="{StaticResource FieldTextBox}"/>
                                <Button Grid.Column="1" Content="Browse" Click="Browse_Click" Style="{StaticResource SecondaryButton}" AutomationProperties.Name="Browse"/>
                                <Button Grid.Column="2" Content="Open Folder" Click="OpenScannerFolder_Click" Style="{StaticResource SecondaryButton}" AutomationProperties.Name="Open scanner folder"/>
                            </Grid>
                            <TextBlock Text="{x:Bind VM.ScannerPathStatus, Mode=OneWay}"
                                       Style="{StaticResource Type.Caption}"
                                       Foreground="{x:Bind VM.IsScannerPathValid, Mode=OneWay, Converter={StaticResource BoolToErrorBrush}}"
                                       Opacity="0.9"/>
                        </StackPanel>
                        <StackPanel Spacing="{StaticResource Space.SM}">
                            <TextBlock Text="App data folder" Style="{StaticResource Type.FieldHeading}"/>
                            <TextBlock Text="Stores the scan history database used by the app and the AI assistant."
                                        Style="{StaticResource Type.Caption}" TextWrapping="Wrap"/>
                            <Button Content="Open Data Folder" Click="OpenDataFolder_Click"
                                    HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}"
                                    AutomationProperties.Name="Open app data folder"/>
                        </StackPanel>
                        <StackPanel Spacing="{StaticResource Space.MD}">
                            <TextBlock Text="Default scan depth" Style="{StaticResource Type.FieldHeading}"/>
                            <Slider Minimum="1"
                                    Maximum="20"
                                    Value="{x:Bind VM.ScanDepth, Mode=TwoWay}"
                                    TickFrequency="4"
                                    Width="300"
                                    ToolTipService.ToolTip="Number of folder levels to descend when scanning (1–20)."/>
                            <TextBlock Text="{x:Bind VM.ScanDepth, Mode=OneWay}"
                                        Style="{StaticResource Type.Caption}"/>
                        </StackPanel>

                        <!-- Advanced scanner options -->
                        <StackPanel Spacing="{StaticResource Space.LG}"
                                    Visibility="{x:Bind VM.AdvancedMode, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Advanced scanner options" Style="{StaticResource Type.GroupHeading}"/>
                            <CheckBox Content="Include hidden files and folders by default"
                                      IsChecked="{x:Bind VM.IncludeHidden, Mode=TwoWay}" Style="{StaticResource FieldCheckBox}"/>
                            <CheckBox Content="GPU acceleration"
                                      IsChecked="{x:Bind VM.GpuAcceleration, Mode=TwoWay}" Style="{StaticResource FieldCheckBox}"/>
                            <StackPanel Spacing="{StaticResource Space.MD}">
                                <TextBlock Text="Default scan paths" Style="{StaticResource Type.FieldHeading}"/>
                                <TextBlock Text="Quick-access paths shown on the Scan page. One path per line."
                                           Style="{StaticResource Type.Hint}" TextWrapping="Wrap"/>
                                <TextBox Text="{x:Bind VM.DefaultScanPaths, Mode=TwoWay}"
                                         Height="80"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         AutomationProperties.Name="Default scan paths"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Ollama AI -->
                <Border Style="{StaticResource DashboardCardBorder}" Padding="{StaticResource Thickness.XL}">
                    <StackPanel Spacing="{StaticResource Space.LG}">
                        <TextBlock Text="Ollama AI" Style="{StaticResource Type.SectionTitle}"/>

                        <!-- Master switch -->
                        <StackPanel Spacing="{StaticResource Space.SM}">
                            <ToggleSwitch Header="Enable Ollama AI"
                                          IsOn="{x:Bind VM.OllamaEnabled, Mode=TwoWay}"
                                          AutomationProperties.Name="Enable Ollama AI"/>
                            <TextBlock Text="Turn on AI features (chat, analysis, and agentic tools). Requires a running Ollama server."
                                       Style="{StaticResource Type.Hint}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Connection -->
                        <ContentControl IsEnabled="{x:Bind VM.OllamaOptionsEnabled, Mode=OneWay}" HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="{StaticResource Space.MD}">
                            <TextBlock Text="Connection" Style="{StaticResource Type.GroupHeading}"/>
                            <StackPanel Spacing="{StaticResource Space.MD}">
                                <TextBlock Text="Server URL" Style="{StaticResource Type.FieldHeading}"/>
                                <TextBox Text="{x:Bind VM.OllamaUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="http://localhost:11434"
                                         AutomationProperties.Name="Ollama server URL"
                                         Style="{StaticResource FieldTextBox}"/>
                                <TextBlock Text="The address of your local Ollama server. The default works for a standard local install."
                                           Style="{StaticResource Type.Hint}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Spacing="{StaticResource Space.SM}">
                                <Button Content="Test Connection" Click="TestOllama_Click"
                                        HorizontalAlignment="Stretch" Style="{StaticResource SecondaryButton}"/>
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.SM}" VerticalAlignment="Center"
                                            Visibility="{x:Bind VM.OllamaTesting, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                    <ProgressRing IsActive="True" Width="16" Height="16"/>
                                    <TextBlock Text="Testing..." Style="{StaticResource Type.Caption}" Opacity="0.8"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.SM}" VerticalAlignment="Center"
                                            Visibility="{x:Bind VM.OllamaTesting, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
                                    <FontIcon Glyph="&#xE73E;"
                                              Foreground="{x:Bind VM.OllamaTestBrush, Mode=OneWay}"
                                              FontSize="{StaticResource Icon.Tiny}"/>
                                    <TextBlock Text="{x:Bind VM.OllamaTestResult, Mode=OneWay}"
                                               Style="{StaticResource Type.Caption}"
                                               Foreground="{x:Bind VM.OllamaTestBrush, Mode=OneWay}"
                                               Opacity="0.9"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Spacing="{StaticResource Space.SM}"
                                        Visibility="{x:Bind VM.HasDetectedModels, Mode=OneWay}">
                                <TextBlock Text="Installed models" Style="{StaticResource Type.FieldHeading}"/>
                                <ItemsControl ItemsSource="{x:Bind VM.DetectedModels, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ItemsWrapGrid Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Border Background="{ThemeResource AccentSurfaceBrush}"
                                                    CornerRadius="12"
                                                    Padding="10,4"
                                                    Margin="0,0,6,6">
                                                <TextBlock Text="{x:Bind}" Style="{StaticResource Type.Caption}"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{x:Bind VM.DetectedModelsSummary, Mode=OneWay}"
                                            Style="{StaticResource Type.Caption}"/>
                            </StackPanel>
                            </StackPanel>
                        </ContentControl>

                        <!-- Chat model -->
                        <ContentControl IsEnabled="{x:Bind VM.OllamaOptionsEnabled, Mode=OneWay}" HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="{StaticResource Space.MD}">
                            <TextBlock Text="Chat model" Style="{StaticResource Type.GroupHeading}"/>
                            <StackPanel Spacing="{StaticResource Space.MD}">
                                <TextBlock Text="Model" Style="{StaticResource Type.FieldHeading}"/>
                                <TextBox Text="{x:Bind VM.OllamaModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="gemma3:1b (or model name)"
                                         IsEnabled="{x:Bind VM.ManualModelEnabled, Mode=OneWay}"
                                         AutomationProperties.Name="Ollama model name"
                                         Style="{StaticResource FieldTextBox}"/>
                                <TextBlock Text="The model used for chat and analysis, e.g. gemma3:1b. Must be installed on the server."
                                           Style="{StaticResource Type.Hint}" TextWrapping="Wrap"/>
                                <TextBlock Text="Auto-select is on — the model above is ignored and a suitable installed model is chosen automatically."
                                           Style="{StaticResource Type.Hint}" TextWrapping="Wrap"
                                           Visibility="{x:Bind VM.AutoModelSelection, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>
                            <CheckBox Content="Auto-select model based on task"
                                       IsChecked="{x:Bind VM.AutoModelSelection, Mode=TwoWay}" Style="{StaticResource FieldCheckBox}"/>
                            </StackPanel>
                        </ContentControl>

                        <!-- Agentic tools (Advanced) -->
                        <ContentControl IsEnabled="{x:Bind VM.AgenticOptionsEnabled, Mode=OneWay}" HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="{StaticResource Space.MD}"
                                        Visibility="{x:Bind VM.AdvancedMode, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Agentic tools" Style="{StaticResource Type.GroupHeading}"/>
                            <TextBlock Text="Lets the assistant call tools (open files, run scans, query history) to answer questions."
                                       Style="{StaticResource Type.Hint}" TextWrapping="Wrap"/>
                            <CheckBox Content="Enable agentic tool calling"
                                      IsChecked="{x:Bind VM.AgenticToolsEnabled, Mode=TwoWay}" Style="{StaticResource FieldCheckBox}"/>
                            <CheckBox Content="Enable deep thinking / reasoning (Ollama 0.30+)"
                                      IsChecked="{x:Bind VM.OllamaThink, Mode=TwoWay}" Style="{StaticResource FieldCheckBox}"/>
                            <StackPanel Spacing="{StaticResource Space.MD}">
                                <TextBlock Text="Tool calling model" Style="{StaticResource Type.FieldHeading}"/>
                                <TextBox Text="{x:Bind VM.ToolCallingModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="qwen2.5-coder:7b (or model name)"
                                         AutomationProperties.Name="Tool calling model name"
                                         Style="{StaticResource FieldTextBox}"/>
                                <TextBlock Text="A coding-focused model used when the assistant calls tools. Usually larger than the chat model."
                                           Style="{StaticResource Type.Hint}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Spacing="{StaticResource Space.MD}">
                                <TextBlock Text="Tool choice" Style="{StaticResource Type.FieldHeading}"/>
                                <ComboBox SelectedItem="{x:Bind VM.ToolChoice, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch"
                                          AutomationProperties.Name="Tool choice">
                                    <x:String>auto</x:String>
                                    <x:String>none</x:String>
                                    <x:String>required</x:String>
                                </ComboBox>
                                <TextBlock Text="Whether the assistant may use tools: Auto (its choice), None (chat only), Required (must use a tool)."
                                            Style="{StaticResource Type.Hint}" TextWrapping="Wrap"/>
                            </StackPanel>
                            </StackPanel>
                        </ContentControl>
                    </StackPanel>
                </Border>

                <!-- Actions -->
                <Border Style="{StaticResource DashboardCardBorder}" Padding="{StaticResource Thickness.XL}">
                    <StackPanel Spacing="{StaticResource Space.LG}">
                        <TextBlock Text="Actions" Style="{StaticResource Type.SectionTitle}"/>
                        <StackPanel Spacing="{StaticResource Space.MD}">
                            <Button Content="Save Settings" Click="Save_Click"
                                    HorizontalAlignment="Stretch" Style="{StaticResource SecondaryButton}"/>
                            <Button Content="Reset to Defaults" Click="Reset_Click"
                                    HorizontalAlignment="Stretch" Style="{StaticResource SecondaryButton}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
