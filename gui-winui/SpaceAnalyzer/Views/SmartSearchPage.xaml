<Page
    x:Class="SpaceAnalyzer.Views.SmartSearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SpaceAnalyzer.ViewModels"
    xmlns:models="using:SpaceAnalyzer.Models"
    x:Name="Root"
    mc:Ignorable="d"
    NavigationCacheMode="Required"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="{StaticResource Thickness.XL}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="{StaticResource Space.XL}" MaxWidth="1000" HorizontalAlignment="Center">

                <!-- Header -->
                <StackPanel Spacing="{StaticResource Space.XS}">
                    <TextBlock Text="Smart Search" Style="{StaticResource Type.PageTitle}"/>
                    <TextBlock Text="Search for files and folders by name and size."
                               Style="{StaticResource Type.Body}"/>
                </StackPanel>

                <!-- Search Criteria -->
                <Border Style="{StaticResource DashboardCardBorder}" Padding="{StaticResource Thickness.XL}">
                    <StackPanel Spacing="{StaticResource Space.MD}">
                        <TextBlock Text="Search Path" Style="{StaticResource Type.SubTitle}"/>
                        <Grid ColumnSpacing="{StaticResource Space.SM}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                             <TextBox Grid.Column="0"
                                      Text="{x:Bind VM.SearchPath, Mode=TwoWay}"
                                      PlaceholderText="Select a directory to search..."
                                      AutomationProperties.Name="Search path"
                                      Style="{StaticResource FieldTextBox}"/>
                            <Button Grid.Column="1" Content="Browse" Click="Browse_Click" Style="{StaticResource SecondaryButton}" AutomationProperties.Name="Browse"/>
                            <Button Grid.Column="2" Content="Open" Click="OpenSearchPath_Click" Style="{StaticResource SecondaryButton}" AutomationProperties.Name="Open search path"/>
                        </Grid>

                        <StackPanel Spacing="{StaticResource Space.SM}" Margin="0,8,0,0">
                            <TextBlock Text="Search Query" Style="{StaticResource Type.SubTitle}"/>
                             <TextBox Text="{x:Bind VM.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="Enter a name or pattern, e.g. *log or report_*.pdf"
                                        AutomationProperties.Name="Search query"
                                        Style="{StaticResource FieldTextBox}"/>
                        </StackPanel>

                        <Grid Margin="0,8,0,0" ColumnSpacing="{StaticResource Space.XXL}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="{StaticResource Space.SM}">
                                <TextBlock Text="Min Size (MB)" Style="{StaticResource Type.FieldHeading}"/>
                                <TextBox Text="{x:Bind VM.MinSizeMb, Mode=TwoWay}"
                                         AutomationProperties.Name="Minimum file size in MB">
                                    <TextBox.InputScope>
                                        <InputScope>
                                            <InputScope.Names>
                                                <InputScopeName NameValue="Number"/>
                                            </InputScope.Names>
                                        </InputScope>
                                    </TextBox.InputScope>
                                </TextBox>
                                <TextBlock Text="Max Results" Style="{StaticResource Type.FieldHeading}" Margin="0,4,0,0"/>
                                <TextBox Text="{x:Bind VM.MaxResults, Mode=TwoWay}"
                                         AutomationProperties.Name="Maximum number of results to display">
                                    <TextBox.InputScope>
                                        <InputScope>
                                            <InputScope.Names>
                                                <InputScopeName NameValue="Number"/>
                                            </InputScope.Names>
                                        </InputScope>
                                    </TextBox.InputScope>
                                </TextBox>
                            </StackPanel>

                            <Border Grid.Column="1" Style="{StaticResource DashboardCardBorder}" Padding="{StaticResource Thickness.MD}">
                                <StackPanel Spacing="{StaticResource Space.SM}">
                                    <TextBlock Text="Filters" Style="{StaticResource Type.FieldHeading}"/>
                                    <CheckBox Content="Match exact name"
                                              IsChecked="{x:Bind VM.MatchExact, Mode=TwoWay}"
                                              Style="{StaticResource FieldCheckBox}"/>
                                    <CheckBox Content="Use wildcards (*)"
                                              IsChecked="{x:Bind VM.UseWildcards, Mode=TwoWay}"
                                              Style="{StaticResource FieldCheckBox}"/>
                                    <CheckBox Content="Include hidden files"
                                              IsChecked="{x:Bind VM.IncludeHidden, Mode=TwoWay}"
                                              Style="{StaticResource FieldCheckBox}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Results view options -->
                <Border Style="{StaticResource DashboardCardBorder}" Padding="{StaticResource Thickness.LG}">
                    <StackPanel Spacing="{StaticResource Space.MD}">
                        <TextBlock Text="Results view" Style="{StaticResource Type.SubTitle}"/>
                        <StackPanel Spacing="{StaticResource Space.XS}">
                            <TextBlock Text="Group results by" Style="{StaticResource Type.Caption}" Opacity="0.85"/>
                            <RadioButtons>
                                <RadioButton Content="None (flat list)"
                                             IsChecked="{x:Bind VM.GroupByMode, Mode=TwoWay, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=None}"/>
                                <RadioButton Content="Folder"
                                             IsChecked="{x:Bind VM.GroupByMode, Mode=TwoWay, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Folder}"/>
                                <RadioButton Content="Category"
                                             IsChecked="{x:Bind VM.GroupByMode, Mode=TwoWay, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Category}"/>
                                <RadioButton Content="Extension"
                                             IsChecked="{x:Bind VM.GroupByMode, Mode=TwoWay, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Extension}"/>
                                <RadioButton Content="Date"
                                             IsChecked="{x:Bind VM.GroupByMode, Mode=TwoWay, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Date}"/>
                                <RadioButton Content="Size"
                                             IsChecked="{x:Bind VM.GroupByMode, Mode=TwoWay, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Size}"/>
                            </RadioButtons>
                        </StackPanel>

                        <!-- Advanced toggle + power-user options -->
                        <ToggleSwitch Header="Advanced options"
                                      IsOn="{x:Bind VM.IsAdvancedMode, Mode=TwoWay}"
                                      OffContent="Show power-user controls"
                                      OnContent="Power-user controls"/>

                        <Border Visibility="{x:Bind VM.IsAdvancedMode, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                Style="{StaticResource DashboardCardBorder}" Padding="{StaticResource Thickness.MD}">
                            <StackPanel Spacing="{StaticResource Space.MD}">
                                <StackPanel Spacing="{StaticResource Space.XS}">
                                    <TextBlock Text="Sort by" Style="{StaticResource Type.FieldHeading}"/>
                                    <RadioButtons>
                                        <RadioButton Content="Name"
                                                     IsChecked="{x:Bind VM.SortBy, Mode=TwoWay, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Name}"/>
                                        <RadioButton Content="Size"
                                                     IsChecked="{x:Bind VM.SortBy, Mode=TwoWay, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Size}"/>
                                        <RadioButton Content="Date modified"
                                                     IsChecked="{x:Bind VM.SortBy, Mode=TwoWay, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Date}"/>
                                        <RadioButton Content="Full path"
                                                     IsChecked="{x:Bind VM.SortBy, Mode=TwoWay, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Path}"/>
                                        <RadioButton Content="Extension"
                                                     IsChecked="{x:Bind VM.SortBy, Mode=TwoWay, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Extension}"/>
                                    </RadioButtons>
                                </StackPanel>

                                <CheckBox Content="Show raw byte counts"
                                          IsChecked="{x:Bind VM.ShowRawBytes, Mode=TwoWay}"
                                          Style="{StaticResource FieldCheckBox}"/>
                                <CheckBox Content="Compact density (tighter rows)"
                                          IsChecked="{x:Bind VM.IsCompactDensity, Mode=TwoWay}"
                                          Style="{StaticResource FieldCheckBox}"/>
                                <CheckBox Content="Follow symlinks / junctions"
                                          IsChecked="{x:Bind VM.FollowSymlinks, Mode=TwoWay}"
                                          Style="{StaticResource FieldCheckBox}"/>
                                <CheckBox Content="Collapse small groups into 'Other'"
                                          IsChecked="{x:Bind VM.CollapseSmallGroups, Mode=TwoWay}"
                                          Style="{StaticResource FieldCheckBox}"/>
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.SM}" Visibility="{x:Bind VM.CollapseSmallGroups, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Other threshold (MB)" Style="{StaticResource Type.Caption}" Opacity="0.8" VerticalAlignment="Center"/>
                                    <TextBox Text="{x:Bind VM.OtherThresholdMb, Mode=TwoWay}" Width="100" AutomationProperties.Name="Other threshold in MB">
                                        <TextBox.InputScope>
                                            <InputScope>
                                                <InputScope.Names>
                                                    <InputScopeName NameValue="Number"/>
                                                </InputScope.Names>
                                            </InputScope>
                                        </TextBox.InputScope>
                                    </TextBox>
                                </StackPanel>

                                <Grid ColumnSpacing="{StaticResource Space.SM}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Export the current results as raw JSON." Style="{StaticResource Type.Hint}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="Copy results JSON" Click="ExportJson_Click" Style="{StaticResource SecondaryButton}" AutomationProperties.Name="Copy results as JSON"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Tips -->
                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8"
                        Padding="{StaticResource Thickness.LG}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.MD}">
                        <FontIcon Glyph="&#xE946;" FontSize="{StaticResource Icon.Small}"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Top"/>
                        <StackPanel Spacing="{StaticResource Space.XS}">
                            <TextBlock Text="Tips" Style="{StaticResource Type.SubTitle}"/>
                            <TextBlock Text="Use * as a wildcard (e.g. *.log or report_*_2024.pdf). Leave Min Size at 0 to find all matches. Group and Advanced options persist across sessions." Style="{StaticResource Type.Hint}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Search mode + semantic index -->
                <Border Style="{StaticResource DashboardCardBorder}" Padding="{StaticResource Thickness.LG}">
                    <StackPanel Spacing="{StaticResource Space.MD}">
                        <Grid ColumnSpacing="{StaticResource Space.MD}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="{StaticResource Space.XS}">
                                <TextBlock Text="Semantic search" Style="{StaticResource Type.SubTitle}"/>
                                <TextBlock Text="Find files by meaning, not just their name (uses AI embeddings)." Style="{StaticResource Type.Hint}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind VM.IsSemantic, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Visibility="{x:Bind VM.IsSemantic, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" Spacing="{StaticResource Space.SM}">
                            <StackPanel Spacing="{StaticResource Space.XS}">
                                <TextBlock Text="{x:Bind VM.MinScorePercentLabel, Mode=OneWay}" Style="{StaticResource Type.Caption}" Opacity="0.85"/>
                                <Slider Minimum="0" Maximum="100" StepFrequency="1"
                                        Value="{x:Bind VM.MinScorePercent, Mode=TwoWay}"
                                        AutomationProperties.Name="Minimum similarity percentage"/>
                                <TextBlock Text="Drop matches below this similarity. Set to 0 to disable the floor (show all)."
                                           Style="{StaticResource Type.Hint}" TextWrapping="Wrap" Opacity="0.7"/>
                            </StackPanel>
                            <StackPanel Spacing="{StaticResource Space.XS}" Visibility="{x:Bind VM.IsAdvancedMode, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Semantic top results (K)" Style="{StaticResource Type.Caption}" Opacity="0.85"/>
                                <TextBox Text="{x:Bind VM.SemanticTopK, Mode=TwoWay}" Width="120" AutomationProperties.Name="Semantic top K">
                                    <TextBox.InputScope>
                                        <InputScope>
                                            <InputScope.Names>
                                                <InputScopeName NameValue="Number"/>
                                            </InputScope.Names>
                                        </InputScope>
                                    </TextBox.InputScope>
                                </TextBox>
                            </StackPanel>
                            <Grid ColumnSpacing="{StaticResource Space.SM}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind VM.IndexStatus, Mode=OneWay}" Style="{StaticResource Type.Hint}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="Index with embeddings" Click="Index_Click" Style="{StaticResource SecondaryButton}" IsEnabled="{x:Bind VM.IsNotIndexing, Mode=OneWay}" AutomationProperties.Name="Index folder with embeddings"/>
                            </Grid>
                            <ProgressRing Width="18" Height="18" IsActive="{x:Bind VM.IsIndexing, Mode=OneWay}" Visibility="{x:Bind VM.IsIndexing, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Search Button -->
                <Button Content="Start Search" Click="Search_Click"
                        AutomationProperties.Name="Start Search"
                        HorizontalAlignment="Stretch" Style="{StaticResource SecondaryButton}"
                        VerticalContentAlignment="Center"
                        IsEnabled="{x:Bind VM.CanStartSearch, Mode=OneWay}"
                        ToolTipService.ToolTip="Enter a search path and query, then start the search."/>

                <!-- Status -->
                <TextBlock Text="{x:Bind VM.StatusMessage, Mode=OneWay}"
                           Style="{StaticResource Type.Body}"/>

                <!-- Show all / Load more -->
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.SM}"
                            Visibility="{x:Bind VM.HasMore, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <Button Content="Show all" Click="ShowAll_Click" Style="{StaticResource SecondaryButton}" AutomationProperties.Name="Show all results"/>
                    <Button Content="Load more" Click="LoadMore_Click" Style="{StaticResource SecondaryButton}" AutomationProperties.Name="Load more results"/>
                    <TextBlock Text="{x:Bind VM.ResultCount, Mode=OneWay}" Style="{StaticResource Type.Caption}" Opacity="0.8" VerticalAlignment="Center"/>
                    <TextBlock Text="total matches" Style="{StaticResource Type.Caption}" Opacity="0.8" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Results (flat list) -->
                <Border Style="{StaticResource AnimatedCard}" Padding="{StaticResource Thickness.XL}"
                        Visibility="{x:Bind VM.ShowFlatResults, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                    <StackPanel Spacing="{StaticResource Space.MD}">
                        <TextBlock Text="{x:Bind VM.ShownCount, Mode=OneWay}" Style="{StaticResource Type.CardTitle}"/>
                        <TextBlock Text="results shown" Style="{StaticResource Type.Body}" Opacity="0.8"/>

                        <ItemsRepeater ItemsSource="{x:Bind VM.DisplayResults, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="{x:Bind VM.DensityItemSpacing, Mode=OneWay}"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:SmartSearchResult">
                                    <Border Style="{StaticResource CompactItemCard}" Padding="{Binding ElementName=Root, Path=VM.DensityCardPadding, Mode=OneWay}">
                                        <Border.Transitions>
                                            <TransitionCollection>
                                                <EntranceThemeTransition/>
                                            </TransitionCollection>
                                        </Border.Transitions>
                                        <StackPanel Spacing="{Binding ElementName=Root, Path=VM.DensityItemSpacing, Mode=OneWay}">
                                            <TextBlock Style="{StaticResource Type.SubTitle}"
                                                       Text="{x:Bind Name, Mode=OneTime}" TextTrimming="CharacterEllipsis"/>
                                            <ProgressBar Value="{x:Bind SizeFraction, Mode=OneTime}" Maximum="1"
                                                         Height="4" Background="Transparent"
                                                         Foreground="{x:Bind BarBrush, Mode=OneTime}"/>
                                            <TextBlock Style="{StaticResource Type.Caption}" Opacity="0.8">
                                                <Run Text="{x:Bind SizeDisplay, Mode=OneTime}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{x:Bind Path, Mode=OneTime}" FontStyle="Italic"/>
                                            </TextBlock>
                                            <TextBlock Visibility="{Binding ElementName=Root, Path=VM.ShowRawBytes, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                                       Style="{StaticResource Type.Tiny}" Opacity="0.6">
                                                <Run Text="{x:Bind SizeRaw, Mode=OneTime}"/><Run Text=" bytes"/>
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource Type.Tiny}" Opacity="0.6"
                                                       Text="{x:Bind ModifiedDisplay, Mode=OneTime}"/>
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.SM}" Margin="0,4,0,0">
                                                <Button Content="Open" Click="OpenResultFile_Click" Style="{StaticResource SmallButton}" Tag="{x:Bind Path}"/>
                                                <Button Content="Folder" Click="OpenResultFolder_Click" Style="{StaticResource SmallButton}" Tag="{x:Bind Path}"/>
                                                <Button Content="Copy" Click="CopyPath_Click" Style="{StaticResource SmallButton}" Tag="{x:Bind Path}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>

                <!-- Results (grouped by chosen dimension) -->
                <Border Style="{StaticResource AnimatedCard}" Padding="{StaticResource Thickness.XL}"
                        Visibility="{x:Bind VM.ShowGroupedResults, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                    <StackPanel Spacing="{StaticResource Space.MD}">
                        <TextBlock Text="{x:Bind VM.ShownCount, Mode=OneWay}" Style="{StaticResource Type.CardTitle}"/>
                        <TextBlock Text="results shown, grouped" Style="{StaticResource Type.Body}" Opacity="0.8"/>

                        <ItemsRepeater ItemsSource="{x:Bind VM.GroupedResults, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="{x:Bind VM.DensityItemSpacing, Mode=OneWay}"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:SearchResultGroup">
                                    <Border Style="{StaticResource CompactItemCard}" Padding="{Binding ElementName=Root, Path=VM.DensityCardPadding, Mode=OneWay}">
                                        <StackPanel Spacing="{Binding ElementName=Root, Path=VM.DensityItemSpacing, Mode=OneWay}">
                                            <Grid ColumnSpacing="{StaticResource Space.SM}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Content="{x:Bind IsExpanded, Mode=OneWay, Converter={StaticResource BoolToChevron}}"
                                                        Click="ToggleGroup_Click" Tag="{x:Bind Key}" Style="{StaticResource SmallButton}" AutomationProperties.Name="Toggle group"/>
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock Style="{StaticResource Type.SubTitle}"
                                                               Text="{x:Bind Label, Mode=OneTime}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Style="{StaticResource Type.Tiny}" Opacity="0.7">
                                                        <Run Text="{x:Bind Count, Mode=OneTime}"/><Run Text=" file(s) · "/><Run Text="{x:Bind TotalDisplay, Mode=OneTime}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <Button Grid.Column="2" Content="Search here"
                                                        Click="DrillIntoGroup_Click" Tag="{x:Bind Key}"
                                                        Style="{StaticResource SmallButton}"
                                                        Visibility="{x:Bind CanDrill, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                                        AutomationProperties.Name="Search within group"/>
                                            </Grid>
                                            <ItemsRepeater ItemsSource="{x:Bind Items, Mode=OneTime}"
                                                           Visibility="{x:Bind IsExpanded, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                                <ItemsRepeater.Layout>
                                                    <StackLayout Orientation="Vertical" Spacing="{Binding ElementName=Root, Path=VM.DensityItemSpacing, Mode=OneWay}"/>
                                                </ItemsRepeater.Layout>
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate x:DataType="models:SmartSearchResult">
                                                        <Border Style="{StaticResource CompactItemCard}" Padding="{Binding ElementName=Root, Path=VM.DensityCardPadding, Mode=OneWay}">
                                                            <StackPanel Spacing="{Binding ElementName=Root, Path=VM.DensityItemSpacing, Mode=OneWay}">
                                                                <TextBlock Style="{StaticResource Type.SubTitle}"
                                                                           Text="{x:Bind Name, Mode=OneTime}" TextTrimming="CharacterEllipsis"/>
                                                                <ProgressBar Value="{x:Bind SizeFraction, Mode=OneTime}" Maximum="1"
                                                                             Height="4" Background="Transparent"
                                                                             Foreground="{x:Bind BarBrush, Mode=OneTime}"/>
                                                                <TextBlock Style="{StaticResource Type.Caption}" Opacity="0.8">
                                                                    <Run Text="{x:Bind SizeDisplay, Mode=OneTime}"/>
                                                                    <Run Text=" · "/>
                                                                    <Run Text="{x:Bind Path, Mode=OneTime}" FontStyle="Italic"/>
                                                                </TextBlock>
                                                                <TextBlock Visibility="{Binding ElementName=Root, Path=VM.ShowRawBytes, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                                                           Style="{StaticResource Type.Tiny}" Opacity="0.6">
                                                                    <Run Text="{x:Bind SizeRaw, Mode=OneTime}"/><Run Text=" bytes"/>
                                                                </TextBlock>
                                                                <TextBlock Style="{StaticResource Type.Tiny}" Opacity="0.6"
                                                                           Text="{x:Bind ModifiedDisplay, Mode=OneTime}"/>
                                                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.SM}" Margin="0,4,0,0">
                                                                    <Button Content="Open" Click="OpenResultFile_Click" Style="{StaticResource SmallButton}" Tag="{x:Bind Path}"/>
                                                                    <Button Content="Folder" Click="OpenResultFolder_Click" Style="{StaticResource SmallButton}" Tag="{x:Bind Path}"/>
                                                                    <Button Content="Copy" Click="CopyPath_Click" Style="{StaticResource SmallButton}" Tag="{x:Bind Path}"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>

                <!-- Semantic Results -->
                <Border Style="{StaticResource AnimatedCard}" Padding="{StaticResource Thickness.XL}"
                        Visibility="{x:Bind VM.ShowSemanticResults, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                    <StackPanel Spacing="{StaticResource Space.MD}">
                        <TextBlock Text="{x:Bind VM.SemanticResultCount, Mode=OneWay}" Style="{StaticResource Type.CardTitle}"/>
                        <TextBlock Text="semantic matches" Style="{StaticResource Type.Body}" Opacity="0.8"/>
                        <ItemsRepeater ItemsSource="{x:Bind VM.SemanticResults, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="{StaticResource Space.SM}"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:SemanticSearchResult">
                                    <Border Style="{StaticResource CompactItemCard}">
                                        <StackPanel Spacing="{StaticResource Space.XS}">
                                            <TextBlock Style="{StaticResource Type.SubTitle}"
                                                       Text="{x:Bind Name, Mode=OneTime}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Style="{StaticResource Type.Caption}" Opacity="0.8">
                                                <Run Text="{x:Bind SimilarityDisplay, Mode=OneTime}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{x:Bind SizeDisplay, Mode=OneTime}"/>
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource Type.Tiny}" Opacity="0.55" TextWrapping="Wrap"
                                                       Text="{x:Bind FilePath, Mode=OneTime}"/>
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.SM}" Margin="0,4,0,0">
                                                <Button Content="Open" Click="OpenResultFile_Click" Style="{StaticResource SmallButton}" Tag="{x:Bind FilePath}"/>
                                                <Button Content="Folder" Click="OpenResultFolder_Click" Style="{StaticResource SmallButton}" Tag="{x:Bind FilePath}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>

                <!-- Empty State -->
                <Border Style="{StaticResource EmptyStateCard}" Visibility="{x:Bind VM.ShowFilenameEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Spacing="{StaticResource Space.MD}" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE721;" FontSize="{StaticResource Icon.EmptyState}" Opacity="{StaticResource Icon.EmptyStateOpacity}" HorizontalAlignment="Center"/>
                        <TextBlock Text="No results yet" Style="{StaticResource Type.CardTitle}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{x:Bind VM.SearchEmptyHint, Mode=OneWay}" Style="{StaticResource Type.Body}" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
