<Page
    x:Class="SpaceAnalyzer.Views.SmartSearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SpaceAnalyzer.ViewModels"
    xmlns:models="using:SpaceAnalyzer.Models"
    mc:Ignorable="d"
    NavigationCacheMode="Required"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.DataContext>
        <vm:SmartSearchViewModel x:Name="VM"/>
    </Page.DataContext>

    <Grid Padding="24">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="24" MaxWidth="1000" HorizontalAlignment="Center">

                <!-- Header -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Smart Search" FontSize="28" FontWeight="Bold"/>
                    <TextBlock Text="Search for files and folders by name and size."
                               FontSize="14" Opacity="0.8"/>
                </StackPanel>

                <!-- Search Criteria -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Search Path" FontSize="14" FontWeight="SemiBold"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{x:Bind VM.SearchPath, Mode=TwoWay}"
                                     PlaceholderText="Select a directory to search..."
                                     AutomationProperties.Name="Search path"/>
                            <Button Grid.Column="1" Content="Browse" Click="Browse_Click" Padding="12,8" AutomationProperties.Name="Browse"/>
                        </Grid>

                        <StackPanel Spacing="8" Margin="0,8,0,0">
                            <TextBlock Text="Search Query" FontSize="14" FontWeight="SemiBold"/>
                            <TextBox Text="{x:Bind VM.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="Enter file/folder name to search for..."
                                     AutomationProperties.Name="Search query"/>
                        </StackPanel>

                        <Grid Margin="0,8,0,0" ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="8">
                                <TextBlock Text="Min Size (MB)" FontSize="12" Opacity="0.8"/>
                                <TextBox Text="{x:Bind VM.MinSizeMb, Mode=TwoWay}"
                                         AutomationProperties.Name="Minimum file size in MB">
                                    <TextBox.InputScope>
                                        <InputScope>
                                            <InputScope.Names>
                                                <InputScopeName NameValue="Number"/>
                                            </InputScope.Names>
                                        </InputScope>
                                    </TextBox.InputScope>
                                </TextBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="8">
                                <CheckBox Content="Match exact name"
                                          IsChecked="{x:Bind VM.MatchExact, Mode=TwoWay}"
                                          FontSize="12"/>
                                <CheckBox Content="Include hidden files"
                                          IsChecked="{x:Bind VM.IncludeHidden, Mode=TwoWay}"
                                          FontSize="12"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Search Button -->
                <Button Content="Start Search" Click="Search_Click"
                        AutomationProperties.Name="Start Search"
                        HorizontalAlignment="Stretch" Padding="16"
                        IsEnabled="{x:Bind VM.IsNotSearching, Mode=OneWay}"/>

                <!-- Status -->
                <TextBlock Text="{x:Bind VM.StatusMessage, Mode=OneWay}"
                           FontSize="14" Opacity="0.8"/>

                <!-- Results -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="20"
                        Visibility="{x:Bind VM.HasResults, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"> <StackPanel Spacing="12">
                         <TextBlock Text="{x:Bind VM.ResultCount, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="results found" FontSize="14" Opacity="0.8"/>

                        <ItemsRepeater ItemsSource="{x:Bind VM.Results, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="8"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:SmartSearchResult">
                                    <Border Padding="12" CornerRadius="6"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1">
                                        <StackPanel Spacing="4">
                                            <TextBlock FontSize="13" FontWeight="SemiBold"
                                                       Text="{x:Bind Name, Mode=OneTime}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock FontSize="12" Opacity="0.8">
                                                <Run Text="{x:Bind SizeDisplay, Mode=OneTime}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{x:Bind Path, Mode=OneTime}" FontStyle="Italic"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
