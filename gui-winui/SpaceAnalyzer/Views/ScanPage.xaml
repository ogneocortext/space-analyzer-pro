<Page
    x:Class="SpaceAnalyzer.Views.ScanPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SpaceAnalyzer.ViewModels"
    xmlns:models="using:SpaceAnalyzer.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="{StaticResource Thickness.XL}"
          AllowDrop="True"
          DragOver="Page_DragOver"
          Drop="Page_Drop">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="{StaticResource Space.XL}" MaxWidth="1000" HorizontalAlignment="Center">

                <!-- Header -->
                <StackPanel Spacing="{StaticResource Space.SM}">
                    <TextBlock Text="New Scan" Style="{StaticResource Type.PageTitle}" />
                    <TextBlock Text="Select a directory and choose a scan depth to analyze disk usage." Style="{StaticResource Type.Body}" />
                </StackPanel>

                <!-- Input Row: Path + Depth side by side -->
                <Grid ColumnSpacing="{StaticResource Space.LG}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Path Selection -->
                    <Border Grid.Column="0" Style="{StaticResource DashboardCardBorder}" Padding="{StaticResource Thickness.LG}">
                        <StackPanel Spacing="{StaticResource Space.MD}">
                            <TextBlock Text="Directory" Style="{StaticResource Type.SubTitle}" />
                            <Grid ColumnSpacing="{StaticResource Space.SM}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                 <TextBox Grid.Column="0" Text="{x:Bind VM.ScanPath, Mode=TwoWay}" PlaceholderText="Select a directory..." AutomationProperties.Name="Scan directory path" Style="{StaticResource FieldTextBox}" />
                                <Button Grid.Column="1" Content="Browse" Click="Browse_Click" Style="{StaticResource SecondaryButton}" AutomationProperties.Name="Browse"/>
                            </Grid>
                            <TextBlock Text="{x:Bind VM.PathValidationMessage, Mode=OneWay}"
                                       Style="{StaticResource Type.Caption}"
                                       Foreground="{x:Bind VM.PathExists, Mode=OneWay, Converter={StaticResource BoolToErrorBrush}}"
                                       Visibility="{x:Bind VM.PathExists, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}"/>
                        </StackPanel>
                    </Border>

                    <!-- Scan Depth -->
                    <Border Grid.Column="1" Style="{StaticResource DashboardCardBorder}" Padding="{StaticResource Thickness.LG}">
                        <StackPanel Spacing="{StaticResource Space.MD}">
                            <TextBlock Text="Scan Depth" Style="{StaticResource Type.SubTitle}" />
                            <TextBlock Text="How deep to scan." Style="{StaticResource Type.Hint}" />
                            <StackPanel Spacing="{StaticResource Space.MD}">
                                <RadioButton GroupName="ScanDepth" Tag="Quick" Padding="10,6"
                                             IsChecked="{x:Bind VM.ShallowScan, Mode=OneWay}" Click="DepthRadio_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.SM}" VerticalAlignment="Center">
                                        <TextBlock Text="Quick" Style="{StaticResource Type.FieldHeading}"/>
                                        <TextBlock Text="depth 1" Style="{StaticResource Type.Tiny}" Opacity="0.7"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton GroupName="ScanDepth" Tag="Default" Padding="10,6"
                                             IsChecked="{x:Bind VM.DefaultScan, Mode=OneWay}" Click="DepthRadio_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.SM}" VerticalAlignment="Center">
                                        <TextBlock Text="Default" Style="{StaticResource Type.FieldHeading}"/>
                                        <TextBlock Text="depth 5" Style="{StaticResource Type.Tiny}" Opacity="0.7"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton GroupName="ScanDepth" Tag="Deep" Padding="10,6"
                                             IsChecked="{x:Bind VM.DeepScan, Mode=OneWay}" Click="DepthRadio_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.SM}" VerticalAlignment="Center">
                                        <TextBlock Text="Deep" Style="{StaticResource Type.FieldHeading}"/>
                                        <TextBlock Text="unlimited" Style="{StaticResource Type.Tiny}" Opacity="0.7"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton GroupName="ScanDepth" Tag="Custom" Padding="10,6"
                                             IsChecked="{x:Bind VM.CustomScan, Mode=OneWay}" Click="DepthRadio_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.SM}" VerticalAlignment="Center">
                                        <TextBlock Text="Custom" Style="{StaticResource Type.FieldHeading}"/>
                                        <TextBlock Text="1-20 levels" Style="{StaticResource Type.Tiny}" Opacity="0.7"/>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                            <Slider Header="Custom depth" Minimum="1" Maximum="20" TickFrequency="1"
                                    Value="{x:Bind VM.DepthValue, Mode=TwoWay}"
                                    Visibility="{x:Bind VM.ShowCustomDepthSlider, Mode=OneWay}"
                                    ToolTipService.ToolTip="Number of folder levels to descend when scanning (1–20)."/>
                            <TextBlock Text="{x:Bind VM.ResultDepthDisplay, Mode=OneWay}" Style="{StaticResource Type.Caption}" Opacity="0.7"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Scan Controls Bar -->
                <Border Style="{StaticResource DashboardCardBorder}" Padding="{StaticResource Thickness.MD}">
                    <Grid ColumnSpacing="{StaticResource Space.MD}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="{x:Bind VM.IsScanning, Mode=OneWay, Converter={StaticResource BoolToScanButtonText}}"
                                Click="Scan_Click" AutomationProperties.Name="Start Scan"
                                Style="{StaticResource PrimaryButton}"/>
                        <Button Grid.Column="1" Content="Stop" Click="Scan_Click"
                                AutomationProperties.Name="Stop Scan"
                                Style="{StaticResource PrimaryButton}"
                                IsEnabled="{x:Bind VM.CanStopScan, Mode=OneWay}"/>
                        <Button Grid.Column="2" Content="Export" Click="Export_Click"
                                AutomationProperties.Name="Export Results"
                                Style="{StaticResource SecondaryButton}"
                                IsEnabled="{x:Bind VM.HasResult, Mode=OneWay}"/>
                        <ComboBox Grid.Column="3" Width="70" SelectedItem="{x:Bind VM.ExportFormat, Mode=TwoWay}"
                                  ItemsSource="{x:Bind VM.ExportFormats, Mode=OneWay}"
                                  VerticalAlignment="Center"
                                  AutomationProperties.Name="Export format"/>
                        <TextBlock Grid.Column="4" Text="{x:Bind VM.StatusMessage, Mode=OneWay}"
                                   Style="{StaticResource Type.Caption}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Opacity="0.7"/>
                        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="{StaticResource Space.MD}" VerticalAlignment="Center">
                            <Border Width="1" Margin="0,2,0,2" Background="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.5"/>
                            <CheckBox Content="Hidden files" IsChecked="{x:Bind VM.IncludeHidden, Mode=TwoWay}"
                                      Style="{StaticResource FieldCheckBox}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Hidden files helper -->
                <TextBlock Text="Hidden and system files (e.g. AppData) are skipped unless this is enabled."
                           Style="{StaticResource Type.Caption}" Opacity="0.7"/>

                <!-- Progress -->
                <StackPanel Spacing="{StaticResource Space.XS}" Visibility="{x:Bind VM.IsScanningVisibility, Mode=OneWay}">
                    <ProgressBar Value="{x:Bind VM.ScanProgress, Mode=OneWay}" Maximum="100" Style="{StaticResource MinimalProgressBar}"/>
                    <TextBlock Text="{x:Bind VM.LiveFilesDisplay, Mode=OneWay}" Style="{StaticResource Type.Caption}" Opacity="0.6"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.SM}"
                            Visibility="{x:Bind VM.IsNotScanningVisibility, Mode=OneWay}">
                    <FontIcon Glyph="&#xE768;" FontSize="{StaticResource Icon.Small}"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{x:Bind VM.StatusMessage, Mode=OneWay}" Style="{StaticResource Type.Body}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Scan Errors -->
                <Border Style="{StaticResource DashboardCardBorder}" Padding="{StaticResource Thickness.LG}" Visibility="{x:Bind VM.HasScanErrors, Mode=OneWay}">
                    <StackPanel Spacing="{StaticResource Space.SM}">
                        <TextBlock Text="Scan Errors" Style="{StaticResource Type.SubTitle}" Foreground="{ThemeResource ErrorTextBrush}"/>
                        <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                            <ItemsRepeater ItemsSource="{x:Bind VM.ScanErrors, Mode=OneWay}">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource Type.Caption}" Foreground="{ThemeResource ErrorTextBrush}" TextWrapping="WrapWholeWords" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- Empty Directories -->
                <Border Style="{StaticResource DashboardCardBorder}" Padding="{StaticResource Thickness.LG}" Visibility="{x:Bind VM.HasEmptyDirs, Mode=OneWay}">
                    <StackPanel Spacing="{StaticResource Space.SM}">
                        <TextBlock Text="Empty Directories" Style="{StaticResource Type.SubTitle}" Foreground="{ThemeResource WarningTextBrush}"/>
                        <TextBlock Text="{x:Bind VM.EmptyDirsCount, Mode=OneWay}" Style="{StaticResource Type.Caption}" Opacity="0.7"/>
                        <TextBlock Text="empty directories" Style="{StaticResource Type.Caption}" Opacity="0.5" Margin="0,-4,0,0"/>
                        <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto">
                            <ItemsRepeater ItemsSource="{x:Bind VM.EmptyDirs, Mode=OneWay}">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource Type.Caption}" FontFamily="Consolas" Opacity="0.8" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- Results -->
                <Border Style="{StaticResource AnimatedCard}" Padding="{StaticResource Thickness.LG}" Visibility="{x:Bind VM.HasActiveResultVisibility, Mode=OneWay}">
                    <StackPanel Spacing="{StaticResource Space.MD}">
                        <TextBlock Text="Scan Results" Style="{StaticResource Type.CardTitle}" />
                        <!-- Summary Strip -->
                        <Grid ColumnSpacing="{StaticResource Space.LG}" Visibility="{x:Bind VM.HasResult, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="{StaticResource Space.XS}">
                                <TextBlock Text="{x:Bind VM.ResultFilesDisplay, Mode=OneWay}" Style="{StaticResource Type.StatValue}"/>
                                <TextBlock Text="Files" Style="{StaticResource Type.StatLabel}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="{StaticResource Space.XS}">
                                <TextBlock Text="{x:Bind VM.ResultSizeDisplay, Mode=OneWay}" Style="{StaticResource Type.StatValue}"/>
                                <TextBlock Text="Total Size" Style="{StaticResource Type.StatLabel}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="{StaticResource Space.XS}">
                                <TextBlock Text="{x:Bind VM.ResultDirsDisplay, Mode=OneWay}" Style="{StaticResource Type.StatValue}"/>
                                <TextBlock Text="Directories" Style="{StaticResource Type.StatLabel}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Spacing="{StaticResource Space.XS}">
                                <TextBlock Text="{x:Bind VM.ResultAvgFileSizeDisplay, Mode=OneWay}" Style="{StaticResource Type.StatValue}"/>
                                <TextBlock Text="Avg File Size" Style="{StaticResource Type.StatLabel}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4" Spacing="{StaticResource Space.XS}">
                                <TextBlock Text="{x:Bind VM.ResultSpeedDisplay, Mode=OneWay}" Style="{StaticResource Type.StatValue}"/>
                                <TextBlock Text="Speed" Style="{StaticResource Type.StatLabel}"/>
                                <TextBlock Text="{x:Bind VM.ResultSpeedMbDisplay, Mode=OneWay}" Style="{StaticResource Type.Caption}" Opacity="0.7"/>
                            </StackPanel>
                            <StackPanel Grid.Column="5" Spacing="{StaticResource Space.XS}">
                                <TextBlock Text="{x:Bind VM.ResultDurationDisplay, Mode=OneWay}" Style="{StaticResource Type.StatValue}"/>
                                <TextBlock Text="Duration" Style="{StaticResource Type.StatLabel}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="6" Spacing="{StaticResource Space.XS}"
                                        Visibility="{x:Bind VM.HasPotentialCleanup, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{x:Bind VM.PotentialCleanupDisplay, Mode=OneWay}"
                                           Style="{StaticResource Type.StatValue}" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                                <TextBlock Text="Reclaimable" Style="{StaticResource Type.StatLabel}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Distribution -->
                        <Border Style="{StaticResource DashboardCardBorder}" Padding="{StaticResource Thickness.SM}">
                            <StackPanel Spacing="{StaticResource Space.XS}">
                                <TextBlock Text="Distribution" Style="{StaticResource Type.CardTitle}"/>
                                <TextBlock Text="File Types" Style="{StaticResource Type.SubTitle}" Margin="0,4,0,0"/>
                                <ItemsRepeater ItemsSource="{x:Bind VM.FileTypes, Mode=OneWay}">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="models:FileTypeDistribution">
                                            <Grid ColumnSpacing="{StaticResource Space.SM}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{x:Bind Extension, Mode=OneTime}" Style="{StaticResource Type.Caption}" FontFamily="Consolas" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                                <ProgressBar Grid.Column="1" Value="{x:Bind Percentage, Mode=OneTime}" Maximum="100" Style="{StaticResource MinimalProgressBar}" Margin="8,0"/>
                                                <TextBlock Grid.Column="2" Text="{x:Bind CountDisplay, Mode=OneTime}" Style="{StaticResource Type.Caption}"/>
                                                <TextBlock Grid.Column="3" Text="{x:Bind SizeDisplay, Mode=OneTime}" Style="{StaticResource Type.Caption}" Opacity="0.7"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                                <TextBlock Text="Storage by Category" Style="{StaticResource Type.SubTitle}" Margin="0,4,0,0"/>
                                <ItemsRepeater ItemsSource="{x:Bind VM.CategoryDistributions, Mode=OneWay}">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="models:FileTypeDistribution">
                                            <Grid ColumnSpacing="{StaticResource Space.SM}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{x:Bind Extension, Mode=OneTime}" Style="{StaticResource Type.FieldHeading}"/>
                                                <ProgressBar Grid.Column="1" Value="{x:Bind Percentage, Mode=OneTime}" Maximum="100" Style="{StaticResource MinimalProgressBar}" Margin="8,0"/>
                                                <TextBlock Grid.Column="2" Text="{x:Bind SizeDisplay, Mode=OneTime}" Style="{StaticResource Type.Caption}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </Border>

                        <!-- Details -->
                        <Grid ColumnSpacing="{StaticResource Space.MD}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Largest Files -->
                            <Border Grid.Column="0" Style="{StaticResource DashboardCardBorder}" Padding="{StaticResource Thickness.SM}">
                                <StackPanel Spacing="{StaticResource Space.XS}">
                                    <TextBlock Text="Largest Files" Style="{StaticResource Type.SubTitle}"/>
                                    <Grid ColumnSpacing="{StaticResource Space.SM}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{x:Bind VM.LargestFilesFilter, Mode=TwoWay}" PlaceholderText="Filter..." Style="{StaticResource Type.Caption.TextBox}"/>
                                        <Button Grid.Column="1" Content="Clear" Click="ClearFilter_Click" Style="{StaticResource SmallButton}" Visibility="{x:Bind VM.HasLargestFilesFilter, Mode=OneWay}"/>
                                    </Grid>
                                    <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                                        <ItemsRepeater ItemsSource="{x:Bind VM.FilteredLargestFiles, Mode=OneWay}">
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="models:FileSizeEntry">
                                                    <Grid ColumnSpacing="{StaticResource Space.SM}" Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{x:Bind SizeDisplay, Mode=OneTime}" Style="{StaticResource Type.FieldHeading}" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
                                                        <TextBlock Grid.Column="1" Text="{x:Bind Path, Mode=OneTime}" Style="{StaticResource Type.Caption}" TextTrimming="CharacterEllipsis" Opacity="0.8"/>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{StaticResource Space.XS}">
                                                            <Button Content="Open" Click="OpenFile_Click" Style="{StaticResource TinyButton}" Tag="{x:Bind Path}"/>
                                                            <Button Content="Folder" Click="OpenFolder_Click" Style="{StaticResource TinyButton}" Tag="{x:Bind Path}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>

                            <!-- Largest Directories -->
                            <Border Grid.Column="1" Style="{StaticResource DashboardCardBorder}" Padding="{StaticResource Thickness.SM}">
                                <StackPanel Spacing="{StaticResource Space.XS}">
                                    <TextBlock Text="Largest Directories" Style="{StaticResource Type.SubTitle}"/>
                                    <ItemsRepeater ItemsSource="{x:Bind VM.TopDirectories, Mode=OneWay}">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Orientation="Vertical" Spacing="{StaticResource Space.SM}"/>
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="models:DirEntry">
                                                <StackPanel Spacing="{StaticResource Space.XS}">
                                                    <TextBlock Style="{StaticResource Type.Body}" Text="{x:Bind Name, Mode=OneTime}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Style="{StaticResource Type.Caption}" Opacity="0.8">
                                                        <Run Text="{x:Bind SizeDisplay, Mode=OneTime}"/>
                                                        <Run Text=" · "/>
                                                        <Run Text="{x:Bind FileCount, Mode=OneTime}"/>
                                                        <Run Text=" files"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Saved to history bridge -->
                        <Grid ColumnSpacing="{StaticResource Space.SM}" Visibility="{x:Bind VM.HasSavedHistoryVisibility, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE8B9;" FontSize="{StaticResource Icon.Small}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource Space.SM}" VerticalAlignment="Center">
                                <TextBlock Text="Saved to history." Style="{StaticResource Type.Caption}" VerticalAlignment="Center"/>
                                <Button Content="View details" Click="ViewSavedInHistory_Click" Tag="{x:Bind VM.LastSavedHistoryId, Mode=OneWay}" Style="{StaticResource SmallButton}" AutomationProperties.Name="View saved scan in history"/>
                            </StackPanel>
                        </Grid>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>