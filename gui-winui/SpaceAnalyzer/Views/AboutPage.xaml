<Page
    x:Class="SpaceAnalyzer.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="24">
        <StackPanel Spacing="16" MaxWidth="800" HorizontalAlignment="Center">
            <TextBlock Text="About" FontSize="32" FontWeight="Bold"/>
            <TextBlock Text="Space Analyzer Pro" FontSize="20" Opacity="0.8"/>
            <TextBlock Text="Version 3.7.0" FontSize="14" Opacity="0.6"/>

            <TextBlock Text="Space Analyzer Pro helps you find and reclaim disk space on Windows."
                       FontSize="14" Opacity="0.7" TextWrapping="Wrap"/>

            <Border Style="{StaticResource DashboardCardBorder}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Core Technologies" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="• Rust scanner core with parallel directory traversal" FontSize="14" Opacity="0.8"/>
                    <TextBlock Text="• WinUI 3 desktop shell" FontSize="14" Opacity="0.8"/>
                    <TextBlock Text="• SQLite embedded history database" FontSize="14" Opacity="0.8"/>
                    <TextBlock Text="• Ollama-powered AI assistant" FontSize="14" Opacity="0.8"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource DashboardCardBorder}">
                <StackPanel Spacing="12">
                    <TextBlock Text="License" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="MIT License" FontSize="14" Opacity="0.8"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
