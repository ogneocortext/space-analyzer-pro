<Page
    x:Class="SpaceAnalyzer.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="{StaticResource Thickness.XL}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="{StaticResource Space.XL}" MaxWidth="800" HorizontalAlignment="Center">

                <!-- Header -->
                <StackPanel Spacing="{StaticResource Space.SM}">
                    <TextBlock Text="About" Style="{StaticResource Type.PageTitle}"/>
                    <TextBlock Text="Space Analyzer Pro" Style="{StaticResource Type.CardTitle}" Opacity="0.8"/>
                    <TextBlock Text="Version 4.2.0" Style="{StaticResource StatusBarText}"/>
                </StackPanel>

                <!-- Description -->
                <Border Style="{StaticResource DashboardCardBorder}" Padding="{StaticResource Thickness.XL}">
                    <StackPanel Spacing="{StaticResource Space.MD}">
                        <TextBlock Text="Space Analyzer Pro helps you find and reclaim disk space on Windows."
                                   Style="{StaticResource Type.Body}" TextWrapping="Wrap"/>
                        <TextBlock Text="It combines a high-performance Rust scanner core with a modern WinUI 3 desktop interface."
                                   Style="{StaticResource Type.Body}" Opacity="0.7" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Core Technologies -->
                <Border Style="{StaticResource DashboardCardBorder}" Padding="{StaticResource Thickness.XL}">
                    <StackPanel Spacing="{StaticResource Space.MD}">
                        <TextBlock Text="Core Technologies" Style="{StaticResource Type.SectionTitle}"/>
                        <TextBlock Text="Rust scanner core with parallel directory traversal" Style="{StaticResource Type.Body}" Opacity="0.8"/>
                        <TextBlock Text="WinUI 3 + Windows App SDK desktop shell" Style="{StaticResource Type.Body}" Opacity="0.8"/>
                        <TextBlock Text="SQLite embedded history database" Style="{StaticResource Type.Body}" Opacity="0.8"/>
                        <TextBlock Text="Ollama-powered AI assistant" Style="{StaticResource Type.Body}" Opacity="0.8"/>
                    </StackPanel>
                </Border>

                <!-- Build Info -->
                <Border Style="{StaticResource DashboardCardBorder}" Padding="{StaticResource Thickness.XL}">
                    <StackPanel Spacing="{StaticResource Space.MD}">
                        <TextBlock Text="Build Information" Style="{StaticResource Type.SectionTitle}"/>
                        <Grid ColumnSpacing="{StaticResource Space.XXL}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="{StaticResource Space.XS}">
                                <TextBlock Text="Runtime" Style="{StaticResource Type.Caption}" Opacity="0.8"/>
                                <TextBlock Text=".NET 10" Style="{StaticResource Type.SubTitle}"/>
                            </StackPanel>
                            <StackPanel Spacing="{StaticResource Space.XS}">
                                <TextBlock Text="UI Framework" Style="{StaticResource Type.Caption}" Opacity="0.8"/>
                                <TextBlock Text="WinUI 3" Style="{StaticResource Type.SubTitle}"/>
                            </StackPanel>
                            <StackPanel Spacing="{StaticResource Space.XS}">
                                <TextBlock Text="Windows SDK" Style="{StaticResource Type.Caption}" Opacity="0.8"/>
                                <TextBlock Text="10.0.22621" Style="{StaticResource Type.SubTitle}"/>
                            </StackPanel>
                            <StackPanel Spacing="{StaticResource Space.XS}">
                                <TextBlock Text="Target Platform" Style="{StaticResource Type.Caption}" Opacity="0.8"/>
                                <TextBlock Text="x64" Style="{StaticResource Type.SubTitle}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Credits -->
                <Border Style="{StaticResource DashboardCardBorder}" Padding="{StaticResource Thickness.XL}">
                    <StackPanel Spacing="{StaticResource Space.MD}">
                        <TextBlock Text="Credits" Style="{StaticResource Type.SectionTitle}"/>
                        <TextBlock Text="Built with Rust, WinUI 3, and Ollama."
                                   Style="{StaticResource Type.Body}" Opacity="0.8"/>
                        <TextBlock Text="Icons provided by the Segoe Fluent Icons font."
                                   Style="{StaticResource Type.Body}" Opacity="0.8"/>
                    </StackPanel>
                </Border>

                <!-- Links -->
                <Border Style="{StaticResource DashboardCardBorder}" Padding="{StaticResource Thickness.XL}">
                    <StackPanel Spacing="{StaticResource Space.MD}">
                        <TextBlock Text="Resources" Style="{StaticResource Type.SectionTitle}"/>
                        <StackPanel Spacing="{StaticResource Space.SM}">
                            <Button Content="View License (MIT)" Click="ViewLicense_Click"
                                    HorizontalAlignment="Stretch" Style="{StaticResource SecondaryButton}"/>
                            <Button Content="Open Project Folder" Click="OpenProjectFolder_Click"
                                    HorizontalAlignment="Stretch" Style="{StaticResource SecondaryButton}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

