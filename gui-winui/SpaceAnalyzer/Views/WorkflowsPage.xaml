<Page
    x:Class="SpaceAnalyzer.Views.WorkflowsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SpaceAnalyzer.ViewModels"
    xmlns:models="using:SpaceAnalyzer.Models"
    mc:Ignorable="d"
    NavigationCacheMode="Required"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="{StaticResource Thickness.XL}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="{StaticResource Space.XL}" MaxWidth="1000" HorizontalAlignment="Center">

                <!-- Header -->
                <StackPanel Spacing="{StaticResource Space.XS}">
                    <TextBlock Text="Workflows" Style="{StaticResource Type.PageTitle}"/>
                    <TextBlock Text="Run predefined disk-analysis workflows."
                               Style="{StaticResource Type.Body}"/>
                </StackPanel>

                <!-- ── Step 1: pick a workflow ────────────────────────────────────
                     Data-driven over VM.Templates so every registered workflow is
                     directly pickable. The previous three hardcoded Borders all
                     defaulted to Grid.Column 0, so they rendered stacked on top of
                     each other and the other 14 workflows were only reachable
                     through a narrow, truncating ComboBox. -->
                <Border Style="{StaticResource DashboardCardBorder}" Padding="{StaticResource Thickness.LG}">
                    <StackPanel Spacing="{StaticResource Space.MD}">
                        <StackPanel Spacing="{StaticResource Space.XS}">
                            <TextBlock Text="1 · Select a workflow" Style="{StaticResource Type.SubTitle}"/>
                            <TextBlock Text="{x:Bind VM.SelectedTemplate.Description, Mode=OneWay}"
                                       Style="{StaticResource Type.Caption}" Opacity="0.8" TextWrapping="Wrap"/>
                        </StackPanel>

                        <ItemsRepeater ItemsSource="{x:Bind VM.Templates, Mode=OneWay}"
                                       HorizontalAlignment="Stretch">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="216"
                                                   MinItemHeight="64"
                                                   MinColumnSpacing="{StaticResource Space.MD}"
                                                   MinRowSpacing="{StaticResource Space.MD}"
                                                   ItemsStretch="Fill"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:WorkflowTemplate">
                                    <Button Style="{StaticResource SelectableCardButton}"
                                            Tag="{x:Bind Id}"
                                            Click="WorkflowCard_Click"
                                            AutomationProperties.Name="{x:Bind Name}"
                                            AutomationProperties.HelpText="{x:Bind Description}"
                                            ToolTipService.ToolTip="{x:Bind Description}"
                                            Background="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource SelectedFlagBrush}}"
                                            BorderBrush="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource SelectedFlagBorder}}">
                                        <Grid ColumnSpacing="{StaticResource Space.MD}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Column="0"
                                                      Glyph="{x:Bind IconGlyph}"
                                                      FontSize="{StaticResource Icon.Card}"
                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                      VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Spacing="{StaticResource Space.XS}" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Name}"
                                                           Style="{StaticResource Type.Caption}"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{x:Bind ShortDescription}"
                                                           Style="{StaticResource Type.Tiny}"
                                                           Opacity="0.7"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <FontIcon Grid.Column="2"
                                                      Glyph="&#xE73E;"
                                                      FontSize="{StaticResource Icon.Small}"
                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                      VerticalAlignment="Top"
                                                      Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>

                <!-- ── Step 2: configure and run ─────────────────────────────────── -->
                <Border Style="{StaticResource DashboardCardBorder}" Padding="{StaticResource Thickness.LG}">
                    <StackPanel Spacing="{StaticResource Space.MD}">
                        <TextBlock Text="2 · Configure and run" Style="{StaticResource Type.SubTitle}"/>

                        <TextBlock Text="Target directory" Style="{StaticResource Type.Caption}" Opacity="0.8"
                                   Visibility="{x:Bind VM.ShowTargetPath, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
                        <Grid ColumnSpacing="{StaticResource Space.SM}"
                              Visibility="{x:Bind VM.ShowTargetPath, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                             <TextBox Grid.Column="0"
                                      Text="{x:Bind VM.TargetPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      PlaceholderText="Select a directory..."
                                      AutomationProperties.Name="Target directory"
                                      Style="{StaticResource FieldTextBox}"/>
                            <Button Grid.Column="1"
                                    Content="Browse"
                                    Click="Browse_Click"
                                    Style="{StaticResource SecondaryButton}"
                                    AutomationProperties.Name="Browse"/>
                            <Button Grid.Column="2"
                                    Content="Open"
                                    Click="OpenTargetPath_Click"
                                    Style="{StaticResource SecondaryButton}"
                                    IsEnabled="{x:Bind VM.IsTargetPathValid, Mode=OneWay}"
                                    AutomationProperties.Name="Open target path"/>
                        </Grid>
                        <TextBlock Text="That folder does not exist. Pick a valid directory to enable Run."
                                   Style="{StaticResource Type.Caption}"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                   Visibility="{x:Bind VM.ShowTargetPath, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>

                        <!-- Parameters: only the ones the selected workflow actually reads.
                             Max size / days / extension drive 14 of the 17 workflows but had
                             no editor at all, so those runs silently used hardcoded defaults. -->
                        <Grid ColumnSpacing="{StaticResource Space.LG}"
                              Visibility="{x:Bind VM.HasParameters, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <NumberBox Grid.Column="0"
                                       Header="Min size (MB)"
                                       Value="{x:Bind VM.MinSizeMbValue, Mode=TwoWay}"
                                       Minimum="0"
                                       Maximum="10485760"
                                       SpinButtonPlacementMode="Compact"
                                       ValidationMode="InvalidInputOverwritten"
                                       HorizontalAlignment="Stretch"
                                       AutomationProperties.Name="Minimum size in megabytes"
                                       Visibility="{x:Bind VM.ShowMinSize, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>

                            <NumberBox Grid.Column="1"
                                       Header="Max size (MB)"
                                       Value="{x:Bind VM.MaxSizeMbValue, Mode=TwoWay}"
                                       Minimum="0"
                                       Maximum="10485760"
                                       SpinButtonPlacementMode="Compact"
                                       ValidationMode="InvalidInputOverwritten"
                                       HorizontalAlignment="Stretch"
                                       AutomationProperties.Name="Maximum size in megabytes"
                                       Visibility="{x:Bind VM.ShowMaxSize, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>

                            <NumberBox Grid.Column="1"
                                       Header="{x:Bind VM.DaysLabel, Mode=OneWay}"
                                       Value="{x:Bind VM.DaysOldValue, Mode=TwoWay}"
                                       Minimum="1"
                                       Maximum="36500"
                                       SpinButtonPlacementMode="Compact"
                                       ValidationMode="InvalidInputOverwritten"
                                       HorizontalAlignment="Stretch"
                                       AutomationProperties.Name="Age in days"
                                       Visibility="{x:Bind VM.ShowDays, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>

                            <TextBox Grid.Column="0"
                                     Header="File extension"
                                     Text="{x:Bind VM.ExtensionFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText=".log"
                                     Style="{StaticResource FieldTextBox}"
                                     AutomationProperties.Name="File extension filter"
                                     Visibility="{x:Bind VM.ShowExtension, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
                        </Grid>

                        <TextBlock Text="This workflow takes no extra parameters."
                                   Style="{StaticResource Type.Caption}"
                                   Opacity="0.6"
                                   Visibility="{x:Bind VM.HasNoParameters, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>

                        <!-- Actions -->
                        <Grid ColumnSpacing="{StaticResource Space.SM}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Click="Run_Click"
                                    HorizontalAlignment="Stretch"
                                    Style="{StaticResource PrimaryButton}"
                                    IsEnabled="{x:Bind VM.CanRun, Mode=OneWay}"
                                    AutomationProperties.Name="Run workflow">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.SM}">
                                    <FontIcon Glyph="&#xE768;" FontSize="{StaticResource Icon.Small}"/>
                                    <TextBlock Text="Run Workflow"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1"
                                    Content="Cancel"
                                    Click="Cancel_Click"
                                    Style="{StaticResource SecondaryButton}"
                                    IsEnabled="{x:Bind VM.IsRunning, Mode=OneWay}"
                                    AutomationProperties.Name="Cancel workflow"/>
                            <Button Grid.Column="2"
                                    Content="Clear"
                                    Click="Clear_Click"
                                    Style="{StaticResource SecondaryButton}"
                                    IsEnabled="{x:Bind VM.HasResults, Mode=OneWay}"
                                    AutomationProperties.Name="Clear results"/>
                        </Grid>

                        <!-- Live run state: shows the directory/file currently being
                             scanned plus a determinate progress bar while the scan runs. -->
                        <Border Style="{StaticResource AnimatedCard}"
                                Padding="{StaticResource Thickness.MD}"
                                Visibility="{x:Bind VM.IsRunning, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Spacing="{StaticResource Space.SM}">
                                <Grid ColumnSpacing="{StaticResource Space.SM}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ProgressRing Grid.Column="0" Width="16" Height="16"
                                                  IsActive="True" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind VM.StatusMessage, Mode=OneWay}"
                                               Style="{StaticResource Type.Caption}" Opacity="0.85"
                                               TextWrapping="Wrap" VerticalAlignment="Center"
                                               AutomationProperties.LiveSetting="Polite"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{x:Bind VM.ProgressPercent, Mode=OneWay, Converter={StaticResource DoubleToPercentText}}"
                                               Style="{StaticResource Type.Caption}" Opacity="0.8"
                                               VerticalAlignment="Center"/>
                                </Grid>

                                <ProgressBar Value="{x:Bind VM.ProgressPercent, Mode=OneWay}"
                                             IsIndeterminate="{x:Bind VM.IsProgressIndeterminate, Mode=OneWay}"
                                             Minimum="0" Maximum="100"
                                             Style="{StaticResource MinimalProgressBar}"/>

                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.SM}"
                                            Visibility="{x:Bind VM.IsRunning, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="{StaticResource Icon.Small}" Opacity="0.7" VerticalAlignment="Center"/>
                                    <TextBlock Text="{x:Bind VM.CurrentLocation, Mode=OneWay}"
                                               Style="{StaticResource Type.Tiny}" Opacity="0.7"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.SM}"
                                            Visibility="{x:Bind VM.IsRunning, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                    <FontIcon Glyph="&#xE7C3;" FontSize="{StaticResource Icon.Small}" Opacity="0.7" VerticalAlignment="Center"/>
                                    <TextBlock Text="{x:Bind VM.CurrentFileDisplay, Mode=OneWay}"
                                               Style="{StaticResource Type.Tiny}" Opacity="0.7"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Type.Tiny}" Opacity="0.6">
                                    <Run Text="{x:Bind VM.FilesScanned, Mode=OneWay}"/><Run Text=" files · "/>
                                    <Run Text="{x:Bind VM.DirectoriesScanned, Mode=OneWay}"/><Run Text=" dirs · "/>
                                    <Run Text="{x:Bind VM.ScannedBytesDisplay, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Results -->
                <Border Style="{StaticResource AnimatedCard}"
                        Padding="{StaticResource Thickness.LG}"
                        Visibility="{x:Bind VM.HasResults, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                    <StackPanel Spacing="{StaticResource Space.MD}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Results" Style="{StaticResource Type.CardTitle}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource Space.SM}" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind VM.ResultsSummary, Mode=OneWay}"
                                           Style="{StaticResource Type.Caption}" Opacity="0.8"
                                           VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.XS}" VerticalAlignment="Center">
                                    <TextBlock Text="Sort" Style="{StaticResource Type.Tiny}" Opacity="0.7" VerticalAlignment="Center"/>
                                    <ComboBox SelectedValue="{x:Bind VM.SortKey, Mode=TwoWay}" SelectedValuePath="Tag"
                                              Width="120" VerticalAlignment="Center">
                                        <ComboBoxItem Tag="size" Content="Size"/>
                                        <ComboBoxItem Tag="name" Content="Name"/>
                                        <ComboBoxItem Tag="path" Content="Path"/>
                                    </ComboBox>
                                    <Button Click="SortDir_Click" Style="{StaticResource SecondaryButton}"
                                            Content="{x:Bind VM.SortDirectionGlyph, Mode=OneWay}"
                                            AutomationProperties.Name="Toggle sort direction"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <ItemsRepeater ItemsSource="{x:Bind VM.Results, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="{StaticResource Space.SM}"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:SmartSearchResult">
                                    <Border Style="{StaticResource CompactItemCard}">
                                        <Grid ColumnSpacing="{StaticResource Space.MD}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="{StaticResource Space.XS}" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Type.SubTitle}"
                                                           Text="{x:Bind Name, Mode=OneTime}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Style="{StaticResource Type.Caption}" Opacity="0.8"
                                                           TextTrimming="CharacterEllipsis">
                                                    <Run Text="{x:Bind SizeDisplay, Mode=OneTime}"/>
                                                    <Run Text=" · "/>
                                                    <Run Text="{x:Bind Path, Mode=OneTime}" FontStyle="Italic"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                        Spacing="{StaticResource Space.SM}" VerticalAlignment="Center">
                                                <Button Content="Open" Click="OpenResultFile_Click"
                                                        Style="{StaticResource SmallButton}" Tag="{x:Bind Path}"
                                                        AutomationProperties.Name="Open file"/>
                                                <Button Content="Folder" Click="OpenResultFolder_Click"
                                                        Style="{StaticResource SmallButton}" Tag="{x:Bind Path}"
                                                        AutomationProperties.Name="Open containing folder"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>

                <!-- Report panel — analytical action types (PredictStorage, GenerateRecommendations,
                     Export, Notify, AIAnalyze) surface their output here as a scrollable text block
                     instead of the file list. Hidden for file-finding workflows. -->
                <Border Style="{StaticResource AnimatedCard}"
                        Padding="{StaticResource Thickness.LG}"
                        Visibility="{x:Bind VM.HasReport, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Spacing="{StaticResource Space.MD}">
                        <TextBlock Text="{x:Bind VM.ReportTitle, Mode=OneWay}" Style="{StaticResource Type.CardTitle}"/>
                        <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{x:Bind VM.Report, Mode=OneWay}"
                                       Style="{StaticResource Type.Body}"
                                       TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- Divider separating the setup region above from the results/empty
                     region below, so the screen reads as two clear modes. -->
                <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}"
                        Margin="{StaticResource Thickness.Zero}" Opacity="0.6"/>

                <!-- Empty State — distinguishes "not run yet" from "ran, matched nothing" -->
                <Border Style="{StaticResource EmptyStateCard}" Visibility="{x:Bind VM.ShowEmptyState, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Spacing="{StaticResource Space.MD}" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE721;" FontSize="{StaticResource Icon.EmptyState}"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                  Opacity="{StaticResource Icon.EmptyStateOpacity}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{x:Bind VM.EmptyStateTitle, Mode=OneWay}" Style="{StaticResource Type.CardTitle}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{x:Bind VM.EmptyStateHint, Mode=OneWay}" Style="{StaticResource Type.Body}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520"/>
                    </StackPanel>
                </Border>

                <!-- Execution History -->
                <Border Style="{StaticResource DashboardCardBorder}" Padding="{StaticResource Thickness.LG}" Visibility="{x:Bind VM.HasHistory, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Spacing="{StaticResource Space.MD}">
                        <TextBlock Text="Execution History" Style="{StaticResource Type.SubTitle}"/>
                        <ItemsRepeater ItemsSource="{x:Bind VM.History, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="{StaticResource Space.XS}"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:WorkflowHistoryEntry">
                                    <Grid ColumnSpacing="{StaticResource Space.MD}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind TimestampDisplay, Mode=OneTime}" Style="{StaticResource Type.Caption}" Opacity="0.6"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind HistoryLabel, Mode=OneTime}" Style="{StaticResource Type.Caption}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="2" Text="{x:Bind ResultCount, Mode=OneTime, Converter={StaticResource IntToResultsText}}" Style="{StaticResource Type.Caption}"/>
                                        <TextBlock Grid.Column="3" Text="{x:Bind Status, Mode=OneTime}" Style="{StaticResource Type.Caption}" Opacity="0.7"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
