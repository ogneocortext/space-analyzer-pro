<Page
    x:Class="SpaceAnalyzer.Views.WorkflowsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SpaceAnalyzer.ViewModels"
    xmlns:models="using:SpaceAnalyzer.Models"
    mc:Ignorable="d"
    NavigationCacheMode="Required"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="{StaticResource Thickness.XL}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="{StaticResource Space.XL}" MaxWidth="1000" HorizontalAlignment="Center">

                <!-- Header -->
                <StackPanel Spacing="{StaticResource Space.XS}">
                    <TextBlock Text="Workflows" Style="{StaticResource Type.PageTitle}"/>
                    <TextBlock Text="Run predefined disk-analysis workflows."
                               Style="{StaticResource Type.Body}"/>
                </StackPanel>

                <!-- Workflow Selection -->
                <Border Style="{StaticResource DashboardCardBorder}" Padding="{StaticResource Thickness.LG}">
                    <StackPanel Spacing="{StaticResource Space.MD}">
                        <TextBlock Text="Select a Workflow" Style="{StaticResource Type.SubTitle}"/>
                        <TextBlock Text="{x:Bind VM.SelectedTemplate.Description, Mode=OneWay}" Style="{StaticResource Type.Body}" Opacity="0.8" TextWrapping="Wrap"/>

                        <Grid ColumnSpacing="{StaticResource Space.MD}" RowSpacing="{StaticResource Space.MD}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource CompactItemCard}">
                                <StackPanel Spacing="{StaticResource Space.XS}">
                                    <FontIcon Glyph="&#xE7C3;" FontSize="{StaticResource Icon.Card}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="Find Large Files" Style="{StaticResource Type.SubTitle}" FontWeight="SemiBold"/>
                                    <TextBlock Text="Locate files larger than a threshold" Style="{StaticResource Type.Tiny}" Opacity="0.7"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CompactItemCard}">
                                <StackPanel Spacing="{StaticResource Space.XS}">
                                    <FontIcon Glyph="&#xE7F6;" FontSize="{StaticResource Icon.Card}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="Find Empty Dirs" Style="{StaticResource Type.SubTitle}" FontWeight="SemiBold"/>
                                    <TextBlock Text="Locate directories with no files" Style="{StaticResource Type.Tiny}" Opacity="0.7"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CompactItemCard}">
                                <StackPanel Spacing="{StaticResource Space.XS}">
                                    <FontIcon Glyph="&#xE8ED;" FontSize="{StaticResource Icon.Card}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="Find Duplicates" Style="{StaticResource Type.SubTitle}" FontWeight="SemiBold"/>
                                    <TextBlock Text="Scan for duplicate files by hash" Style="{StaticResource Type.Tiny}" Opacity="0.7"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <ComboBox Header="Workflow"
                                  ItemsSource="{x:Bind VM.Templates, Mode=OneWay}"
                                  SelectedItem="{x:Bind VM.SelectedTemplate, Mode=TwoWay}"
                                  DisplayMemberPath="Name"
                                  AutomationProperties.Name="Workflow type"/>

                        <TextBlock Text="Target Directory" Style="{StaticResource Type.SubTitle}"/>
                        <Grid ColumnSpacing="{StaticResource Space.SM}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{x:Bind VM.TargetPath, Mode=TwoWay}"
                                     PlaceholderText="Select a directory..."
                                     AutomationProperties.Name="Target directory"/>
                            <Button Grid.Column="1"
                                    Content="Browse"
                                    Click="Browse_Click"
                                    Style="{StaticResource SecondaryButton}"
                                    AutomationProperties.Name="Browse"/>
                            <Button Grid.Column="2"
                                    Content="Open"
                                    Click="OpenTargetPath_Click"
                                    Style="{StaticResource SecondaryButton}"
                                    AutomationProperties.Name="Open target path"/>
                        </Grid>

                        <Grid ColumnSpacing="{StaticResource Space.XXL}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="{StaticResource Space.SM}">
                                <TextBlock Text="Min Size (MB)" Style="{StaticResource Type.Caption}" Opacity="0.8"/>
                                <TextBox Text="{x:Bind VM.MinSizeMb, Mode=TwoWay}"
                                         AutomationProperties.Name="Minimum size in megabytes">
                                    <TextBox.InputScope>
                                        <InputScope>
                                            <InputScope.Names>
                                                <InputScopeName NameValue="Number"/>
                                            </InputScope.Names>
                                        </InputScope>
                                    </TextBox.InputScope>
                                </TextBox>
                            </StackPanel>
                            <StackPanel Spacing="{StaticResource Space.SM}">
                                <TextBlock Text="Status" Style="{StaticResource Type.Caption}" Opacity="0.8"/>
                                <TextBlock Text="{x:Bind VM.StatusMessage, Mode=OneWay}"
                                           Style="{StaticResource Type.Body}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <Button Content="Run Workflow"
                                Click="Run_Click"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource PrimaryButton}"
                                IsEnabled="{x:Bind VM.IsNotRunning, Mode=OneWay}"
                                AutomationProperties.Name="Run workflow"/>
                    </StackPanel>
                </Border>

                <!-- Results -->
                <Border Style="{StaticResource AnimatedCard}"
                        Padding="{StaticResource Thickness.LG}"
                        Visibility="{x:Bind VM.HasResults, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                    <StackPanel Spacing="{StaticResource Space.MD}">
                        <TextBlock Text="Results" Style="{StaticResource Type.CardTitle}"/>
                        <TextBlock Text="{x:Bind VM.ResultCount, Mode=OneWay}" Style="{StaticResource Type.Body}" Opacity="0.8"/>

                        <ItemsRepeater ItemsSource="{x:Bind VM.Results, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="{StaticResource Space.SM}"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:SmartSearchResult">
                                    <Border Style="{StaticResource CompactItemCard}">
                                        <StackPanel Spacing="{StaticResource Space.XS}">
                                            <TextBlock Style="{StaticResource Type.SubTitle}"
                                                       Text="{x:Bind Name, Mode=OneTime}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Style="{StaticResource Type.Caption}" Opacity="0.8">
                                                <Run Text="{x:Bind SizeDisplay, Mode=OneTime}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{x:Bind Path, Mode=OneTime}" FontStyle="Italic"/>
                                            </TextBlock>
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.SM}" Margin="0,4,0,0">
                                                <Button Content="Open" Click="OpenResultFile_Click" Style="{StaticResource SmallButton}" Tag="{x:Bind Path}"/>
                                                <Button Content="Folder" Click="OpenResultFolder_Click" Style="{StaticResource SmallButton}" Tag="{x:Bind Path}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>

                <!-- Empty State -->
                <Border Style="{StaticResource EmptyStateCard}" Visibility="{x:Bind VM.HasResults, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
                    <StackPanel Spacing="{StaticResource Space.MD}" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE74C;" FontSize="{StaticResource Icon.EmptyState}" Opacity="{StaticResource Icon.EmptyStateOpacity}" HorizontalAlignment="Center"/>
                        <TextBlock Text="No workflow results yet" Style="{StaticResource Type.CardTitle}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Select a workflow, choose a target directory, and click Run." Style="{StaticResource Type.Body}" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

