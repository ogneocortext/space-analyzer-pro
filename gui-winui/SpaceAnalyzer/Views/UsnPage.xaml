<Page
    x:Class="SpaceAnalyzer.Views.UsnPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SpaceAnalyzer.ViewModels"
    xmlns:models="using:SpaceAnalyzer.Models"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="{StaticResource Thickness.XL}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="{StaticResource Space.XL}" MaxWidth="1000" HorizontalAlignment="Center">

                <!-- Header -->
                <StackPanel Spacing="{StaticResource Space.SM}">
                    <TextBlock Text="USN Change Journal" Style="{StaticResource Type.PageTitle}"/>
                    <TextBlock Text="Inspect NTFS USN journals that power fast incremental scans."
                               Style="{StaticResource Type.Body}"/>
                </StackPanel>

                <!-- Controls -->
                <Border Style="{StaticResource DashboardCardBorder}" Padding="{StaticResource Thickness.LG}">
                    <StackPanel Spacing="{StaticResource Space.MD}">
                        <Grid ColumnSpacing="{StaticResource Space.SM}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Drive" VerticalAlignment="Center" Style="{StaticResource Type.SubTitle}"/>
                            <TextBox Grid.Column="1" Text="{x:Bind VM.Drive, Mode=TwoWay}" PlaceholderText="C:" Style="{StaticResource FieldTextBox}"/>
                            <Button Grid.Column="2" Content="Journal Status" Click="Status_Click" Style="{StaticResource SecondaryButton}" IsEnabled="{x:Bind VM.IsNotBusy, Mode=OneWay}" AutomationProperties.Name="Read journal status"/>
                            <Button Grid.Column="3" Content="Read Changes" Click="Changes_Click" Style="{StaticResource PrimaryButton}" IsEnabled="{x:Bind VM.IsNotBusy, Mode=OneWay}" AutomationProperties.Name="Read journal changes"/>
                        </Grid>
                        <Grid ColumnSpacing="{StaticResource Space.SM}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Max changes" VerticalAlignment="Center" Style="{StaticResource Type.Caption}" Opacity="0.8"/>
                            <TextBox Grid.Column="1" Text="{x:Bind VM.MaxChanges, Mode=TwoWay}" Style="{StaticResource FieldTextBox}">
                                <TextBox.InputScope>
                                    <InputScope>
                                        <InputScope.Names>
                                            <InputScopeName NameValue="Number"/>
                                        </InputScope.Names>
                                    </InputScope>
                                </TextBox.InputScope>
                            </TextBox>
                            <Button Grid.Column="2" Content="List Volumes" Click="Volumes_Click" Style="{StaticResource SecondaryButton}" IsEnabled="{x:Bind VM.IsNotBusy, Mode=OneWay}" AutomationProperties.Name="List USN volumes"/>
                        </Grid>
                        <ProgressRing Width="20" Height="20" IsActive="{x:Bind VM.IsBusy, Mode=OneWay}" Visibility="{x:Bind VM.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
                        <TextBlock Text="{x:Bind VM.StatusMessage, Mode=OneWay}" Style="{StaticResource Type.Body}"/>
                    </StackPanel>
                </Border>

                <!-- Volumes -->
                <Border Style="{StaticResource AnimatedCard}" Padding="{StaticResource Thickness.LG}"
                        Visibility="{x:Bind VM.HasVolumes, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Spacing="{StaticResource Space.MD}">
                        <TextBlock Text="Volumes with a USN Journal" Style="{StaticResource Type.CardTitle}"/>
                        <ItemsRepeater ItemsSource="{x:Bind VM.Volumes, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="{StaticResource Space.XS}"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Style="{StaticResource Type.Body}" Text="{x:Bind}" FontFamily="Consolas"/>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>

                <!-- Journal status -->
                <Border Style="{StaticResource AnimatedCard}" Padding="{StaticResource Thickness.LG}"
                        Visibility="{x:Bind VM.HasJournalInfo, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Spacing="{StaticResource Space.MD}">
                        <TextBlock Text="Journal Status" Style="{StaticResource Type.CardTitle}"/>
                        <Grid ColumnSpacing="{StaticResource Space.XXL}" RowSpacing="{StaticResource Space.XS}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="{StaticResource Space.XS}">
                                <TextBlock Text="{x:Bind VM.JournalNextUsn, Mode=OneWay}" Style="{StaticResource Type.StatValue}"/>
                                <TextBlock Text="Next USN" Style="{StaticResource Type.StatLabel}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="{StaticResource Space.XS}">
                                <TextBlock Text="{x:Bind VM.JournalLowestUsn, Mode=OneWay}" Style="{StaticResource Type.StatValue}"/>
                                <TextBlock Text="Lowest USN" Style="{StaticResource Type.StatLabel}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="{StaticResource Space.XS}">
                                <TextBlock Text="{x:Bind VM.JournalMaxUsn, Mode=OneWay}" Style="{StaticResource Type.StatValue}"/>
                                <TextBlock Text="Max USN" Style="{StaticResource Type.StatLabel}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource Type.Tiny}" Opacity="0.7" FontFamily="Consolas" TextWrapping="Wrap">
                            <Run Text="Journal ID: "/>
                            <Run Text="{x:Bind VM.JournalId, Mode=OneWay}"/>
                            <Run Text="  Size: "/>
                            <Run Text="{x:Bind VM.JournalSize, Mode=OneWay}"/>
                            <Run Text=" bytes"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Changes -->
                <Border Style="{StaticResource AnimatedCard}" Padding="{StaticResource Thickness.LG}"
                        Visibility="{x:Bind VM.HasChanges, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Spacing="{StaticResource Space.MD}">
                        <TextBlock Text="{x:Bind VM.ChangeCount, Mode=OneWay}" Style="{StaticResource Type.CardTitle}"/>
                        <TextBlock Text="recent change records" Style="{StaticResource Type.Body}" Opacity="0.8"/>
                        <ItemsRepeater ItemsSource="{x:Bind VM.ChangeRecords, Mode=OneWay}" MaxHeight="400">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="{StaticResource Space.XS}"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:UsnRecord">
                                    <TextBlock Style="{StaticResource Type.Tiny}" Opacity="0.85" FontFamily="Consolas" TextWrapping="Wrap">
                                        <Run Text="{x:Bind ChangeType, Mode=OneTime}"/>
                                        <Run Text="  "/>
                                        <Run Text="{x:Bind FileName, Mode=OneTime}"/>
                                        <Run Text="  (USN "/>
                                        <Run Text="{x:Bind Usn, Mode=OneTime}"/>
                                        <Run Text=")"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
