<Page
    x:Class="SpaceAnalyzer.Views.HistoryPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SpaceAnalyzer.ViewModels"
    xmlns:models="using:SpaceAnalyzer.Models"
    xmlns:helpers="using:SpaceAnalyzer.Helpers"
    xmlns:breakdown="using:SpaceAnalyzer.Controls.ScanBreakdown"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required"
    Loaded="HistoryPage_Loaded"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="Escape_Invoked"/>
    </Page.KeyboardAccelerators>


    <Grid Padding="{StaticResource Thickness.XL}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="{StaticResource Space.LG}" MaxWidth="1000" HorizontalAlignment="Center">

                <!-- Header + Actions -->
                <Grid ColumnSpacing="{StaticResource Space.LG}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="{StaticResource Space.XS}">
                        <TextBlock Text="Scan History" Style="{StaticResource Type.PageTitle}"/>
                        <TextBlock Text="View, search, and compare previous scan results." Style="{StaticResource Type.Body}"/>
                        <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="6"
                                Padding="8,4" Margin="0,4,0,0"
                                Visibility="{x:Bind VM.HasDuplicatesAny, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE8EC;" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Bind VM.DuplicateSummaryDisplay, Mode=OneWay}" Style="{StaticResource Type.Tiny}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource Space.SM}" VerticalAlignment="Top">
                        <Button Content="Refresh" Click="Refresh_Click" Style="{StaticResource SecondaryButton}" AutomationProperties.Name="Refresh history"/>
                        <Button Content="New Scan" Click="NewScan_Click" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="New scan"/>
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.XS}" VerticalAlignment="Center">
                            <Button Content="Delete Duplicates" Click="DeleteDuplicates_Click" Style="{StaticResource DangerButton}" IsEnabled="{x:Bind VM.IsNotLoading, Mode=OneWay}" AutomationProperties.Name="Delete duplicate scans"/>
                            <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"
                                    Visibility="{x:Bind VM.HasDuplicatesInView, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{x:Bind VM.RedundantInView, Mode=OneWay}" Style="{StaticResource Type.Tiny}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.XS}" VerticalAlignment="Center"
                                    Visibility="{x:Bind VM.HasCompareSelection, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <Button Content="Compare" Click="Compare_Click" Style="{StaticResource SecondaryButton}" IsEnabled="{x:Bind VM.IsNotLoading, Mode=OneWay}" AutomationProperties.Name="Compare selected scans"/>
                            <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind VM.CompareSelectedCount, Mode=OneWay}" Style="{StaticResource Type.Tiny}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Trend Chart (visible when there are records) -->
                <Border Style="{StaticResource AnimatedCard}" Padding="{StaticResource Thickness.LG}" Visibility="{x:Bind VM.HasHistoryVisibility, Mode=OneWay}">
                    <StackPanel Spacing="{StaticResource Space.SM}">
                        <Grid ColumnSpacing="{StaticResource Space.SM}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Size Trend" Style="{StaticResource Type.SubTitle}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="Export CSV" Click="ExportTrend_Click" Style="{StaticResource SmallButton}" AutomationProperties.Name="Export trend as CSV" ToolTipService.ToolTip="Export the size-trend history as a CSV file" />
                        </Grid>
                        <Grid x:Name="TrendChartGrid" Height="140" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                        <TextBlock Text="Total scanned size over time (GB). Hover a point for the exact value." Style="{StaticResource Type.Caption}" Opacity="0.8" />
                    </StackPanel>
                </Border>

                <!-- Library Composition (all-history category aggregate) -->
                <Border Style="{StaticResource DashboardCardBorder}" Padding="{StaticResource Thickness.LG}" Visibility="{x:Bind VM.HasCategoryHistory, Mode=OneWay}">
                    <StackPanel Spacing="{StaticResource Space.SM}">
                        <Grid ColumnSpacing="{StaticResource Space.SM}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Library Composition" Style="{StaticResource Type.SubTitle}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{x:Bind VM.CategoryHistoryCountDisplay, Mode=OneWay}" Style="{StaticResource Type.Tiny}" Opacity="0.6" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid x:Name="CategoryDonutGrid" Height="200" HorizontalAlignment="Center" />
                        <TextBlock Text="Aggregate of every scan's category breakdown — what your scanned library is made of overall." Style="{StaticResource Type.Caption}" Opacity="0.8" />
                    </StackPanel>
                </Border>

                <!-- Search + Sort Bar (only visible when there are records) -->
                <Border Style="{StaticResource DashboardCardBorder}" Padding="{StaticResource Thickness.MD}" Visibility="{x:Bind VM.HasHistoryVisibility, Mode=OneWay}">
                    <Grid ColumnSpacing="{StaticResource Space.SM}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{x:Bind VM.SearchText, Mode=TwoWay}" PlaceholderText="Search by path..." Style="{StaticResource Type.Caption.TextBox}" KeyDown="SearchBox_KeyDown"/>
                        <Button Grid.Column="1" Content="Search" Click="Search_Click" Style="{StaticResource SmallButton}" AutomationProperties.Name="Search history"/>
                        <Button Grid.Column="2" Content="Clear" Click="ClearSearch_Click" Style="{StaticResource SmallButton}" Visibility="{x:Bind VM.HasSearchText, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
                        <Button Grid.Column="3" Click="SortDate_Click" Style="{StaticResource SmallButton}" AutomationProperties.Name="Sort by date">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Date"/>
                                <TextBlock Text="{x:Bind VM.DateSortIndicator, Mode=OneWay}"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="4" Click="SortSize_Click" Style="{StaticResource SmallButton}" AutomationProperties.Name="Sort by size">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Size"/>
                                <TextBlock Text="{x:Bind VM.SizeSortIndicator, Mode=OneWay}"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="5" Click="SortFiles_Click" Style="{StaticResource SmallButton}" AutomationProperties.Name="Sort by file count">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Files"/>
                                <TextBlock Text="{x:Bind VM.FilesSortIndicator, Mode=OneWay}"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="6" Click="SortDuplicates_Click" Style="{StaticResource SmallButton}" AutomationProperties.Name="Group duplicate scans by folder">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Dupes"/>
                                <TextBlock Text="{x:Bind VM.DuplicateSortIndicator, Mode=OneWay}"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="7" Click="DuplicatesOnly_Click" Style="{StaticResource SmallButton}"
                                AutomationProperties.Name="Show only duplicate scans">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Duplicates only"/>
                                <TextBlock Text="{x:Bind VM.OnlyDuplicatesIndicator, Mode=OneWay}"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Status -->
                <Border Style="{StaticResource DashboardCardBorder}" Padding="{StaticResource Thickness.MD}" Visibility="{x:Bind VM.HistoryListVisibility, Mode=OneWay}">
                    <Grid ColumnSpacing="{StaticResource Space.SM}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Bind VM.StatusMessage, Mode=OneWay}" Style="{StaticResource Type.Caption}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource Space.XS}" VerticalAlignment="Center">
                            <Button Content="&#xE72B;" Click="PrevPage_Click" Style="{StaticResource SmallButton}" MinWidth="36" IsEnabled="{x:Bind VM.HasPreviousPage, Mode=OneWay}" AutomationProperties.Name="Previous page" ToolTipService.ToolTip="Previous page"/>
                            <TextBlock Text="{x:Bind VM.PageInfo, Mode=OneWay}" Style="{StaticResource Type.Caption}" VerticalAlignment="Center" Margin="4,0"/>
                            <Button Content="&#xE72A;" Click="NextPage_Click" Style="{StaticResource SmallButton}" MinWidth="36" IsEnabled="{x:Bind VM.HasNextPage, Mode=OneWay}" AutomationProperties.Name="Next page" ToolTipService.ToolTip="Next page"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Cache & Database management (always available) -->
                <Border Style="{StaticResource DashboardCardBorder}" Padding="{StaticResource Thickness.MD}">
                    <StackPanel Spacing="{StaticResource Space.SM}">
                        <Grid ColumnSpacing="{StaticResource Space.SM}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="{StaticResource Space.XS}">
                                <TextBlock Text="Cache &amp; Database" Style="{StaticResource Type.SubTitle}"/>
                                <TextBlock Text="{x:Bind VM.DbInfoSummary, Mode=OneWay}" Style="{StaticResource Type.Tiny}" Opacity="0.7"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Refresh" Click="RefreshDbInfo_Click" Style="{StaticResource SmallButton}" IsEnabled="{x:Bind VM.IsNotLoading, Mode=OneWay}" AutomationProperties.Name="Refresh database info"/>
                        </Grid>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.SM}" Padding="0,4">
                                <Button Content="Remove Empty Scans" Click="PruneEmpty_Click" Style="{StaticResource DangerButton}" IsEnabled="{x:Bind VM.IsNotLoading, Mode=OneWay}" AutomationProperties.Name="Remove empty scans"/>
                                <Button Content="Remove Invalid Paths" Click="PruneRelative_Click" Style="{StaticResource SecondaryButton}" IsEnabled="{x:Bind VM.IsNotLoading, Mode=OneWay}" AutomationProperties.Name="Remove scans with invalid paths"/>
                                <Button Content="Recompute Categories" Click="Backfill_Click" Style="{StaticResource SecondaryButton}" IsEnabled="{x:Bind VM.IsNotLoading, Mode=OneWay}" AutomationProperties.Name="Recompute categories"/>
                                <Button Content="Compact Database" Click="Vacuum_Click" Style="{StaticResource SecondaryButton}" IsEnabled="{x:Bind VM.IsNotLoading, Mode=OneWay}" AutomationProperties.Name="Compact database"/>
                                <Button Content="Clear File Cache" Click="PruneFileCache_Click" Style="{StaticResource SecondaryButton}" IsEnabled="{x:Bind VM.IsNotLoading, Mode=OneWay}" AutomationProperties.Name="Clear orphaned file cache"/>
                                <Button Content="Prune Disk History" Click="PruneDiskSpace_Click" Style="{StaticResource SecondaryButton}" IsEnabled="{x:Bind VM.IsNotLoading, Mode=OneWay}" AutomationProperties.Name="Prune disk space history"/>
                                <Button Content="Clear All History" Click="ClearHistory_Click" Style="{StaticResource DangerButton}" IsEnabled="{x:Bind VM.IsNotLoading, Mode=OneWay}" AutomationProperties.Name="Clear all history"/>
                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- History List -->
                <Border Style="{StaticResource DashboardCardBorder}" Padding="{StaticResource Thickness.LG}" Visibility="{x:Bind VM.HistoryListVisibility, Mode=OneWay}">
                    <StackPanel Spacing="{StaticResource Space.MD}">
                        <TextBlock Text="Recent Scans" Style="{StaticResource Type.CardTitle}"/>
                        <ItemsRepeater ItemsSource="{x:Bind VM.History, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="{StaticResource Space.MD}"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:ScanHistoryRecord">
                                    <Border Style="{StaticResource ItemCard}" Tag="{x:Bind Id}" Tapped="ScanCard_Tapped">
                                        <Border.Transitions>
                                            <TransitionCollection>
                                                <EntranceThemeTransition/>
                                            </TransitionCollection>
                                        </Border.Transitions>
                                        <StackPanel Spacing="{StaticResource Space.MD}">
                                            <!-- Header row: icon + path + date -->
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.MD}" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xEB39;" FontSize="{StaticResource Icon.Card}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                                <StackPanel Spacing="{StaticResource Space.XS}" HorizontalAlignment="Stretch" MaxWidth="700">
                                                    <TextBlock Style="{StaticResource Type.SubTitle}" Text="{x:Bind Path, Mode=OneTime}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Style="{StaticResource Type.Caption}" Text="{x:Bind DateDisplay, Mode=OneTime}" Opacity="0.8"/>
                                                </StackPanel>
                                                <Border Visibility="{x:Bind IsDuplicateView, Mode=OneTime, Converter={StaticResource BoolToVisibility}}"
                                                        Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                    <TextBlock Text="Duplicate" Style="{StaticResource Type.Tiny}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" FontWeight="SemiBold"/>
                                                </Border>
                                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind ScanTypeShort, Mode=OneTime}" Style="{StaticResource Type.Tiny}" FontWeight="SemiBold" Foreground="{x:Bind ScanTypeShort, Mode=OneTime, Converter={StaticResource ScanTypeToBrush}}"/>
                                                </Border>
                                                <CheckBox IsChecked="{x:Bind IsCompareSelected, Mode=TwoWay}" Checked="CompareCheck_Changed" Unchecked="CompareCheck_Changed" Tapped="CompareCheck_Tapped" Content="Compare" VerticalAlignment="Center" ToolTipService.ToolTip="Select for comparison"/>
                                            </StackPanel>

                                            <!-- Stats row: Files · Size · Duration · Depth -->
                                            <Grid ColumnSpacing="{StaticResource Space.XXL}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Spacing="{StaticResource Space.XS}">
                                                    <TextBlock Text="{x:Bind FilesDisplay, Mode=OneTime}" Style="{StaticResource Type.StatValue}"/>
                                                    <TextBlock Text="Files" Style="{StaticResource Type.Tiny}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="{StaticResource Space.XS}">
                                                    <TextBlock Text="{x:Bind TotalSizeDisplay, Mode=OneTime}" Style="{StaticResource Type.StatValue}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                                    <TextBlock Text="Size" Style="{StaticResource Type.Tiny}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Spacing="{StaticResource Space.XS}">
                                                    <TextBlock Text="{x:Bind DurationDisplay, Mode=OneTime}" Style="{StaticResource Type.StatValue}"/>
                                                    <TextBlock Text="Duration" Style="{StaticResource Type.Tiny}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="3" Spacing="{StaticResource Space.XS}">
                                                    <TextBlock Text="{x:Bind DepthDisplay, Mode=OneTime}" Style="{StaticResource Type.StatValue}"/>
                                                    <TextBlock Text="Depth" Style="{StaticResource Type.Tiny}"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Actions -->
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.MD}">
                                                <Button Content="Open" Click="OpenFolder_Click" Tag="{x:Bind Path}" Style="{StaticResource SmallButton}" AutomationProperties.Name="Open folder"/>
                                                <Button Content="View Details" Click="ViewDetails_Click" Tag="{x:Bind Id}" Style="{StaticResource SmallButton}"/>
                                                <Button Content="Re-scan" Click="Rescan_Click" Tag="{x:Bind Path}" Style="{StaticResource SmallButton}"/>
                                                <Button Content="Delete" Click="Delete_Click" Tag="{x:Bind Id}" Style="{StaticResource DangerButton}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>

                <!-- Empty state (no scans yet) -->
                <Border Style="{StaticResource EmptyStateCard}" Visibility="{x:Bind VM.HasNoHistoryVisibility, Mode=OneWay}" Padding="{StaticResource Thickness.LG}">
                    <StackPanel Spacing="{StaticResource Space.MD}" HorizontalAlignment="Center" Padding="24,8">
                        <FontIcon Glyph="&#xEB39;" Style="{StaticResource EmptyStateIcon}"/>
                        <TextBlock Text="No scans yet" Style="{StaticResource EmptyStateTitle}"/>
                        <TextBlock Text="Run your first scan to start building history. You can then compare scans, prune stale entries, and analyze usage over time." Style="{StaticResource EmptyStateHint}"/>
                        <Button Content="New Scan" Click="NewScan_Click" Style="{StaticResource SecondaryButton}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- File Explorer / Scan Details -->
                <Border Style="{StaticResource AnimatedCard}" Padding="{StaticResource Thickness.LG}" Visibility="{x:Bind VM.HasSelectedRecordVisibility, Mode=OneWay}">
                    <StackPanel Spacing="{StaticResource Space.LG}">
                        <!-- Back button at top -->
                        <Button Content="Back to list" Click="BackToList_Click" Style="{StaticResource SmallButton}"/>

                        <TextBlock Text="Scan Details" Style="{StaticResource Type.CardTitle}" />

                        <!-- Scan Summary -->
                        <StackPanel Spacing="{StaticResource Space.SM}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.SM}" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind VM.SelectedRecord.Path, Mode=OneWay}" Style="{StaticResource Type.SubTitle}" TextTrimming="CharacterEllipsis"/>
                                <Button Content="&#xE8C8;" Click="CopyPath_Click" Tag="{x:Bind VM.SelectedRecord.Path, Mode=OneWay}" Style="{StaticResource TinyButton}" ToolTipService.ToolTip="Copy path" AutomationProperties.Name="Copy path"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.XXL}" Opacity="0.8">
                                <TextBlock Style="{StaticResource Type.Caption}" Text="{x:Bind VM.SelectedRecord.FilesDisplay, Mode=OneWay}"/>
                                <TextBlock Style="{StaticResource Type.Caption}" Text="{x:Bind VM.SelectedRecord.TotalSizeDisplay, Mode=OneWay}"/>
                                <TextBlock Style="{StaticResource Type.Caption}" Text="{x:Bind VM.SelectedRecord.DurationDisplay, Mode=OneWay}"/>
                                <TextBlock Style="{StaticResource Type.Caption}" Text="{x:Bind VM.SelectedRecord.DateDisplay, Mode=OneWay}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.MD}">
                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="{x:Bind VM.SelectedRecord.DepthDisplay, Mode=OneTime}" Style="{StaticResource Type.Tiny}" Opacity="0.8"/>
                                </Border>
                                <Border Background="{ThemeResource SystemFillColorSuccessBrush}" CornerRadius="4" Padding="6,2"
                                        Visibility="{x:Bind VM.SelectedRecord.HasPotentialCleanup, Mode=OneTime, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{x:Bind VM.SelectedRecord.PotentialCleanupDisplay, Mode=OneTime}" Style="{StaticResource Type.Tiny}" FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                                </Border>
                                <TextBlock Text="reclaimable" Style="{StaticResource Type.Tiny}" Opacity="0.6"
                                        Visibility="{x:Bind VM.SelectedRecord.HasPotentialCleanup, Mode=OneTime, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Breakdown (tabbed to avoid a wall of stacked scrollers) -->
                        <Pivot>
                            <!-- Overview: category rollup + quick at-a-glance top 5 folders + types -->
                            <PivotItem Header="Overview">
                                <StackPanel Spacing="{StaticResource Space.LG}" Margin="0,12,0,0">
                                    <!-- Categories -->
                                    <StackPanel Spacing="{StaticResource Space.SM}">
                                        <Grid ColumnSpacing="{StaticResource Space.SM}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Categories" Style="{StaticResource Type.CardTitle}"/>
                                            <TextBlock Grid.Column="1" Text="{x:Bind VM.CategoryBreakdownCountDisplay, Mode=OneWay}" Style="{StaticResource Type.Tiny}" Opacity="0.6" VerticalAlignment="Center"/>
                                        </Grid>
                                        <breakdown:BreakdownListControl ItemsSource="{x:Bind VM.CategoryBreakdown, Mode=OneWay}">
                                            <breakdown:BreakdownListControl.RowTemplate>
                                                <DataTemplate x:DataType="models:CategoryStat">
                                                    <Grid ColumnSpacing="{StaticResource Space.SM}" VerticalAlignment="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="100"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{x:Bind Category, Mode=OneTime}" Style="{StaticResource Type.Caption}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <ProgressBar Grid.Column="1" Value="{x:Bind Percent, Mode=OneTime}" Maximum="100" Height="10" VerticalAlignment="Center"
                                                                      Foreground="{x:Bind helpers:FileCategory.CategoryBrush(Category)}"/>
                                                        <TextBlock Grid.Column="2" Text="{x:Bind SizeDisplay, Mode=OneTime}" Style="{StaticResource Type.Caption}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </breakdown:BreakdownListControl.RowTemplate>
                                        </breakdown:BreakdownListControl>
                                        <TextBlock Text="No category data" Style="{StaticResource Type.Caption}" Opacity="0.5" Visibility="{x:Bind VM.HasCategoryBreakdown, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}"/>
                                    </StackPanel>

                                    <Grid ColumnSpacing="{StaticResource Space.LG}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Spacing="{StaticResource Space.SM}">
                                            <TextBlock Text="Top Folders" Style="{StaticResource Type.CardTitle}"/>
                                            <breakdown:TopFoldersControl DisplayMode="Rollup" ItemsSource="{x:Bind VM.OverviewTopDirs, Mode=OneWay}"/>
                                            <TextBlock Text="No folder data" Style="{StaticResource Type.Caption}" Opacity="0.5" Visibility="{x:Bind VM.HasTopDirectoriesVisibility, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Spacing="{StaticResource Space.SM}">
                                            <TextBlock Text="Top Types" Style="{StaticResource Type.CardTitle}"/>
                                            <breakdown:BreakdownListControl ItemsSource="{x:Bind VM.OverviewTopTypes, Mode=OneWay}">
                                                <breakdown:BreakdownListControl.RowTemplate>
                                                    <DataTemplate x:DataType="models:ExtensionStat">
                                                        <Grid ColumnSpacing="{StaticResource Space.SM}" Margin="0,4" VerticalAlignment="Center">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="70"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{x:Bind Extension, Mode=OneTime}" Style="{StaticResource Type.Caption}" FontFamily="Consolas" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            <ProgressBar Grid.Column="1" Value="{x:Bind Percent, Mode=OneTime}" Maximum="100" Height="8" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="2" Text="{x:Bind SizeDisplay, Mode=OneTime}" Style="{StaticResource Type.Caption}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </breakdown:BreakdownListControl.RowTemplate>
                                            </breakdown:BreakdownListControl>
                                            <TextBlock Text="No type data" Style="{StaticResource Type.Caption}" Opacity="0.5" Visibility="{x:Bind VM.HasExtensionBreakdownVisibility, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </PivotItem>

                            <!-- Largest Files -->
                            <PivotItem Header="Largest Files">
                                <breakdown:LargestFilesControl
                                    Margin="0,12,0,0"
                                    DetailedMode="True"
                                    ShowSortHeaders="True"
                                    ItemsSource="{x:Bind VM.FilteredLargestFiles, Mode=OneWay}"
                                    Filter="{x:Bind VM.FileExplorerFilter, Mode=TwoWay}"
                                    FilterPlaceholder="{x:Bind VM.FileExplorerFilterPlaceholder, Mode=OneWay}"
                                    SizeSortIndicator="{x:Bind VM.FileSizeSortIndicator, Mode=OneWay}"
                                    NameSortIndicator="{x:Bind VM.FileNameSortIndicator, Mode=OneWay}"
                                    EmptyStateVisibility="{x:Bind VM.HasNoLargestFilesVisibility, Mode=OneWay}"
                                    EmptyStateText="No files found. Try adjusting your filter."
                                    ListMaxHeight="380"
                                    SortRequested="OnLargestFilesSort"/>
                            </PivotItem>

                            <!-- Folders -->
                            <PivotItem Header="Folders">
                                <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                                    <breakdown:TopFoldersControl DisplayMode="Detailed" ItemsSource="{x:Bind VM.TopDirectoriesView, Mode=OneWay}"/>
                                </ScrollViewer>
                            </PivotItem>

                            <!-- File Types -->
                            <PivotItem Header="File Types">
                                <StackPanel Spacing="{StaticResource Space.LG}">
                                    <StackPanel Spacing="{StaticResource Space.SM}">
                                        <Grid ColumnSpacing="{StaticResource Space.SM}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="By Category" Style="{StaticResource Type.CardTitle}"/>
                                            <TextBlock Grid.Column="1" Text="{x:Bind VM.CategoryBreakdownCountDisplay, Mode=OneWay}" Style="{StaticResource Type.Tiny}" Opacity="0.6" VerticalAlignment="Center"/>
                                        </Grid>
                                        <breakdown:BreakdownListControl ItemsSource="{x:Bind VM.CategoryBreakdown, Mode=OneWay}">
                                            <breakdown:BreakdownListControl.RowTemplate>
                                                <DataTemplate x:DataType="models:CategoryStat">
                                                    <Grid ColumnSpacing="{StaticResource Space.SM}" VerticalAlignment="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="100"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{x:Bind Category, Mode=OneTime}" Style="{StaticResource Type.Caption}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <ProgressBar Grid.Column="1" Value="{x:Bind Percent, Mode=OneTime}" Maximum="100" Height="10" VerticalAlignment="Center"
                                                                      Foreground="{x:Bind helpers:FileCategory.CategoryBrush(Category)}"/>
                                                        <TextBlock Grid.Column="2" Text="{x:Bind SizeDisplay, Mode=OneTime}" Style="{StaticResource Type.Caption}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </breakdown:BreakdownListControl.RowTemplate>
                                        </breakdown:BreakdownListControl>
                                        <TextBlock Text="No category data" Style="{StaticResource Type.Caption}" Opacity="0.5" Visibility="{x:Bind VM.HasCategoryBreakdown, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}"/>
                                    </StackPanel>

                                    <StackPanel Spacing="{StaticResource Space.SM}">
                                        <TextBlock Text="By Extension" Style="{StaticResource Type.CardTitle}"/>
                                        <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                            <breakdown:BreakdownListControl ItemsSource="{x:Bind VM.ExtensionBreakdown, Mode=OneWay}">
                                                <breakdown:BreakdownListControl.RowTemplate>
                                                    <DataTemplate x:DataType="models:ExtensionStat">
                                                        <Grid ColumnSpacing="{StaticResource Space.SM}" Margin="0,4" VerticalAlignment="Center">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="90"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{x:Bind Extension, Mode=OneTime}" Style="{StaticResource Type.Caption}" FontFamily="Consolas" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            <ProgressBar Grid.Column="1" Value="{x:Bind Percent, Mode=OneTime}" Maximum="100" Height="8" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="2" Text="{x:Bind SizeDisplay, Mode=OneTime}" Style="{StaticResource Type.Caption}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                            <TextBlock Grid.Column="3" Text="{x:Bind PercentDisplay, Mode=OneTime}" Style="{StaticResource Type.Tiny}" Opacity="0.7" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </breakdown:BreakdownListControl.RowTemplate>
                                            </breakdown:BreakdownListControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </StackPanel>
                            </PivotItem>
                        </Pivot>

                        <!-- Back button at bottom -->
                        <Button Content="Back to list" Click="BackToList_Click" Style="{StaticResource SmallButton}"/>
                    </StackPanel>
                </Border>

                <!-- Comparison (multi-select) -->
                <Border Style="{StaticResource AnimatedCard}" Padding="{StaticResource Thickness.LG}" Visibility="{x:Bind VM.HasComparisonVisibility, Mode=OneWay}">
                    <StackPanel Spacing="{StaticResource Space.LG}">
                        <Grid ColumnSpacing="{StaticResource Space.SM}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Comparison" Style="{StaticResource Type.CardTitle}"/>
                            <Button Grid.Column="1" Content="Clear" Click="ClearComparison_Click" Style="{StaticResource SmallButton}" AutomationProperties.Name="Clear comparison"/>
                        </Grid>
                        <TextBlock Text="First scan is the baseline; deltas show the change since it." Style="{StaticResource Type.Caption}" Opacity="0.7"/>

                        <Grid ColumnSpacing="{StaticResource Space.SM}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Metric:" Style="{StaticResource Type.Tiny}" VerticalAlignment="Center" Opacity="0.7"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource Space.XS}" VerticalAlignment="Center">
                                <Button x:Name="CompareMetricSize" Content="Size" Click="CompareMetric_Click" Tag="Size" Style="{StaticResource SmallButton}" AutomationProperties.Name="Compare by size"/>
                                <Button x:Name="CompareMetricFiles" Content="Files" Click="CompareMetric_Click" Tag="Files" Style="{StaticResource SmallButton}" AutomationProperties.Name="Compare by file count"/>
                                <Button x:Name="CompareMetricDuration" Content="Duration" Click="CompareMetric_Click" Tag="Duration" Style="{StaticResource SmallButton}" AutomationProperties.Name="Compare by duration"/>
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="ComparisonChartGrid" MinHeight="140" Margin="0,4,0,0" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />

                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsRepeater ItemsSource="{x:Bind VM.Comparisons, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" Spacing="{StaticResource Space.MD}"/>
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CompareCardModel">
                                        <Border Style="{StaticResource ItemCard}" Width="290">
                                            <StackPanel Spacing="{StaticResource Space.SM}">
                                                <StackPanel Spacing="{StaticResource Space.XS}">
                                                    <TextBlock Text="{x:Bind Record.Path, Mode=OneTime}" Style="{StaticResource Type.SubTitle}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Record.Path, Mode=OneTime}"/>
                                                    <TextBlock Text="{x:Bind Record.DateDisplay, Mode=OneTime}" Style="{StaticResource Type.Caption}" Opacity="0.8"/>
                                                </StackPanel>

                                                <Grid ColumnSpacing="{StaticResource Space.SM}">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Spacing="2">
                                                        <TextBlock Text="{x:Bind Record.TotalSizeDisplay, Mode=OneTime}" Style="{StaticResource Type.StatValue}"/>
                                                        <TextBlock Text="{x:Bind DeltaSizeDisplay, Mode=OneTime}" Style="{StaticResource Type.Tiny}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                        <TextBlock Text="{x:Bind Record.FilesDisplay, Mode=OneTime}" Style="{StaticResource Type.StatValue}"/>
                                                        <TextBlock Text="{x:Bind DeltaFilesDisplay, Mode=OneTime}" Style="{StaticResource Type.Tiny}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="0" Grid.Row="1" Spacing="2" Margin="0,8,0,0">
                                                        <TextBlock Text="{x:Bind Record.DurationDisplay, Mode=OneTime}" Style="{StaticResource Type.StatValue}"/>
                                                        <TextBlock Text="{x:Bind DeltaDurationDisplay, Mode=OneTime}" Style="{StaticResource Type.Tiny}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Grid.Row="1" Spacing="2" Margin="0,8,0,0">
                                                        <TextBlock Text="{x:Bind Record.DepthDisplay, Mode=OneTime}" Style="{StaticResource Type.StatValue}"/>
                                                        <TextBlock Text="{x:Bind BaselineDisplay, Mode=OneTime}" Style="{StaticResource Type.Tiny}" Opacity="0.6"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Top folders -->
                                                <StackPanel Spacing="{StaticResource Space.XS}" Visibility="{x:Bind HasTopDirs, Mode=OneTime, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="Top folders" Style="{StaticResource Type.Tiny}" FontWeight="SemiBold" Opacity="0.7"/>
                                                    <ItemsRepeater ItemsSource="{x:Bind TopDirs, Mode=OneTime}">
                                                        <ItemsRepeater.Layout>
                                                            <StackLayout Orientation="Vertical" Spacing="2"/>
                                                        </ItemsRepeater.Layout>
                                                        <ItemsRepeater.ItemTemplate>
                                                            <DataTemplate x:DataType="models:DirEntry">
                                                                <Grid ColumnSpacing="{StaticResource Space.SM}">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Text="{x:Bind Name, Mode=OneTime}" Style="{StaticResource Type.Tiny}" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Grid.Column="1" Text="{x:Bind SizeDisplay, Mode=OneTime}" Style="{StaticResource Type.Tiny}" FontWeight="SemiBold"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsRepeater.ItemTemplate>
                                                    </ItemsRepeater>
                                                </StackPanel>

                                                <!-- Top types -->
                                                <StackPanel Spacing="{StaticResource Space.XS}" Visibility="{x:Bind HasTopTypes, Mode=OneTime, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="Top types" Style="{StaticResource Type.Tiny}" FontWeight="SemiBold" Opacity="0.7"/>
                                                    <ItemsRepeater ItemsSource="{x:Bind TopTypes, Mode=OneTime}">
                                                        <ItemsRepeater.Layout>
                                                            <StackLayout Orientation="Vertical" Spacing="2"/>
                                                        </ItemsRepeater.Layout>
                                                        <ItemsRepeater.ItemTemplate>
                                                            <DataTemplate x:DataType="models:ExtensionStat">
                                                                <Grid ColumnSpacing="{StaticResource Space.SM}">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Text="{x:Bind Extension, Mode=OneTime}" Style="{StaticResource Type.Tiny}" FontFamily="Consolas" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                                                    <ProgressBar Grid.Column="1" Value="{x:Bind Percent, Mode=OneTime}" Maximum="100" Height="6" VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Column="2" Text="{x:Bind SizeDisplay, Mode=OneTime}" Style="{StaticResource Type.Tiny}" FontWeight="SemiBold"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsRepeater.ItemTemplate>
                                                    </ItemsRepeater>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- Empty State -->
                <Border Style="{StaticResource EmptyStateCard}" Visibility="{x:Bind VM.HasNoHistoryVisibility, Mode=OneWay}">
                    <StackPanel Spacing="{StaticResource Space.MD}" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE944;" FontSize="{StaticResource Icon.EmptyState}" Opacity="{StaticResource Icon.EmptyStateOpacity}" HorizontalAlignment="Center"/>
                        <TextBlock Text="No scan history found" Style="{StaticResource Type.CardTitle}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Run a scan from the Scan page to get started." Style="{StaticResource Type.Body}" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                        <Button Content="Go to Scan" Click="NewScan_Click" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
