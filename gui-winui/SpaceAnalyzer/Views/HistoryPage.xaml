<Page
    x:Class="SpaceAnalyzer.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SpaceAnalyzer.ViewModels"
        xmlns:models="using:SpaceAnalyzer.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required"
    Loaded="HistoryPage_Loaded"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.DataContext>
        <vm:HistoryViewModel x:Name="VM"/>
    </Page.DataContext>

<Grid Padding="24">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="24" MaxWidth="1000" HorizontalAlignment="Center">

                <!-- Header -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Scan History" FontSize="24" FontWeight="Bold"/>
                    <TextBlock Text="View and compare previous scan results." FontSize="14" Opacity="0.8"/>
                </StackPanel>

                <!-- Refresh Button -->
                <Button Content="Refresh History" Click="Refresh_Click" HorizontalAlignment="Stretch" Padding="12"/>

                <!-- Status -->
                <TextBlock Text="{x:Bind VM.StatusMessage, Mode=OneWay}" FontSize="14" Opacity="0.8"/>

                 <!-- History List -->
                <Border Style="{StaticResource DashboardCardBorder}" Padding="16" Visibility="{x:Bind VM.HasHistoryVisibility, Mode=OneWay}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Recent Scans" FontSize="16" FontWeight="SemiBold"/>
                        <ItemsRepeater ItemsSource="{x:Bind VM.History, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="12"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:ScanHistoryRecord">
                                    <Border Padding="16" CornerRadius="6" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <StackPanel Spacing="8">
                                            <TextBlock FontSize="14" FontWeight="SemiBold" Text="{x:Bind Path, Mode=OneTime}" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Spacing="24" Opacity="0.8">
                                                <TextBlock FontSize="12" Text="{x:Bind FilesDisplay, Mode=OneTime}"/>
                                                <TextBlock FontSize="12" Text="{x:Bind TotalSizeDisplay, Mode=OneTime}"/>
                                                <TextBlock FontSize="12" Text="{x:Bind DurationDisplay, Mode=OneTime}"/>
                                                <TextBlock FontSize="12" Text="{x:Bind DateDisplay, Mode=OneTime}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                                <Button Content="View Details" Click="ViewDetails_Click" Tag="{x:Bind Id}" Padding="8,4" FontSize="12"/>
                                                <Button Content="Delete" Click="Delete_Click" Tag="{x:Bind Id}" Padding="8,4" FontSize="12"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>

                <!-- Detail View -->
                <Border Style="{StaticResource DashboardCardBorder}" Padding="16" Visibility="{x:Bind VM.HasSelectedRecordVisibility, Mode=OneWay}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Scan Details" FontSize="16" FontWeight="SemiBold"/>
                         <TextBlock Text="{x:Bind VM.SelectedRecord.Path, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                         <StackPanel Orientation="Horizontal" Spacing="24" Opacity="0.8">
                             <TextBlock FontSize="12" Text="{x:Bind VM.SelectedRecord.FilesDisplay, Mode=OneWay}"/>
                             <TextBlock FontSize="12" Text="{x:Bind VM.SelectedRecord.TotalSizeDisplay, Mode=OneWay}"/>
                             <TextBlock FontSize="12" Text="{x:Bind VM.SelectedRecord.DurationDisplay, Mode=OneWay}"/>
                             <TextBlock FontSize="12" Text="{x:Bind VM.SelectedRecord.DateDisplay, Mode=OneWay}"/>
                        </StackPanel>
                        <Button Content="Back to list" Click="BackToList_Click" Padding="8,4" FontSize="12"/>
                    </StackPanel>
                </Border>

                <!-- Empty State -->
                <TextBlock Text="No scan history found. Run a scan to get started."
                           FontSize="14" Opacity="0.7"
                           Visibility="{x:Bind VM.HasNoHistoryVisibility, Mode=OneWay}"
                           HorizontalAlignment="Center" Margin="0,40,0,0"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
