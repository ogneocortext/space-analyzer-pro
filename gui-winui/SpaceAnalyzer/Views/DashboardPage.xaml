<Page
    x:Class="SpaceAnalyzer.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SpaceAnalyzer.ViewModels"
    xmlns:models="using:SpaceAnalyzer.Services"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel Spacing="16" MaxWidth="1200" HorizontalAlignment="Center">

            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="Dashboard" FontSize="24" FontWeight="Bold"/>
                <TextBlock Text="Overview of your disk usage, system resources, and quick actions."
                           FontSize="14" Opacity="0.6"/>
            </StackPanel>

            <!-- Hero Stat Cards -->
            <TextBlock Text="Overview" FontSize="18" FontWeight="SemiBold" Opacity="0.8"/>
            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Total Files -->
                <Border Grid.Column="0" Style="{StaticResource DashboardCardBorder}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE8B7;" FontSize="28" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind VM.TotalFilesDisplay, Mode=OneWay}" FontSize="32" FontWeight="Bold"/>
                            <TextBlock Text="Total Files" FontSize="12" Opacity="0.6"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Total Size -->
                <Border Grid.Column="1" Style="{StaticResource DashboardCardBorder}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE7C3;" FontSize="28" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind VM.TotalSizeDisplay, Mode=OneWay}" FontSize="32" FontWeight="Bold"/>
                            <TextBlock Text="Total Size" FontSize="12" Opacity="0.6"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Scans -->
                <Border Grid.Column="2" Style="{StaticResource DashboardCardBorder}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE9D9;" FontSize="28" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind VM.ScanCountDisplay, Mode=OneWay}" FontSize="32" FontWeight="Bold"/>
                            <TextBlock Text="Scans" FontSize="12" Opacity="0.6"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Duplicates -->
                <Border Grid.Column="3" Style="{StaticResource DashboardCardBorder}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE8ED;" FontSize="28" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind VM.DuplicateCountDisplay, Mode=OneWay}" FontSize="32" FontWeight="Bold"/>
                            <TextBlock Text="Duplicates" FontSize="12" Opacity="0.6"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Two-column layout: Disk Usage + Quick Actions -->
            <Grid ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Disk Usage Section -->
                <StackPanel Grid.Column="0" Spacing="12">
                    <TextBlock Text="Disk Usage" FontSize="18" FontWeight="SemiBold" Opacity="0.8"/>
                    <Border Style="{StaticResource DashboardCardBorder}">
                        <StackPanel Spacing="12">
                            <ItemsRepeater x:Name="DiskVolumesList" ItemsSource="{x:Bind VM.DiskVolumes, Mode=OneWay}">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="models:DiskVolume">
                                        <StackPanel Spacing="6" Margin="0,8">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontSize="14" FontWeight="SemiBold">
                                                    <Run Text="{x:Bind MountPoint, Mode=OneWay}"/>
                                                    <Run Text=" — "/>
                                                    <Run Text="{x:Bind Label, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <ProgressBar Value="{x:Bind UsagePercent, Mode=OneWay}"
                                                         Maximum="100" Height="6"
                                                         CornerRadius="3"
                                                         Foreground="{x:Bind UsageBrush, Mode=OneWay}"/>
                                            <TextBlock FontSize="12" Opacity="0.6">
                                                <Run Text="{x:Bind UsedFormatted, Mode=OneWay}"/>
                                                <Run Text=" used of "/>
                                                <Run Text="{x:Bind TotalFormatted, Mode=OneWay}"/>
                                                <Run Text=" — "/>
                                                <Run Text="{x:Bind UsagePercentFormatted, Mode=OneWay}" FontWeight="SemiBold"/>
                                                <Run Text=" · Free: "/>
                                                <Run Text="{x:Bind AvailableFormatted, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>

                            <TextBlock x:Name="LoadingText" Text="Loading disk volumes..." Opacity="0.5" FontSize="12"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Quick Actions Section -->
                <StackPanel Grid.Column="1" Spacing="12">
                    <TextBlock Text="Quick Actions" FontSize="18" FontWeight="SemiBold" Opacity="0.8"/>
                    <Grid RowSpacing="12" ColumnSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- New Scan -->
                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource DashboardCardBorder}" Padding="0">
                            <Button x:Name="BtnNewScan" Click="BtnNewScan_Click"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Padding="16" CornerRadius="8" Background="Transparent">
                                <StackPanel Spacing="8">
                                    <FontIcon Glyph="&#xE9D9;" FontSize="24" HorizontalAlignment="Center"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="New Scan" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Border>

                        <!-- View History -->
                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource DashboardCardBorder}" Padding="0">
                            <Button x:Name="BtnViewHistory" Click="BtnViewHistory_Click"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Padding="16" CornerRadius="8" Background="Transparent">
                                <StackPanel Spacing="8">
                                    <FontIcon Glyph="&#xE81C;" FontSize="24" HorizontalAlignment="Center"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="View History" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Border>

                        <!-- Find Duplicates -->
                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource DashboardCardBorder}" Padding="0">
                            <Button x:Name="BtnFindDuplicates" Click="BtnFindDuplicates_Click"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Padding="16" CornerRadius="8" Background="Transparent">
                                <StackPanel Spacing="8">
                                    <FontIcon Glyph="&#xE8ED;" FontSize="24" HorizontalAlignment="Center"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="Find Duplicates" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Border>

                        <!-- AI Assistant -->
                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource DashboardCardBorder}" Padding="0">
                            <Button x:Name="BtnAIAssistant" Click="BtnAIAssistant_Click"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Padding="16" CornerRadius="8" Background="Transparent">
                                <StackPanel Spacing="8">
                                    <FontIcon Glyph="&#xE99A;" FontSize="24" HorizontalAlignment="Center"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="AI Assistant" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Border>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- System Resources Section -->
            <TextBlock Text="System Resources" FontSize="18" FontWeight="SemiBold" Opacity="0.8"/>
            <Border Style="{StaticResource DashboardCardBorder}">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- CPU -->
                    <StackPanel Grid.Column="0" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE964;" FontSize="16" VerticalAlignment="Center"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text="CPU" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ProgressBar x:Name="CpuBar" Value="{x:Bind VM.CpuUsage, Mode=OneWay}"
                                     Maximum="100" Height="8" CornerRadius="4"
                                     Foreground="{x:Bind VM.CpuBrush, Mode=OneWay}"/>
                        <TextBlock Text="{x:Bind VM.CpuUsageDisplay, Mode=OneWay}"
                                   FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Usage" FontSize="12" Opacity="0.5" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Memory -->
                    <StackPanel Grid.Column="1" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE9F9;" FontSize="16" VerticalAlignment="Center"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Memory" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ProgressBar x:Name="MemBar" Value="{x:Bind VM.MemoryUsage, Mode=OneWay}"
                                     Maximum="100" Height="8" CornerRadius="4"
                                     Foreground="{x:Bind VM.MemoryBrush, Mode=OneWay}"/>
                        <TextBlock Text="{x:Bind VM.MemoryUsageDisplay, Mode=OneWay}"
                                   FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Usage" FontSize="12" Opacity="0.5" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- GPU (placeholder) -->
                    <StackPanel Grid.Column="2" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7F4;" FontSize="16" VerticalAlignment="Center"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text="GPU" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ProgressBar x:Name="GpuBar" Value="{x:Bind VM.GpuUsage, Mode=OneWay}"
                                     Maximum="100" Height="8" CornerRadius="4"
                                     Foreground="{x:Bind VM.GpuBrush, Mode=OneWay}"/>
                        <TextBlock Text="{x:Bind VM.GpuUsageDisplay, Mode=OneWay}"
                                   FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Placeholder" FontSize="12" Opacity="0.5" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
