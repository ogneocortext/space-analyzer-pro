<Page x:Class="SpaceAnalyzer.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:vm="using:SpaceAnalyzer.ViewModels"
      xmlns:models="using:SpaceAnalyzer.Models"
      mc:Ignorable="d"
      NavigationCacheMode="Required"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="{StaticResource Thickness.XL}">
        <StackPanel Spacing="{StaticResource Space.XL}" MaxWidth="1200" HorizontalAlignment="Center">

            <!-- Header -->
            <Grid ColumnSpacing="{StaticResource Space.LG}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="{StaticResource Space.XS}">
                    <TextBlock Text="Dashboard" Style="{StaticResource Type.PageTitle}" />
                    <TextBlock Text="Overview of your disk usage, system resources, and quick actions." Style="{StaticResource Type.Body}" />
                </StackPanel>
                <Button x:Name="BtnNewScan" Grid.Column="1" Content="New Scan" Click="BtnNewScan_Click" Style="{StaticResource PrimaryCTAButton}" VerticalAlignment="Center" ToolTipService.ToolTip="Start a new scan of a folder or drive to populate the dashboard and history." />
                <Button Grid.Column="2" Content="Refresh" Click="Refresh_Click" Style="{StaticResource SmallButton}" VerticalAlignment="Center" />
            </Grid>

            <!-- Hero Stat Cards -->
            <Grid ColumnSpacing="{StaticResource Space.LG}" RowSpacing="{StaticResource Space.LG}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border x:Name="StatCardTotalFiles" Grid.Row="0" Grid.Column="0" Style="{StaticResource HeroCard}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.MD}" VerticalAlignment="Center" Height="72">
                        <FontIcon Glyph="&#xEB2F7;" FontSize="{StaticResource Icon.Hero}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind VM.TotalFilesDisplay, Mode=OneWay}" Style="{StaticResource Type.StatValue}" />
                            <TextBlock Text="Total Files" Style="{StaticResource Type.StatLabel}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border x:Name="StatCardTotalSize" Grid.Row="0" Grid.Column="1" Style="{StaticResource HeroCard}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.MD}" VerticalAlignment="Center" Height="72">
                        <FontIcon Glyph="&#xE9F3;" FontSize="{StaticResource Icon.Hero}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind VM.TotalSizeDisplay, Mode=OneWay}" Style="{StaticResource Type.StatValue}" />
                            <TextBlock Text="Total Size" Style="{StaticResource Type.StatLabel}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border x:Name="StatCardScanCount" Grid.Row="1" Grid.Column="0" Style="{StaticResource HeroCard}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.MD}" VerticalAlignment="Center" Height="72">
                        <FontIcon Glyph="&#xEB39;" FontSize="{StaticResource Icon.Hero}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind VM.ScanCountDisplay, Mode=OneWay}" Style="{StaticResource Type.StatValue}" />
                                <TextBlock Text="Total scans" Style="{StaticResource Type.StatLabel}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border x:Name="StatCardDuplicateCount" Grid.Row="1" Grid.Column="1" Style="{StaticResource HeroCard}" ToolTipService.ToolTip="No duplicate files detected — your drive is tidy.">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.MD}" VerticalAlignment="Center" Height="72">
                        <FontIcon Glyph="&#xEB9F;" FontSize="{StaticResource Icon.Hero}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind VM.DuplicateCountDisplay, Mode=OneWay}" Style="{StaticResource Type.StatValue}" />
                            <TextBlock Text="Duplicates" Style="{StaticResource Type.StatLabel}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Visual separation between hero stats and the detailed sections below -->
            <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.5" />

            <!-- Two-column layout: Disk Usage + Quick Actions -->
            <Grid ColumnSpacing="{StaticResource Space.LG}" RowSpacing="{StaticResource Space.LG}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <!-- Disk Usage Section -->
                <StackPanel Grid.Column="0" Spacing="{StaticResource Space.MD}">
                    <TextBlock Text="Disk Usage" Style="{StaticResource Type.SectionTitle}" />
                    <Border Style="{StaticResource AnimatedCard}" Padding="{StaticResource Thickness.LG}">
                        <StackPanel Spacing="{StaticResource Space.MD}">
                            <ItemsRepeater x:Name="DiskVolumesList" ItemsSource="{x:Bind VM.DiskVolumes, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Vertical" Spacing="{StaticResource Space.MD}" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="models:DiskVolume">
                                        <Grid ColumnSpacing="{StaticResource Space.MD}" RowSpacing="{StaticResource Space.XS}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                                        Orientation="Horizontal" Spacing="{StaticResource Space.SM}" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind MountPoint, Mode=OneTime}"
                                                           Style="{StaticResource Type.SubTitle}" />
                                                <TextBlock Text="{x:Bind UsagePercentDisplay, Mode=OneTime}"
                                                           Style="{StaticResource Type.SubTitle}" FontWeight="SemiBold"
                                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            </StackPanel>
                                            <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                         Value="{x:Bind UsagePercent, Mode=OneTime}" Maximum="100"
                                                         Style="{StaticResource StandardProgressBar}"
                                                         Foreground="{x:Bind UsageBrush, Mode=OneTime}"
                                                         ToolTipService.ToolTip="Color shows usage level: green under 70%, amber 70–90%, red above 90%." />
                                            <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource Type.Body}">
                                                <Run Text="{x:Bind UsedDisplay, Mode=OneTime}" FontWeight="SemiBold" />
                                                <Run Text=" used of " />
                                                <Run Text="{x:Bind TotalDisplay, Mode=OneTime}" />
                                                <Run Text="  ·  " />
                                                <Run Text="{x:Bind AvailableDisplay, Mode=OneTime}" />
                                                <Run Text=" free" />
                                            </TextBlock>
                                            <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                                    Height="1" Margin="0,8,0,0"
                                                    Background="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.4" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                            <TextBlock Text="Loading disk volumes..." Style="{StaticResource Type.Dim}" Visibility="{x:Bind VM.IsLoadingVisibility, Mode=OneWay}" />
                            <TextBlock Text="No disk volumes detected." Style="{StaticResource Type.Body}" Visibility="{x:Bind VM.HasDiskVolumesVisibility, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Quick Actions Section -->
                <StackPanel Grid.Column="1" Spacing="{StaticResource Space.MD}">
                    <TextBlock Text="Quick Actions" Style="{StaticResource Type.SectionTitle}" />
                    <Border Style="{StaticResource DashboardCardBorder}" Padding="{StaticResource Thickness.MD}">
                        <StackPanel Spacing="{StaticResource Space.MD}">
                            <Button x:Name="BtnViewHistory" Click="BtnViewHistory_Click" Style="{StaticResource QuickActionButton}" AutomationProperties.Name="View History">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.MD}">
                                    <FontIcon Glyph="&#xE944;" FontSize="{StaticResource Icon.Button}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="View History" Style="{StaticResource Type.SubTitle}" />
                                        <TextBlock Text="Browse past scans and compare results" Style="{StaticResource Type.Caption}" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnFindDuplicates" Click="BtnFindDuplicates_Click" Style="{StaticResource QuickActionButton}" AutomationProperties.Name="Find Duplicates">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.MD}">
                                    <FontIcon Glyph="&#xEB9F;" FontSize="{StaticResource Icon.Button}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Find Duplicates" Style="{StaticResource Type.SubTitle}" />
                                        <TextBlock Text="Detect and remove duplicate files" Style="{StaticResource Type.Caption}" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnAIAssistant" Click="BtnAIAssistant_Click" Style="{StaticResource QuickActionButton}" AutomationProperties.Name="AI Assistant">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.MD}">
                                    <FontIcon Glyph="&#xE99A;" FontSize="{StaticResource Icon.Button}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="AI Assistant" Style="{StaticResource Type.SubTitle}" />
                                        <TextBlock Text="Ask questions about your disk usage" Style="{StaticResource Type.Caption}" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnCleanup" Click="BtnCleanup_Click" Style="{StaticResource QuickActionButton}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.MD}">
                                    <FontIcon Glyph="&#xEB54;" FontSize="{StaticResource Icon.Button}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Cleanup" Style="{StaticResource Type.SubTitle}" />
                                        <TextBlock Text="Remove unused node_modules and cache" Style="{StaticResource Type.Caption}" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnSmartSearch" Click="BtnSmartSearch_Click" Style="{StaticResource QuickActionButton}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.MD}">
                                    <FontIcon Glyph="&#xE721;" FontSize="{StaticResource Icon.Button}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Search Files" Style="{StaticResource Type.SubTitle}" />
                                        <TextBlock Text="Find files by name, size, or date" Style="{StaticResource Type.Caption}" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnWorkflows" Click="BtnWorkflows_Click" Style="{StaticResource QuickActionButton}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.MD}">
                                    <FontIcon Glyph="&#xE74C;" FontSize="{StaticResource Icon.Button}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Workflows" Style="{StaticResource Type.SubTitle}" />
                                        <TextBlock Text="Automate cleanup and maintenance tasks" Style="{StaticResource Type.Caption}" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- System Resources Section -->
            <TextBlock Text="System Resources" Style="{StaticResource Type.SectionTitle}" />
            <Border Style="{StaticResource AnimatedCard}" Padding="{StaticResource Thickness.XL}">
                <Grid ColumnSpacing="{StaticResource Space.XXL}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="{StaticResource Space.SM}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.SM}">
                            <FontIcon Glyph="&#xE964;" FontSize="{StaticResource Icon.Small}" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="CPU" Style="{StaticResource Type.SubTitle}" VerticalAlignment="Center" />
                        </StackPanel>
                        <ProgressBar x:Name="CpuBar" Value="{x:Bind VM.CpuUsage, Mode=OneWay}" Maximum="100" Style="{StaticResource StandardProgressBar}" Foreground="{x:Bind VM.CpuBrush, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind VM.CpuUsageDisplay, Mode=OneWay}" Style="{StaticResource Type.StatValue}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Current usage" Style="{StaticResource Type.Tiny}" HorizontalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="{StaticResource Space.SM}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.SM}">
                            <FontIcon Glyph="&#xE9F9;" FontSize="{StaticResource Icon.Small}" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Memory" Style="{StaticResource Type.SubTitle}" VerticalAlignment="Center" />
                        </StackPanel>
                        <ProgressBar x:Name="MemBar" Value="{x:Bind VM.MemoryUsage, Mode=OneWay}" Maximum="100" Style="{StaticResource StandardProgressBar}" Foreground="{x:Bind VM.MemoryBrush, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind VM.MemoryUsageDisplay, Mode=OneWay}" Style="{StaticResource Type.StatValue}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Current usage" Style="{StaticResource Type.Tiny}" HorizontalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="{StaticResource Space.SM}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.SM}">
                            <FontIcon Glyph="&#xF211;" FontSize="{StaticResource Icon.Small}" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="GPU" Style="{StaticResource Type.SubTitle}" VerticalAlignment="Center" />
                        </StackPanel>
                        <ProgressBar x:Name="GpuBar" Value="{x:Bind VM.GpuUsage, Mode=OneWay}" Maximum="100" Style="{StaticResource StandardProgressBar}" Foreground="{x:Bind VM.GpuBrush, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind VM.GpuUsageDisplay, Mode=OneWay}" Style="{StaticResource Type.StatValue}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{x:Bind VM.GpuSubtitle, Mode=OneWay}" Style="{StaticResource Type.Tiny}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Spacing="{StaticResource Space.SM}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.SM}">
                            <FontIcon Glyph="&#xE950;" FontSize="{StaticResource Icon.Small}" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Storage" Style="{StaticResource Type.SubTitle}" VerticalAlignment="Center" />
                        </StackPanel>
                        <ProgressBar x:Name="DiskBar" Value="{x:Bind VM.DiskUsage, Mode=OneWay}" Maximum="100" Style="{StaticResource StandardProgressBar}" Foreground="{x:Bind VM.DiskBrush, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind VM.DiskUsageDisplay, Mode=OneWay}" Style="{StaticResource Type.StatValue}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Across all drives" Style="{StaticResource Type.Tiny}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Quick Scan -->
            <TextBlock Text="Quick Scan" Style="{StaticResource Type.SectionTitle}" />
            <Border Style="{StaticResource AnimatedCard}" Padding="{StaticResource Thickness.XL}">
                <StackPanel Spacing="{StaticResource Space.MD}">
                    <Grid ColumnSpacing="{StaticResource Space.SM}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                         <TextBox Grid.Column="0" Text="{x:Bind VM.QuickScanPath, Mode=TwoWay}" PlaceholderText="Select a folder to scan..." AutomationProperties.Name="Quick scan path" Style="{StaticResource FieldTextBox}" />
                        <Button Grid.Column="1" Content="Browse" Click="QuickScanBrowse_Click" Style="{StaticResource SecondaryButton}" AutomationProperties.Name="Quick scan browse" />
                        <Button Grid.Column="2" Content="Scan Now" Click="QuickScan_Click" Style="{StaticResource SecondaryButton}" AutomationProperties.Name="Quick scan now" />
                    </Grid>
                    <TextBlock Text="Tip: Run a scan to populate the dashboard stats and history." Style="{StaticResource Type.Hint}" />
                    <TextBlock Text="{x:Bind VM.QuickScanStatus, Mode=OneWay}" Style="{StaticResource Type.Body}" />
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.SM}" VerticalAlignment="Center" Visibility="{x:Bind VM.IsQuickScanning, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <ProgressRing IsActive="True" Width="16" Height="16" />
                        <TextBlock Text="Scanning..." Style="{StaticResource Type.Caption}" />
                    </StackPanel>
                    <StackPanel x:Name="QuickScanResult" Visibility="{x:Bind VM.QuickScanResultVisibility, Mode=OneWay}" Spacing="{StaticResource Space.SM}">
                        <TextBlock Text="{x:Bind VM.QuickScanResultText, Mode=OneWay}" Style="{StaticResource Type.Body}" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Resource History Charts -->
            <TextBlock Text="Resource History" Style="{StaticResource Type.SectionTitle}" />
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,-4" VerticalAlignment="Center">
                <Border Width="14" Height="10" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="2" VerticalAlignment="Center" />
                <TextBlock Text="Shaded band = scanning · lines mark 70% (warning) and 90% (critical)" Style="{StaticResource Type.Caption}" Opacity="0.7" VerticalAlignment="Center" />
            </StackPanel>
            <Grid ColumnSpacing="{StaticResource Space.LG}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource AnimatedCard}" Padding="{StaticResource Thickness.MD}">
                    <StackPanel Spacing="{StaticResource Space.XS}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.XS}">
                            <FontIcon Glyph="&#xE964;" FontSize="{StaticResource Icon.Small}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="CPU" Style="{StaticResource Type.SubTitle}" />
                        </StackPanel>
                        <Grid x:Name="CpuChartGrid" Height="72" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                        <TextBlock Text="{x:Bind VM.CpuUsageDisplay, Mode=OneWay}" Style="{StaticResource Type.Caption}" HorizontalAlignment="Center" />
                        <TextBlock x:Name="CpuPeakAvg" Style="{StaticResource Type.Tiny}" HorizontalAlignment="Center" Opacity="0.6" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource AnimatedCard}" Padding="{StaticResource Thickness.MD}">
                    <StackPanel Spacing="{StaticResource Space.XS}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.XS}">
                            <FontIcon Glyph="&#xE9F9;" FontSize="{StaticResource Icon.Small}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Memory" Style="{StaticResource Type.SubTitle}" />
                        </StackPanel>
                        <Grid x:Name="MemChartGrid" Height="72" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                        <TextBlock Text="{x:Bind VM.MemoryUsageDisplay, Mode=OneWay}" Style="{StaticResource Type.Caption}" HorizontalAlignment="Center" />
                        <TextBlock x:Name="MemPeakAvg" Style="{StaticResource Type.Tiny}" HorizontalAlignment="Center" Opacity="0.6" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource AnimatedCard}" Padding="{StaticResource Thickness.MD}">
                    <StackPanel Spacing="{StaticResource Space.XS}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.XS}">
                            <FontIcon Glyph="&#xF211;" FontSize="{StaticResource Icon.Small}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="GPU" Style="{StaticResource Type.SubTitle}" />
                        </StackPanel>
                        <Grid x:Name="GpuChartGrid" Height="72" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                        <TextBlock Text="{x:Bind VM.GpuUsageDisplay, Mode=OneWay}" Style="{StaticResource Type.Caption}" HorizontalAlignment="Center" />
                        <TextBlock x:Name="GpuPeakAvg" Style="{StaticResource Type.Tiny}" HorizontalAlignment="Center" Opacity="0.6" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource AnimatedCard}" Padding="{StaticResource Thickness.MD}">
                    <StackPanel Spacing="{StaticResource Space.XS}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.XS}">
                            <FontIcon Glyph="&#xE950;" FontSize="{StaticResource Icon.Small}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Disk" Style="{StaticResource Type.SubTitle}" />
                        </StackPanel>
                        <Grid x:Name="DiskChartGrid" Height="72" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                        <TextBlock Text="{x:Bind VM.DiskUsageDisplay, Mode=OneWay}" Style="{StaticResource Type.Caption}" HorizontalAlignment="Center" />
                        <TextBlock x:Name="DiskPeakAvg" Style="{StaticResource Type.Tiny}" HorizontalAlignment="Center" Opacity="0.6" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Scanner Impact (scan-vs-idle resource correlation) -->
            <TextBlock Text="Scanner Impact" Style="{StaticResource Type.SectionTitle}" />
            <Border Style="{StaticResource AnimatedCard}" Padding="{StaticResource Thickness.LG}"
                    Visibility="{x:Bind VM.ScanImpactAvailable, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Spacing="{StaticResource Space.MD}">
                    <TextBlock Text="{x:Bind VM.ScanImpactHeading, Mode=OneWay}" Style="{StaticResource Type.SubTitle}" />
                    <Grid ColumnSpacing="{StaticResource Space.LG}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="CPU" Style="{StaticResource Type.Caption}" Opacity="0.7" />
                            <TextBlock Text="{x:Bind VM.CpuScanImpact.DuringDisplay, Mode=OneWay}" Style="{StaticResource Type.StatValue}" />
                            <TextBlock Text="{x:Bind VM.CpuScanImpact.IdleDisplay, Mode=OneWay}" Style="{StaticResource Type.Tiny}" Opacity="0.7" />
                            <TextBlock Text="{x:Bind VM.CpuScanImpact.DeltaDisplay, Mode=OneWay}" Style="{StaticResource Type.SubTitle}"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="Memory" Style="{StaticResource Type.Caption}" Opacity="0.7" />
                            <TextBlock Text="{x:Bind VM.MemoryScanImpact.DuringDisplay, Mode=OneWay}" Style="{StaticResource Type.StatValue}" />
                            <TextBlock Text="{x:Bind VM.MemoryScanImpact.IdleDisplay, Mode=OneWay}" Style="{StaticResource Type.Tiny}" Opacity="0.7" />
                            <TextBlock Text="{x:Bind VM.MemoryScanImpact.DeltaDisplay, Mode=OneWay}" Style="{StaticResource Type.SubTitle}"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock Text="GPU" Style="{StaticResource Type.Caption}" Opacity="0.7" />
                            <TextBlock Text="{x:Bind VM.GpuScanImpact.DuringDisplay, Mode=OneWay}" Style="{StaticResource Type.StatValue}" />
                            <TextBlock Text="{x:Bind VM.GpuScanImpact.IdleDisplay, Mode=OneWay}" Style="{StaticResource Type.Tiny}" Opacity="0.7" />
                            <TextBlock Text="{x:Bind VM.GpuScanImpact.DeltaDisplay, Mode=OneWay}" Style="{StaticResource Type.SubTitle}"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Spacing="2">
                            <TextBlock Text="Disk" Style="{StaticResource Type.Caption}" Opacity="0.7" />
                            <TextBlock Text="{x:Bind VM.DiskScanImpact.DuringDisplay, Mode=OneWay}" Style="{StaticResource Type.StatValue}" />
                            <TextBlock Text="{x:Bind VM.DiskScanImpact.IdleDisplay, Mode=OneWay}" Style="{StaticResource Type.Tiny}" Opacity="0.7" />
                            <TextBlock Text="{x:Bind VM.DiskScanImpact.DeltaDisplay, Mode=OneWay}" Style="{StaticResource Type.SubTitle}"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{x:Bind VM.ScanImpactSummary, Mode=OneWay}" Style="{StaticResource Type.Caption}" Opacity="0.8" />
                </StackPanel>
            </Border>

            <!-- Storage Breakdown -->
            <TextBlock Text="Storage Breakdown" Style="{StaticResource Type.SectionTitle}" />
            <Grid ColumnSpacing="{StaticResource Space.LG}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource AnimatedCard}" Padding="{StaticResource Thickness.LG}">
                    <StackPanel Spacing="{StaticResource Space.SM}">
                        <TextBlock Text="Used Space by Volume" Style="{StaticResource Type.SubTitle}" />
                        <TextBlock Text="Share of total used disk across mounted volumes." Style="{StaticResource Type.Caption}" Opacity="0.6" />
                        <Grid x:Name="DiskUsageDonutGrid" Height="200" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource AnimatedCard}" Padding="{StaticResource Thickness.LG}">
                    <StackPanel Spacing="{StaticResource Space.SM}">
                        <TextBlock Text="Top File Types by Count" Style="{StaticResource Type.SubTitle}" />
                        <TextBlock Text="Click a bar to search that type · most common extensions from your most recent scan." Style="{StaticResource Type.Caption}" Opacity="0.6" />
                        <Grid x:Name="FileTypeBarsGrid" Height="200" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Storage Forecast (gap 2.3) -->
            <TextBlock Text="Storage Forecast" Style="{StaticResource Type.SectionTitle}" />
            <Border Style="{StaticResource AnimatedCard}" Padding="{StaticResource Thickness.LG}"
                    Visibility="{x:Bind VM.HasForecast, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Spacing="{StaticResource Space.MD}">
                    <Grid ColumnSpacing="{StaticResource Space.LG}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="{StaticResource Space.XS}">
                            <TextBlock Text="Current" Style="{StaticResource Type.Caption}" />
                            <TextBlock Text="{x:Bind VM.StorageForecast.CurrentSizeDisplay, Mode=OneWay}" Style="{StaticResource Type.StatValue}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="{StaticResource Space.XS}">
                            <TextBlock Text="In 30 days" Style="{StaticResource Type.Caption}" />
                            <TextBlock Text="{x:Bind VM.StorageForecast.PredictedSizeDisplay, Mode=OneWay}" Style="{StaticResource Type.StatValue}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="{StaticResource Space.XS}">
                            <TextBlock Text="Trend" Style="{StaticResource Type.Caption}" />
                            <TextBlock Text="{x:Bind VM.StorageForecast.GrowthRateDisplay, Mode=OneWay}" Style="{StaticResource Type.StatValue}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource Type.Caption}"
                               Visibility="{x:Bind VM.StorageForecast.HasEnoughData, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
                        Not enough history yet — run at least two scans to project growth.
                    </TextBlock>
                    <TextBlock Text="{x:Bind VM.StorageForecast.LastScan, Mode=OneWay}" Style="{StaticResource Type.Tiny}" Opacity="0.6" />
                </StackPanel>
            </Border>

            <!-- Bloat Detection (gap 2.2) -->
            <TextBlock Text="Bloat Detection" Style="{StaticResource Type.SectionTitle}" />
            <TextBlock Style="{StaticResource Type.Caption}" Opacity="0.6"
                       Visibility="{x:Bind VM.HasBloatFindings, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Run Text="Potential reclaimable: " /><Run Text="{x:Bind VM.BloatTotalDisplay, Mode=OneWay}" />
            </TextBlock>
            <Border Style="{StaticResource AnimatedCard}" Padding="{StaticResource Thickness.LG}"
                    Visibility="{x:Bind VM.HasBloatFindings, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <ItemsRepeater ItemsSource="{x:Bind VM.BloatFindings, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Vertical" Spacing="{StaticResource Space.SM}" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:BloatFinding">
                            <Border Style="{StaticResource DashboardCardBorder}" Padding="{StaticResource Thickness.MD}">
                                <Grid ColumnSpacing="{StaticResource Space.MD}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Category}" Style="{StaticResource Type.Tiny}"
                                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource Type.Body}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Path}" Style="{StaticResource Type.Tiny}" Opacity="0.6"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{x:Bind SizeDisplay}" Style="{StaticResource Type.SubTitle}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </Border>
            <Border Style="{StaticResource AnimatedCard}" Padding="{StaticResource Thickness.LG}"
                    Visibility="{x:Bind VM.HasBloatFindings, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
                <TextBlock Text="Run a scan to detect large videos, installers, caches, and AI model weights."
                           Style="{StaticResource Type.Caption}" />
            </Border>

            <!-- Cleanup Recommendations (gap 2.4) -->
            <TextBlock Text="Cleanup Recommendations" Style="{StaticResource Type.SectionTitle}" />
            <Border Style="{StaticResource AnimatedCard}" Padding="{StaticResource Thickness.LG}"
                    Visibility="{x:Bind VM.HasRecommendations, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <ItemsRepeater ItemsSource="{x:Bind VM.Recommendations, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Vertical" Spacing="{StaticResource Space.SM}" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:Recommendation">
                            <Border Style="{StaticResource DashboardCardBorder}" Padding="{StaticResource Thickness.MD}">
                                <Grid ColumnSpacing="{StaticResource Space.MD}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                        <Border.Background>
                                            <SolidColorBrush Color="{x:Bind Priority, Mode=OneTime, Converter={StaticResource PriorityToBrush}}" />
                                        </Border.Background>
                                        <TextBlock Text="{x:Bind PriorityLabel}" Style="{StaticResource Type.Tiny}"
                                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource Type.SubTitle}" />
                                        <TextBlock Text="{x:Bind Detail}" Style="{StaticResource Type.Tiny}" Opacity="0.7" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{x:Bind EstimatedSavingsDisplay}" Style="{StaticResource Type.SubTitle}"
                                                VerticalAlignment="Center" Visibility="{x:Bind HasSavings, Mode=OneTime, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </Border>
            <Border Style="{StaticResource AnimatedCard}" Padding="{StaticResource Thickness.LG}"
                    Visibility="{x:Bind VM.HasRecommendations, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
                <TextBlock Text="No major cleanup opportunities found in the latest scan."
                           Style="{StaticResource Type.Caption}" />
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>

