{
  "name": "space-analyzer-pro",
  "version": "2.0.1",
  "description": "AI-Powered Space Analyzer with Vision Analysis and Feature Hub",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:no-browser": "BROWSER=none vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "server": "cd server && node backend-server.js",
    "server:dev": "cd server && node backend-server.js",
    "launch": "node launch-services.js",
    "launch:backend": "npm run server:dev",
    "launch:frontend": "npm run dev:no-browser",
    "vision-test": "node direct-vision-test.js",
    "model-test": "node test-all-models.js",
    "google-test": "node integrated-ollama-puppeteer-test.cjs",
    "port:detect": "node port-config.cjs detect",
    "port:update": "node port-config.cjs update",
    "port:status": "node port-config.cjs status",
    "port:clear": "node port-config.cjs clear",
    "type-check": "tsc --noEmit",
    "update-deps": "npm update && npm audit fix"
  },
  "dependencies": {
    "@google/genai": "^1.38.0",
    "@google/generative-ai": "^0.24.1",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-query-devtools": "^5.91.2",
    "@tanstack/react-virtual": "^3.13.18",
    "cmdk": "^1.1.1",
    "comlink": "^4.4.2",
    "commander": "^14.0.2",
    "compression": "^1.7.4",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express-rate-limit": "^8.2.1",
    "framer-motion": "^12.28.1",
    "helmet": "^8.0.0",
    "kbar": "^0.1.0-beta.48",
    "lucide-react": "^0.562.0",
    "playwright": "^1.57.0",
    "puppeteer": "^24.35.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-error-boundary": "^6.1.0",
    "recharts": "^3.7.0",
    "sonner": "^2.0.7",
    "zod": "^4.3.5",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@browsermcp/mcp": "^0.1.3",
    "@napi-rs/cli": "^3.5.1",
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "@vitejs/plugin-react": "^4.7.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "jsdom": "^27.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.1",
    "vite": "^7.3.1",
    "vitest": "^4.0.17"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
